// fs bindings — POSIX filesystem ops exposed via v8 wrapper

from "../v8/v8" import { CallbackInfo, Isolate, Context, Value }

// nm_fs_open wraps variadic open() — ARM64 variadic ABI differs from regular args
extern fn nm_fs_open(path: *u8, flags: i32, mode: i32): i32
extern fn close(fd: i32): i32
extern fn read(fd: i32, buf: *u8, len: i64): i64
extern fn write(fd: i32, buf: *u8, len: i64): i64
extern fn lseek(fd: i32, offset: i64, whence: i32): i64
extern fn unlink(path: *u8): i32
extern fn mkdir(path: *u8, mode: u32): i32
extern fn rmdir(path: *u8): i32
extern fn rename(old: *u8, new: *u8): i32
extern fn stat(path: *u8, buf: *u8): i32
extern fn lstat(path: *u8, buf: *u8): i32
extern fn access(path: *u8, mode: i32): i32
extern fn chmod(path: *u8, mode: u32): i32
extern fn readlink(path: *u8, buf: *u8, bufsize: i64): i64
extern fn realpath(path: *u8, resolved: *u8): *u8
extern fn opendir(path: *u8): *u8
extern fn readdir(dir: *u8): *u8
extern fn closedir(dir: *u8): i32
extern fn malloc(size: i64): *u8
extern fn free(ptr: *u8): void
extern fn strlen(s: *u8): i64

fn getStringArg(info: *u8, idx: i32, buf: *u8, bufsize: i32): i32 {
    let ci = CallbackInfo { ptr: info }
    if idx >= ci.length() { return -1 }
    let len = ci.arg(idx).writeUtf8(ci.isolate(), buf, bufsize)
    if len <= 0 { return -1 }
    return len
}

fn getIntArg(info: *u8, idx: i32, defaultVal: i32): i32 {
    let ci = CallbackInfo { ptr: info }
    return ci.i32Arg(idx, defaultVal)
}

fn fsReadFile(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    var pathBuf: [u8; 4096] = [0; 4096]
    unsafe {
        let plen = getStringArg(info, 0, pathBuf as *u8, 4096)
        if plen < 0 { return }

        let fd = nm_fs_open(pathBuf as *u8, 0, 0)
        if fd < 0 {
            ci.retI32(-1)
            return
        }

        let size = lseek(fd, 0, 2)
        lseek(fd, 0, 0)
        if size < 0 || size > 104857600 {
            close(fd)
            ci.retI32(-1)
            return
        }

        let buf = malloc(size + 1)
        if buf as i64 == 0 {
            close(fd)
            ci.retI32(-1)
            return
        }

        var total: i64 = 0
        while total < size {
            let ptr = (buf as i64 + total) as *u8
            let n = read(fd, ptr, size - total)
            if n <= 0 { break }
            total = total + n
        }
        close(fd)

        let iso = ci.isolate()
        let str = iso.stringLen(buf, total as i32)
        free(buf)
        if str.slot >= 0 {
            ci.ret(str)
        }
    }
}

fn fsWriteFile(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    var pathBuf: [u8; 4096] = [0; 4096]
    unsafe {
        let plen = getStringArg(info, 0, pathBuf as *u8, 4096)
        if plen < 0 { return }

        if ci.length() < 2 { return }
        let iso = ci.isolate()
        let dataArg = ci.arg(1)

        let dataLen = dataArg.writeUtf8(iso, 0 as *u8, 0)
        if dataLen <= 0 { return }

        let dataBuf = malloc(dataLen as i64 + 1)
        if dataBuf as i64 == 0 { return }
        dataArg.writeUtf8(iso, dataBuf, dataLen + 1)

        let writeLen = dataLen

        // O_WRONLY | O_CREAT | O_TRUNC = 1 | 512 | 1024 = 1537 on macOS
        let fd = nm_fs_open(pathBuf as *u8, 1537, 438)  // 0666
        if fd < 0 {
            free(dataBuf)
            ci.retI32(-1)
            return
        }

        var written: i64 = 0
        while written < writeLen as i64 {
            let ptr = (dataBuf as i64 + written) as *u8
            let n = write(fd, ptr, writeLen as i64 - written)
            if n <= 0 { break }
            written = written + n
        }
        close(fd)
        free(dataBuf)
        ci.retI32(written as i32)
    }
}

fn fsStat(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    var pathBuf: [u8; 4096] = [0; 4096]
    unsafe {
        let plen = getStringArg(info, 0, pathBuf as *u8, 4096)
        if plen < 0 { return }

        // struct stat on macOS arm64 is 144 bytes
        var statBuf: [u8; 256] = [0; 256]
        let rc = stat(pathBuf as *u8, statBuf as *u8)
        if rc != 0 {
            ci.retI32(-1)
            return
        }

        let iso = ci.isolate()
        let ctx = ci.context()
        let obj = iso.object()
        let s = statBuf as *u8

        // macOS arm64 struct stat offsets (from offsetof):
        // st_dev:0 st_mode:4(u16) st_nlink:6(u16) st_ino:8 st_uid:16 st_gid:20
        // st_atimespec:32 st_mtimespec:48 st_ctimespec:64 st_birthtimespec:80
        // st_size:96 st_blocks:104 st_blksize:112
        let dev = (s as *i32)[0]
        let mode = (s as *i32)[1] & 65535
        let nlink = ((s as *i32)[1] >> 16) & 65535
        let ino = (s as *i64)[1]
        let uid = *((s as i64 + 16) as *u32)
        let gid = *((s as i64 + 20) as *u32)
        let size = *((s as i64 + 96) as *i64)
        let blocks = *((s as i64 + 104) as *i64)
        let blksize = *((s as i64 + 112) as *i32)

        let atimeSec = *((s as i64 + 32) as *i64)
        let atimeNs = *((s as i64 + 40) as *i64)
        let atimeMs = atimeSec as f64 * 1000.0 + atimeNs as f64 / 1000000.0

        let mtimeSec = *((s as i64 + 48) as *i64)
        let mtimeNs = *((s as i64 + 56) as *i64)
        let mtimeMs = mtimeSec as f64 * 1000.0 + mtimeNs as f64 / 1000000.0

        let ctimeSec = *((s as i64 + 64) as *i64)
        let ctimeNs = *((s as i64 + 72) as *i64)
        let ctimeMs = ctimeSec as f64 * 1000.0 + ctimeNs as f64 / 1000000.0

        let birthtimeSec = *((s as i64 + 80) as *i64)
        let birthtimeNs = *((s as i64 + 88) as *i64)
        let birthtimeMs = birthtimeSec as f64 * 1000.0 + birthtimeNs as f64 / 1000000.0

        ctx.objectSet(obj, "dev" as *u8, iso.number(dev as f64))
        ctx.objectSet(obj, "mode" as *u8, iso.number(mode as f64))
        ctx.objectSet(obj, "nlink" as *u8, iso.number(nlink as f64))
        ctx.objectSet(obj, "ino" as *u8, iso.number(ino as f64))
        ctx.objectSet(obj, "uid" as *u8, iso.number(uid as f64))
        ctx.objectSet(obj, "gid" as *u8, iso.number(gid as f64))
        ctx.objectSet(obj, "size" as *u8, iso.number(size as f64))
        ctx.objectSet(obj, "blocks" as *u8, iso.number(blocks as f64))
        ctx.objectSet(obj, "blksize" as *u8, iso.number(blksize as f64))
        ctx.objectSet(obj, "atimeMs" as *u8, iso.number(atimeMs))
        ctx.objectSet(obj, "mtimeMs" as *u8, iso.number(mtimeMs))
        ctx.objectSet(obj, "ctimeMs" as *u8, iso.number(ctimeMs))
        ctx.objectSet(obj, "birthtimeMs" as *u8, iso.number(birthtimeMs))

        // S_IFMT=0170000=61440, S_IFREG=0100000=32768, S_IFDIR=0040000=16384
        let fmt = mode & 61440
        let isFile = fmt == 32768
        let isDir = fmt == 16384
        let isSymlink = fmt == 40960

        ctx.objectSet(obj, "isFile" as *u8, iso.number(isFile as i32 as f64))
        ctx.objectSet(obj, "isDirectory" as *u8, iso.number(isDir as i32 as f64))
        ctx.objectSet(obj, "isSymbolicLink" as *u8, iso.number(isSymlink as i32 as f64))

        ci.ret(obj)
    }
}

fn fsExists(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    var pathBuf: [u8; 4096] = [0; 4096]
    unsafe {
        let plen = getStringArg(info, 0, pathBuf as *u8, 4096)
        if plen < 0 {
            ci.retI32(0)
            return
        }
        let rc = access(pathBuf as *u8, 0)
        ci.retI32((rc == 0) as i32)
    }
}

fn fsMkdir(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    var pathBuf: [u8; 4096] = [0; 4096]
    unsafe {
        let plen = getStringArg(info, 0, pathBuf as *u8, 4096)
        if plen < 0 { return }
        let mode = getIntArg(info, 1, 511)  // 0777
        ci.retI32(mkdir(pathBuf as *u8, mode as u32))
    }
}

fn fsUnlink(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    var pathBuf: [u8; 4096] = [0; 4096]
    unsafe {
        let plen = getStringArg(info, 0, pathBuf as *u8, 4096)
        if plen < 0 { return }
        ci.retI32(unlink(pathBuf as *u8))
    }
}

fn fsRmdir(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    var pathBuf: [u8; 4096] = [0; 4096]
    unsafe {
        let plen = getStringArg(info, 0, pathBuf as *u8, 4096)
        if plen < 0 { return }
        ci.retI32(rmdir(pathBuf as *u8))
    }
}

fn fsRename(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    var oldBuf: [u8; 4096] = [0; 4096]
    var newBuf: [u8; 4096] = [0; 4096]
    unsafe {
        let olen = getStringArg(info, 0, oldBuf as *u8, 4096)
        let nlen = getStringArg(info, 1, newBuf as *u8, 4096)
        if olen < 0 || nlen < 0 { return }
        ci.retI32(rename(oldBuf as *u8, newBuf as *u8))
    }
}

fn fsReaddir(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    var pathBuf: [u8; 4096] = [0; 4096]
    unsafe {
        let plen = getStringArg(info, 0, pathBuf as *u8, 4096)
        if plen < 0 { return }

        let dir = opendir(pathBuf as *u8)
        if dir as i64 == 0 { return }

        let iso = ci.isolate()
        let ctx = ci.context()

        var count: i32 = 0
        while true {
            let ent = readdir(dir)
            if ent as i64 == 0 { break }
            // d_name at offset 21 on macOS arm64
            let name = (ent as i64 + 21) as *u8
            if name[0] == 46 {
                if name[1] == 0 { continue }
                if name[1] == 46 && name[2] == 0 { continue }
            }
            count = count + 1
        }
        closedir(dir)

        let dir2 = opendir(pathBuf as *u8)
        if dir2 as i64 == 0 { return }

        let arr = iso.array(count)
        var idx: u32 = 0
        while true {
            let ent = readdir(dir2)
            if ent as i64 == 0 { break }
            let name = (ent as i64 + 21) as *u8
            if name[0] == 46 {
                if name[1] == 0 { continue }
                if name[1] == 46 && name[2] == 0 { continue }
            }
            let nameLen = strlen(name) as i32
            let str = iso.stringLen(name, nameLen)
            ctx.objectSetIndex(arr, idx, str)
            idx = idx + 1
        }
        closedir(dir2)
        ci.ret(arr)
    }
}

fn fsRealpath(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    var pathBuf: [u8; 4096] = [0; 4096]
    unsafe {
        let plen = getStringArg(info, 0, pathBuf as *u8, 4096)
        if plen < 0 { return }

        var resolved: [u8; 4096] = [0; 4096]
        let r = realpath(pathBuf as *u8, resolved as *u8)
        if r as i64 != 0 {
            ci.retStr(resolved as *u8)
        }
    }
}

fn fsChmod(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    var pathBuf: [u8; 4096] = [0; 4096]
    unsafe {
        let plen = getStringArg(info, 0, pathBuf as *u8, 4096)
        if plen < 0 { return }
        let mode = getIntArg(info, 1, 0)
        ci.retI32(chmod(pathBuf as *u8, mode as u32))
    }
}

fn nm_init_fs(_iso: *u8, ctx: *u8, exports: i32): void {
    let c = Context { ptr: ctx }
    let exp = Value { slot: exports }
    unsafe {
        c.setMethod(exp, "readFile" as *u8, fsReadFile as *u8)
        c.setMethod(exp, "writeFile" as *u8, fsWriteFile as *u8)
        c.setMethod(exp, "stat" as *u8, fsStat as *u8)
        c.setMethod(exp, "exists" as *u8, fsExists as *u8)
        c.setMethod(exp, "mkdir" as *u8, fsMkdir as *u8)
        c.setMethod(exp, "unlink" as *u8, fsUnlink as *u8)
        c.setMethod(exp, "rmdir" as *u8, fsRmdir as *u8)
        c.setMethod(exp, "rename" as *u8, fsRename as *u8)
        c.setMethod(exp, "readdir" as *u8, fsReaddir as *u8)
        c.setMethod(exp, "realpath" as *u8, fsRealpath as *u8)
        c.setMethod(exp, "chmod" as *u8, fsChmod as *u8)
    }
}
