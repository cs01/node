// fs bindings — native filesystem operations for node-milo.
// C++ glue extracts V8 args, calls these fns, returns V8 results.

from "std/os" import {
    open, close, read, write, lseek, stat, fstat, access,
    lstat, link, truncate, unlink, mkdir, rmdir, rename,
    chmod, fchmod, chown, fchown, lchown, ftruncate,
    symlink, readlink, realpath, mkdtemp, getcwd, chdir,
    fsync, fdatasync, opendir, readdir, closedir, strerror, strlen
}
from "std/platform" import { direntNameOffset, getErrno, statBufSize }

// macOS-specific; not in std/os
extern fn copyfile(src: *u8, dst: *u8, flags: u32): i32

// C helper that unpacks struct stat using the C compiler's struct knowledge
extern fn nm_stat_unpack(raw: *u8, out: *f64): void
extern fn nm_stat_bufsize(): i32

// --- stat: fill a f64[14] buffer with stat fields ---
// Layout: [dev, mode, nlink, uid, gid, rdev, blksize, ino, size, blocks,
//          atimeMs, mtimeMs, ctimeMs, birthtimeMs]

fn nm_fs_stat(path: *u8, result_buf: *f64): i32 {
    unsafe {
        var buf: [u8; 256] = [0; 256]
        let rc = stat(path, buf as *u8)
        if rc != 0 { return -1 }
        nm_stat_unpack(buf as *u8, result_buf)
        return 0
    }
}

fn nm_fs_lstat(path: *u8, result_buf: *f64): i32 {
    unsafe {
        var buf: [u8; 256] = [0; 256]
        let rc = lstat(path, buf as *u8)
        if rc != 0 { return -1 }
        nm_stat_unpack(buf as *u8, result_buf)
        return 0
    }
}

fn nm_fs_fstat(fd: i32, result_buf: *f64): i32 {
    unsafe {
        var buf: [u8; 256] = [0; 256]
        let rc = fstat(fd, buf as *u8)
        if rc != 0 { return -1 }
        nm_stat_unpack(buf as *u8, result_buf)
        return 0
    }
}

// --- basic fs ops ---

fn nm_fs_open(path: *u8, flags: i32, mode: i32): i32 {
    unsafe { return open(path, flags, mode) }
}

fn nm_fs_close(fd: i32): i32 {
    unsafe { return close(fd) }
}

fn nm_fs_read(fd: i32, buf: *u8, len: i32, offset: i64): i32 {
    unsafe {
        if offset >= 0 { lseek(fd, offset, 0) }
        return read(fd, buf, len as i64) as i32
    }
}

fn nm_fs_write(fd: i32, buf: *u8, len: i32, offset: i64): i32 {
    unsafe {
        if offset >= 0 { lseek(fd, offset, 0) }
        return write(fd, buf, len as i64) as i32
    }
}

fn nm_fs_unlink(path: *u8): i32 {
    unsafe { return unlink(path) }
}

fn nm_fs_mkdir(path: *u8, mode: i32): i32 {
    unsafe { return mkdir(path, mode as u32) }
}

fn nm_fs_rmdir(path: *u8): i32 {
    unsafe { return rmdir(path) }
}

fn nm_fs_rename(old_path: *u8, new_path: *u8): i32 {
    unsafe { return rename(old_path, new_path) }
}

fn nm_fs_chmod(path: *u8, mode: i32): i32 {
    unsafe { return chmod(path, mode as u32) }
}

fn nm_fs_fchmod(fd: i32, mode: i32): i32 {
    unsafe { return fchmod(fd, mode as u32) }
}

fn nm_fs_chown(path: *u8, uid: i32, gid: i32): i32 {
    unsafe { return chown(path, uid as u32, gid as u32) }
}

fn nm_fs_fchown(fd: i32, uid: i32, gid: i32): i32 {
    unsafe { return fchown(fd, uid as u32, gid as u32) }
}

fn nm_fs_lchown(path: *u8, uid: i32, gid: i32): i32 {
    unsafe { return lchown(path, uid as u32, gid as u32) }
}

fn nm_fs_ftruncate(fd: i32, length: i64): i32 {
    unsafe { return ftruncate(fd, length) }
}

fn nm_fs_access(path: *u8, mode: i32): i32 {
    unsafe { return access(path, mode) }
}

fn nm_fs_link(existing: *u8, new_path: *u8): i32 {
    unsafe { return link(existing, new_path) }
}

fn nm_fs_symlink(target: *u8, path: *u8): i32 {
    unsafe { return symlink(target, path) }
}

fn nm_fs_truncate(path: *u8, length: i64): i32 {
    unsafe { return truncate(path, length) }
}

fn nm_fs_readlink(path: *u8, buf: *u8, bufsize: i32): i32 {
    unsafe { return readlink(path, buf, bufsize as i64) as i32 }
}

fn nm_fs_realpath(path: *u8, resolved: *u8): i32 {
    unsafe {
        let r = realpath(path, resolved)
        if r as i64 == 0 as i64 { return -1 }
        return 0
    }
}

fn nm_fs_mkdtemp(template: *u8): *u8 {
    unsafe { return mkdtemp(template) }
}

fn nm_fs_getcwd(buf: *u8, size: i32): i32 {
    unsafe {
        let r = getcwd(buf, size as i64)
        if r as i64 == 0 as i64 { return -1 }
        return 0
    }
}

fn nm_fs_chdir(path: *u8): i32 {
    unsafe { return chdir(path) }
}

fn nm_fs_fsync(fd: i32): i32 {
    unsafe { return fsync(fd) }
}

fn nm_fs_fdatasync(fd: i32): i32 {
    unsafe { return fdatasync(fd) }
}

fn nm_fs_copyfile(src: *u8, dst: *u8, flags: i32): i32 {
    unsafe { return copyfile(src, dst, flags as u32) }
}

fn nm_fs_readdir_bufsize(path: *u8): i32 {
    unsafe {
        let dir = opendir(path)
        if dir as i64 == 0 as i64 {
            return -1
        }

        let nameOff = direntNameOffset()
        var total: i64 = 0

        while true {
            let ent = readdir(dir)
            if ent as i64 == 0 as i64 {
                break
            }

            let namePtr = (ent as i64 + nameOff) as *u8
            if !_isDotEntry(namePtr) {
                total = total + strlen(namePtr) + 1
            }
        }

        closedir(dir)
        return total as i32
    }
}

fn nm_fs_readdir(path: *u8, buf: *u8, bufsize: i32): i32 {
    unsafe {
        let dir = opendir(path)
        if dir as i64 == 0 as i64 {
            return -1
        }

        let nameOff = direntNameOffset()
        var used: i64 = 0
        let limit = bufsize as i64

        while true {
            let ent = readdir(dir)
            if ent as i64 == 0 as i64 {
                break
            }

            let namePtr = (ent as i64 + nameOff) as *u8
            if _isDotEntry(namePtr) {
                continue
            }

            let nameLen = strlen(namePtr)
            if used + nameLen + 1 > limit {
                closedir(dir)
                return -1
            }

            var i: i64 = 0
            while i < nameLen {
                buf[used + i] = namePtr[i]
                i = i + 1
            }
            buf[used + nameLen] = 0
            used = used + nameLen + 1
        }

        closedir(dir)
        return used as i32
    }
}

fn nm_fs_errno(): i32 {
    return getErrno()
}

fn nm_fs_strerror(errnum: i32, buf: *u8, bufsize: i32) {
    unsafe {
        let msg = strerror(errnum)
        let len = strlen(msg)
        var n = len
        let limit = (bufsize - 1) as i64
        if n >= limit { n = limit }
        var i: i64 = 0
        while i < n {
            buf[i] = msg[i]
            i = i + 1
        }
        buf[n] = 0
    }
}

fn _isDotEntry(name: *u8): bool {
    unsafe {
        if name[0] == 46 {
            if name[1] == 0 {
                return true
            }
            if name[1] == 46 && name[2] == 0 {
                return true
            }
        }
        return false
    }
}
