// buffer binding — ArrayBuffer allocation for Node's Buffer implementation

from "../v8/v8" import { CallbackInfo, Isolate, Context, Value }

fn bufCreateUnsafeArrayBuffer(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    if ci.length() < 1 { return }
    let iso = ci.isolate()
    var size: i32 = 0
    unsafe { ci.arg(0).toI32(iso, &size) }
    if size < 0 { size = 0 }
    ci.ret(iso.arraybufferNew(size as i64))
}

fn bufSetDetachKey(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    ci.retUndefined()
}

fn bufNoopWrite(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    let iso = ci.isolate()
    ci.ret(iso.int32(0))
}

fn nm_init_buffer(_iso: *u8, ctx: *u8, exports: i32): void {
    let c = Context { ptr: ctx }
    let exp = Value { slot: exports }
    unsafe {
        c.setMethod(exp, "createUnsafeArrayBuffer" as *u8, bufCreateUnsafeArrayBuffer as *u8)
        c.setMethod(exp, "setDetachKey" as *u8, bufSetDetachKey as *u8)
        c.setMethod(exp, "utf8Write" as *u8, bufNoopWrite as *u8)
        c.setMethod(exp, "utf8WriteStatic" as *u8, bufNoopWrite as *u8)
        c.setMethod(exp, "latin1Write" as *u8, bufNoopWrite as *u8)
        c.setMethod(exp, "latin1WriteStatic" as *u8, bufNoopWrite as *u8)
        c.setMethod(exp, "asciiWrite" as *u8, bufNoopWrite as *u8)
        c.setMethod(exp, "hexWrite" as *u8, bufNoopWrite as *u8)
        c.setMethod(exp, "ucs2Write" as *u8, bufNoopWrite as *u8)
        c.setMethod(exp, "base64Write" as *u8, bufNoopWrite as *u8)
        c.setMethod(exp, "base64urlWrite" as *u8, bufNoopWrite as *u8)
    }
}
