// process bindings — hrtime, kill, cpuUsage, utimes/futimes via POSIX + extern struct

// --- C struct layouts ---

extern struct Timespec {
    tv_sec: i64,
    tv_nsec: i64,
}

extern struct Timeval {
    tv_sec: i64,
    tv_usec: i32,
}

// 144 bytes on macOS — we only read the first two timeval fields
extern struct Rusage {
    ru_utime: Timeval,
    ru_stime: Timeval,
    _p0: i64, _p1: i64, _p2: i64, _p3: i64,
    _p4: i64, _p5: i64, _p6: i64, _p7: i64,
    _p8: i64, _p9: i64, _pA: i64, _pB: i64,
    _pC: i64, _pD: i64,
}

// --- POSIX ---

extern fn clock_gettime(clk_id: i32, tp: *Timespec): i32
extern fn kill(pid: i32, sig: i32): i32
extern fn getrusage(who: i32, usage: *Rusage): i32
extern fn utimes(path: *u8, times: *Timeval): i32
extern fn futimes(fd: i32, times: *Timeval): i32

// CLOCK_MONOTONIC: macOS = 6, Linux = 1
// Hardcoded per platform — no C helper needed

// v8capi FFI — v8c_value is struct { i32 slot }, ABI-equivalent to i32
extern fn v8c_fci_length(info: *u8): i32
extern fn v8c_fci_arg(info: *u8, idx: i32): i32
extern fn v8c_fci_isolate(info: *u8): *u8
extern fn v8c_fci_context(info: *u8): *u8
extern fn v8c_fci_return(info: *u8, val: i32): void
extern fn v8c_fci_return_int32(info: *u8, val: i32): void
extern fn v8c_fci_return_double(info: *u8, val: f64): void
extern fn v8c_to_int32(iso: *u8, val: i32, out: *i32): i32
extern fn v8c_bigint_i64(iso: *u8, val: i64): i32
extern fn v8c_array_new(iso: *u8, length: i32): i32
extern fn v8c_object_set_index(ctx: *u8, obj: i32, idx: u32, val: i32): i32
extern fn v8c_number(iso: *u8, val: f64): i32
extern fn v8c_object_new(iso: *u8): i32
extern fn v8c_object_set(ctx: *u8, obj: i32, key: *u8, val: i32): i32
extern fn v8c_function_new(ctx: *u8, cb: *u8, data: *u8): i32
extern fn v8c_context_global(ctx: *u8): i32

extern fn argI32(info: *u8, idx: i32, defaultVal: i32): i32

// --- hrtime ---

fn processHrtime(info: *u8, _ud: *u8): void {
    var ts = Timespec { tv_sec: 0, tv_nsec: 0 }
    unsafe {
        let clk = 6
        let iso = v8c_fci_isolate(info)
        let ctx = v8c_fci_context(info)
        let arr = v8c_array_new(iso, 2)
        if clock_gettime(clk, &ts) != 0 {
            v8c_object_set_index(ctx, arr, 0, v8c_number(iso, 0.0))
            v8c_object_set_index(ctx, arr, 1, v8c_number(iso, 0.0))
        } else {
            v8c_object_set_index(ctx, arr, 0, v8c_number(iso, ts.tv_sec as f64))
            v8c_object_set_index(ctx, arr, 1, v8c_number(iso, ts.tv_nsec as f64))
        }
        v8c_fci_return(info, arr)
    }
}

fn processHrtimeBigint(info: *u8, _ud: *u8): void {
    var ts = Timespec { tv_sec: 0, tv_nsec: 0 }
    unsafe {
        let clk = 6
        let iso = v8c_fci_isolate(info)
        if clock_gettime(clk, &ts) != 0 {
            v8c_fci_return(info, v8c_bigint_i64(iso, 0))
            return
        }
        v8c_fci_return(info, v8c_bigint_i64(iso, ts.tv_sec * 1000000000 + ts.tv_nsec))
    }
}

// --- kill ---

fn processKill(info: *u8, _ud: *u8): void {
    unsafe {
        let pid = argI32(info, 0, 0)
        let sig = argI32(info, 1, 15)
        v8c_fci_return_int32(info, kill(pid, sig))
    }
}

// --- cpuUsage: returns [user_usec, system_usec] ---

fn processCpuUsage(info: *u8, _ud: *u8): void {
    var ru = Rusage {
        ru_utime: Timeval { tv_sec: 0, tv_usec: 0 },
        ru_stime: Timeval { tv_sec: 0, tv_usec: 0 },
        _p0: 0, _p1: 0, _p2: 0, _p3: 0,
        _p4: 0, _p5: 0, _p6: 0, _p7: 0,
        _p8: 0, _p9: 0, _pA: 0, _pB: 0,
        _pC: 0, _pD: 0,
    }
    unsafe {
        let iso = v8c_fci_isolate(info)
        let ctx = v8c_fci_context(info)
        let arr = v8c_array_new(iso, 2)
        if getrusage(0, &ru) != 0 {
            v8c_object_set_index(ctx, arr, 0, v8c_number(iso, 0.0))
            v8c_object_set_index(ctx, arr, 1, v8c_number(iso, 0.0))
        } else {
            let user_us = ru.ru_utime.tv_sec * 1000000 + ru.ru_utime.tv_usec as i64
            let sys_us = ru.ru_stime.tv_sec * 1000000 + ru.ru_stime.tv_usec as i64
            v8c_object_set_index(ctx, arr, 0, v8c_number(iso, user_us as f64))
            v8c_object_set_index(ctx, arr, 1, v8c_number(iso, sys_us as f64))
        }
        v8c_fci_return(info, arr)
    }
}

// --- utimes/futimes (called from C, not V8 callbacks) ---

fn nmFsUtimes(path: *u8, atime_sec: i64, atime_usec: i64, mtime_sec: i64, mtime_usec: i64): i32 {
    var tv: [Timeval; 2] = [
        Timeval { tv_sec: atime_sec, tv_usec: atime_usec as i32 },
        Timeval { tv_sec: mtime_sec, tv_usec: mtime_usec as i32 },
    ]
    unsafe { return utimes(path, tv as *Timeval) }
}

fn nmFsFutimes(fd: i32, atime_sec: i64, atime_usec: i64, mtime_sec: i64, mtime_usec: i64): i32 {
    var tv: [Timeval; 2] = [
        Timeval { tv_sec: atime_sec, tv_usec: atime_usec as i32 },
        Timeval { tv_sec: mtime_sec, tv_usec: mtime_usec as i32 },
    ]
    unsafe { return futimes(fd, tv as *Timeval) }
}

// --- setup ---

extern fn setMethod(ctx: *u8, obj: i32, name: *u8, cb: *u8): void

// Binding init — populates exports object for internalBinding('process_methods')
fn nm_init_process_methods(iso: *u8, ctx: *u8, exports: i32): void {
    unsafe {
        setMethod(ctx, exports, "hrtime", processHrtime as *u8)
        setMethod(ctx, exports, "hrtimeBigint", processHrtimeBigint as *u8)
        setMethod(ctx, exports, "kill", processKill as *u8)
        setMethod(ctx, exports, "cpuUsage", processCpuUsage as *u8)
    }
}
