// process bindings — hrtime, kill, cpuUsage, utimes/futimes via POSIX + extern struct

from "../v8/v8" import { CallbackInfo, Isolate, Context, Value }

// --- C struct layouts ---

extern struct Timespec {
    tv_sec: i64,
    tv_nsec: i64,
}

extern struct Timeval {
    tv_sec: i64,
    tv_usec: i32,
}

// 144 bytes on macOS — we only read the first two timeval fields
extern struct Rusage {
    ru_utime: Timeval,
    ru_stime: Timeval,
    _p0: i64, _p1: i64, _p2: i64, _p3: i64,
    _p4: i64, _p5: i64, _p6: i64, _p7: i64,
    _p8: i64, _p9: i64, _pA: i64, _pB: i64,
    _pC: i64, _pD: i64,
}

// --- POSIX ---

extern fn clock_gettime(clk_id: i32, tp: *Timespec): i32
extern fn kill(pid: i32, sig: i32): i32
extern fn getrusage(who: i32, usage: *Rusage): i32
extern fn utimes(path: *u8, times: *Timeval): i32
extern fn futimes(fd: i32, times: *Timeval): i32

// CLOCK_MONOTONIC: macOS = 6

// --- hrtime ---

fn processHrtime(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    let iso = ci.isolate()
    let ctx = ci.context()
    var ts = Timespec { tv_sec: 0, tv_nsec: 0 }
    let arr = iso.array(2)
    unsafe {
        if clock_gettime(6, &ts) != 0 {
            ctx.objectSetIndex(arr, 0, iso.number(0.0))
            ctx.objectSetIndex(arr, 1, iso.number(0.0))
        } else {
            ctx.objectSetIndex(arr, 0, iso.number(ts.tv_sec as f64))
            ctx.objectSetIndex(arr, 1, iso.number(ts.tv_nsec as f64))
        }
    }
    ci.ret(arr)
}

fn processHrtimeBigint(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    let iso = ci.isolate()
    var ts = Timespec { tv_sec: 0, tv_nsec: 0 }
    unsafe {
        if clock_gettime(6, &ts) != 0 {
            ci.ret(iso.bigintI64(0))
            return
        }
        ci.ret(iso.bigintI64(ts.tv_sec * 1000000000 + ts.tv_nsec))
    }
}

// --- kill ---

fn processKill(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    unsafe { ci.retI32(kill(ci.i32Arg(0, 0), ci.i32Arg(1, 15))) }
}

// --- cpuUsage: returns [user_usec, system_usec] ---

fn processCpuUsage(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    let iso = ci.isolate()
    let ctx = ci.context()
    var ru = Rusage {
        ru_utime: Timeval { tv_sec: 0, tv_usec: 0 },
        ru_stime: Timeval { tv_sec: 0, tv_usec: 0 },
        _p0: 0, _p1: 0, _p2: 0, _p3: 0,
        _p4: 0, _p5: 0, _p6: 0, _p7: 0,
        _p8: 0, _p9: 0, _pA: 0, _pB: 0,
        _pC: 0, _pD: 0,
    }
    let arr = iso.array(2)
    unsafe {
        if getrusage(0, &ru) != 0 {
            ctx.objectSetIndex(arr, 0, iso.number(0.0))
            ctx.objectSetIndex(arr, 1, iso.number(0.0))
        } else {
            let user_us = ru.ru_utime.tv_sec * 1000000 + ru.ru_utime.tv_usec as i64
            let sys_us = ru.ru_stime.tv_sec * 1000000 + ru.ru_stime.tv_usec as i64
            ctx.objectSetIndex(arr, 0, iso.number(user_us as f64))
            ctx.objectSetIndex(arr, 1, iso.number(sys_us as f64))
        }
    }
    ci.ret(arr)
}

// --- utimes/futimes (called from C, not V8 callbacks) ---

fn nmFsUtimes(path: *u8, atime_sec: i64, atime_usec: i64, mtime_sec: i64, mtime_usec: i64): i32 {
    var tv: [Timeval; 2] = [
        Timeval { tv_sec: atime_sec, tv_usec: atime_usec as i32 },
        Timeval { tv_sec: mtime_sec, tv_usec: mtime_usec as i32 },
    ]
    unsafe { return utimes(path, tv as *Timeval) }
}

fn nmFsFutimes(fd: i32, atime_sec: i64, atime_usec: i64, mtime_sec: i64, mtime_usec: i64): i32 {
    var tv: [Timeval; 2] = [
        Timeval { tv_sec: atime_sec, tv_usec: atime_usec as i32 },
        Timeval { tv_sec: mtime_sec, tv_usec: mtime_usec as i32 },
    ]
    unsafe { return futimes(fd, tv as *Timeval) }
}

// --- setup ---

fn nm_init_process_methods(iso: *u8, ctx: *u8, exports: i32): void {
    let i = Isolate { ptr: iso }
    let c = Context { ptr: ctx }
    let exp = Value { slot: exports }
    unsafe {
        c.setMethod(exp, "hrtime" as *u8, processHrtime as *u8)
        c.setMethod(exp, "hrtimeBigint" as *u8, processHrtimeBigint as *u8)
        c.setMethod(exp, "kill" as *u8, processKill as *u8)
        c.setMethod(exp, "cpuUsage" as *u8, processCpuUsage as *u8)

        // hrtimeBuffer: Uint32Array(5) backed by ArrayBuffer(20)
        let ab = i.arraybufferNew(20)
        let u32arr = i.uint32arrayNew(ab, 0, 5)
        c.objectSet(exp, "hrtimeBuffer" as *u8, u32arr)
    }
}
