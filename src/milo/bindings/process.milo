// process bindings — hrtime, kill, cpuUsage, utimes/futimes via POSIX + extern struct

// --- C struct layouts ---

extern struct Timespec {
    tv_sec: i64,
    tv_nsec: i64,
}

extern struct Timeval {
    tv_sec: i64,
    tv_usec: i32,
}

// 144 bytes on macOS — we only read the first two timeval fields
extern struct Rusage {
    ru_utime: Timeval,
    ru_stime: Timeval,
    _p0: i64, _p1: i64, _p2: i64, _p3: i64,
    _p4: i64, _p5: i64, _p6: i64, _p7: i64,
    _p8: i64, _p9: i64, _pA: i64, _pB: i64,
    _pC: i64, _pD: i64,
}

// --- POSIX ---

extern fn clock_gettime(clk_id: i32, tp: *Timespec): i32
extern fn kill(pid: i32, sig: i32): i32
extern fn getrusage(who: i32, usage: *Rusage): i32
extern fn utimes(path: *u8, times: *Timeval): i32
extern fn futimes(fd: i32, times: *Timeval): i32

// macOS CLOCK_MONOTONIC = 6, Linux = 1
extern fn nm_clock_monotonic_id(): i32

// --- V8 C API ---

extern fn v8c_args_count(info: *u8): i32
extern fn v8c_arg_int32(info: *u8, idx: i32, default_val: i32): i32
extern fn v8c_return_int32(info: *u8, val: i32): void
extern fn v8c_return_double(info: *u8, val: f64): void
extern fn v8c_return_bigint_i64(info: *u8, val: i64): void
extern fn v8c_return_array_double2(info: *u8, a: f64, b: f64): void
extern fn v8c_obj_new(rt: *u8): i32
extern fn v8c_obj_set_fn(rt: *u8, obj: i32, name: *u8, cb: *u8, user_data: *u8): void
extern fn v8c_set_global(rt: *u8, name: *u8, obj: i32): void

// --- hrtime ---

fn process_hrtime(info: *u8, _ud: *u8): void {
    var ts = Timespec { tv_sec: 0, tv_nsec: 0 }
    unsafe {
        let clk = nm_clock_monotonic_id()
        if clock_gettime(clk, &ts) != 0 {
            v8c_return_array_double2(info, 0.0, 0.0)
            return
        }
        v8c_return_array_double2(info, ts.tv_sec as f64, ts.tv_nsec as f64)
    }
}

fn process_hrtime_bigint(info: *u8, _ud: *u8): void {
    var ts = Timespec { tv_sec: 0, tv_nsec: 0 }
    unsafe {
        let clk = nm_clock_monotonic_id()
        if clock_gettime(clk, &ts) != 0 {
            v8c_return_bigint_i64(info, 0)
            return
        }
        v8c_return_bigint_i64(info, ts.tv_sec * 1000000000 + ts.tv_nsec)
    }
}

// --- kill ---

fn process_kill(info: *u8, _ud: *u8): void {
    unsafe {
        let pid = v8c_arg_int32(info, 0, 0)
        let sig = v8c_arg_int32(info, 1, 15)
        v8c_return_int32(info, kill(pid, sig))
    }
}

// --- cpuUsage: returns [user_usec, system_usec] ---

fn process_cpu_usage(info: *u8, _ud: *u8): void {
    var ru = Rusage {
        ru_utime: Timeval { tv_sec: 0, tv_usec: 0 },
        ru_stime: Timeval { tv_sec: 0, tv_usec: 0 },
        _p0: 0, _p1: 0, _p2: 0, _p3: 0,
        _p4: 0, _p5: 0, _p6: 0, _p7: 0,
        _p8: 0, _p9: 0, _pA: 0, _pB: 0,
        _pC: 0, _pD: 0,
    }
    unsafe {
        if getrusage(0, &ru) != 0 {
            v8c_return_array_double2(info, 0.0, 0.0)
            return
        }
        let user_us = ru.ru_utime.tv_sec * 1000000 + ru.ru_utime.tv_usec as i64
        let sys_us = ru.ru_stime.tv_sec * 1000000 + ru.ru_stime.tv_usec as i64
        v8c_return_array_double2(info, user_us as f64, sys_us as f64)
    }
}

// --- utimes/futimes ---

fn nm_fs_utimes(path: *u8, atime_sec: i64, atime_usec: i64, mtime_sec: i64, mtime_usec: i64): i32 {
    var tv: [Timeval; 2] = [
        Timeval { tv_sec: atime_sec, tv_usec: atime_usec as i32 },
        Timeval { tv_sec: mtime_sec, tv_usec: mtime_usec as i32 },
    ]
    unsafe { return utimes(path, tv as *Timeval) }
}

fn nm_fs_futimes(fd: i32, atime_sec: i64, atime_usec: i64, mtime_sec: i64, mtime_usec: i64): i32 {
    var tv: [Timeval; 2] = [
        Timeval { tv_sec: atime_sec, tv_usec: atime_usec as i32 },
        Timeval { tv_sec: mtime_sec, tv_usec: mtime_usec as i32 },
    ]
    unsafe { return futimes(fd, tv as *Timeval) }
}

// --- setup ---

fn nm_setup_process(rt: *u8): void {
    unsafe {
        let obj = v8c_obj_new(rt)
        v8c_obj_set_fn(rt, obj, "hrtime", process_hrtime as *u8, 0 as *u8)
        v8c_obj_set_fn(rt, obj, "hrtimeBigint", process_hrtime_bigint as *u8, 0 as *u8)
        v8c_obj_set_fn(rt, obj, "kill", process_kill as *u8, 0 as *u8)
        v8c_obj_set_fn(rt, obj, "cpuUsage", process_cpu_usage as *u8, 0 as *u8)
        v8c_set_global(rt, "__nm_process", obj)
    }
}
