// os bindings — native OS info via v8capi, calling POSIX/macOS APIs directly

// POSIX / macOS syscalls (not all in std/os yet)
extern fn gethostname(name: *u8, len: i64): i32
extern fn getuid(): u32
extern fn getgid(): u32
extern fn geteuid(): u32
extern fn getegid(): u32
extern fn getpid(): i32
extern fn getppid(): i32
extern fn umask(mask: u32): u32
extern fn getpriority(which: i32, who: i32): i32
extern fn setpriority(which: i32, who: i32, prio: i32): i32
extern fn sysconf(name: i32): i64
extern fn sysctlbyname(name: *u8, oldp: *u8, oldlenp: *i64, newp: *u8, newlen: i64): i32
extern fn sysctl(name: *i32, namelen: u32, oldp: *u8, oldlenp: *i64, newp: *u8, newlen: i64): i32
extern fn getloadavg(loadavg: *f64, nelem: i32): i32
extern fn gettimeofday(tv: *i64, tz: *u8): i32

// Mach (macOS)
extern fn mach_host_self(): u32
extern fn host_processor_info(host: u32, flavor: i32, count: *u32, info: **i32, info_count: *u32): i32
extern fn host_statistics64(host: u32, flavor: i32, info: *u8, count: *u32): i32
extern fn vm_deallocate(task: u32, addr: i64, size: i64): i32
extern fn mach_task_self_(): u32
// _SC_PAGESIZE = 29 on macOS

// macOS constants
// _SC_NPROCESSORS_ONLN = 58
// PROCESSOR_CPU_LOAD_INFO = 2
// CPU_STATE_USER=0, NICE=1, SYSTEM=2, IDLE=3, MAX=4
// HOST_VM_INFO64 = 4, HOST_VM_INFO64_COUNT = 38
// CTL_KERN=1, KERN_BOOTTIME=21

// v8capi FFI
extern fn v8c_fci_length(info: *u8): i32
extern fn v8c_fci_arg(info: *u8, idx: i32): i32
extern fn v8c_fci_isolate(info: *u8): *u8
extern fn v8c_fci_context(info: *u8): *u8
extern fn v8c_fci_return_string(info: *u8, str: *u8): void
extern fn v8c_fci_return_int32(info: *u8, val: i32): void
extern fn v8c_fci_return_uint32(info: *u8, val: u32): void
extern fn v8c_fci_return_double(info: *u8, val: f64): void
extern fn v8c_to_int32(iso: *u8, val: i32, out: *i32): i32
extern fn v8c_object_new(iso: *u8): i32
extern fn v8c_object_set(ctx: *u8, obj: i32, key: *u8, val: i32): i32
extern fn v8c_function_new(ctx: *u8, cb: *u8, data: *u8): i32
extern fn v8c_context_global(ctx: *u8): i32

extern fn argI32(info: *u8, idx: i32, defaultVal: i32): i32

// --- V8 callback handlers ---

fn osGetHostname(info: *u8, _ud: *u8): void {
    var buf: [u8; 256] = [0; 256]
    unsafe {
        if gethostname(buf as *u8, 256) == 0 {
            v8c_fci_return_string(info, buf as *u8)
        }
    }
}

fn osGetCpus(info: *u8, _ud: *u8): void {
    unsafe {
        var n = sysconf(58) as i32
        if n < 1 { n = 1 }
        v8c_fci_return_int32(info, n)
    }
}

fn osGetPid(info: *u8, _ud: *u8): void {
    unsafe { v8c_fci_return_int32(info, getpid()) }
}

fn osGetPpid(info: *u8, _ud: *u8): void {
    unsafe { v8c_fci_return_int32(info, getppid()) }
}

fn osGetCpuModel(info: *u8, _ud: *u8): void {
    var buf: [u8; 256] = [0; 256]
    unsafe {
        var len: [i64; 1] = [256]
        sysctlbyname("machdep.cpu.brand_string", buf as *u8, len as *i64, 0 as *u8, 0)
        v8c_fci_return_string(info, buf as *u8)
    }
}

fn osGetFreemem(info: *u8, _ud: *u8): void {
    // HOST_VM_INFO64 = 4, HOST_VM_INFO64_COUNT = 38
    var stats: [u8; 512] = [0; 512]
    var count: [u32; 1] = [38]
    unsafe {
        if host_statistics64(mach_host_self(), 4, stats as *u8, count as *u32) == 0 {
            // free_count is at offset 8 in vm_statistics64_data (after natural_t fields)
            // On macOS: free_count is the 2nd u64 field (offset 8 bytes)
            let free_pages = (stats as *i64)[1]
            let page_size = sysconf(29)
            v8c_fci_return_double(info, (free_pages * page_size) as f64)
        } else {
            v8c_fci_return_double(info, 0.0)
        }
    }
}

fn osGetTotalmem(info: *u8, _ud: *u8): void {
    var mem: [i64; 1] = [0]
    var len: [i64; 1] = [8]
    unsafe {
        sysctlbyname("hw.memsize", mem as *u8, len as *i64, 0 as *u8, 0)
        v8c_fci_return_double(info, mem[0] as f64)
    }
}

fn osGetUptime(info: *u8, _ud: *u8): void {
    // sysctl CTL_KERN=1, KERN_BOOTTIME=21
    var mib: [i32; 2] = [1, 21]
    var boottime: [i64; 2] = [0, 0]
    var len: [i64; 1] = [16]
    unsafe {
        if sysctl(mib as *i32, 2, boottime as *u8, len as *i64, 0 as *u8, 0) != 0 {
            v8c_fci_return_double(info, 0.0)
            return
        }
        var now: [i64; 2] = [0, 0]
        gettimeofday(now as *i64, 0 as *u8)
        let secs = now[0] - boottime[0]
        v8c_fci_return_double(info, secs as f64)
    }
}

fn osGetLoadavg1(info: *u8, _ud: *u8): void {
    var avg: [f64; 3] = [0.0; 3]
    unsafe {
        getloadavg(avg as *f64, 3)
        v8c_fci_return_double(info, avg[0])
    }
}

fn osGetLoadavg5(info: *u8, _ud: *u8): void {
    var avg: [f64; 3] = [0.0; 3]
    unsafe {
        getloadavg(avg as *f64, 3)
        v8c_fci_return_double(info, avg[1])
    }
}

fn osGetLoadavg15(info: *u8, _ud: *u8): void {
    var avg: [f64; 3] = [0.0; 3]
    unsafe {
        getloadavg(avg as *f64, 3)
        v8c_fci_return_double(info, avg[2])
    }
}

fn osGetOsRelease(info: *u8, _ud: *u8): void {
    var buf: [u8; 256] = [0; 256]
    unsafe {
        var len: [i64; 1] = [256]
        sysctlbyname("kern.osrelease", buf as *u8, len as *i64, 0 as *u8, 0)
        v8c_fci_return_string(info, buf as *u8)
    }
}

fn osSetPriority(info: *u8, _ud: *u8): void {
    unsafe {
        let pid = argI32(info, 0, 0)
        let prio = argI32(info, 1, 0)
        let r = setpriority(0, pid, prio)
        v8c_fci_return_int32(info, r)
    }
}

fn osGetPriority(info: *u8, _ud: *u8): void {
    unsafe {
        let pid = argI32(info, 0, 0)
        let p = getpriority(0, pid)
        v8c_fci_return_int32(info, p)
    }
}

fn osUmask(info: *u8, _ud: *u8): void {
    unsafe {
        if v8c_fci_length(info) > 0 {
            let new_mask = argI32(info, 0, -1)
            if new_mask >= 0 {
                let old = umask(new_mask as u32)
                v8c_fci_return_uint32(info, old)
                return
            }
        }
        let cur = umask(0)
        umask(cur)
        v8c_fci_return_uint32(info, cur)
    }
}

// --- setup ---

extern fn setMethod(ctx: *u8, obj: i32, name: *u8, cb: *u8): void

// Binding init — populates exports object for internalBinding('os')
fn nm_init_os(iso: *u8, ctx: *u8, exports: i32): void {
    unsafe {
        setMethod(ctx, exports, "getHostname", osGetHostname as *u8)
        setMethod(ctx, exports, "getAvailableParallelism", osGetCpus as *u8)
        setMethod(ctx, exports, "getPid", osGetPid as *u8)
        setMethod(ctx, exports, "getPpid", osGetPpid as *u8)
        setMethod(ctx, exports, "umask", osUmask as *u8)
        setMethod(ctx, exports, "getCpuModel", osGetCpuModel as *u8)
        setMethod(ctx, exports, "getFreeMem", osGetFreemem as *u8)
        setMethod(ctx, exports, "getTotalMem", osGetTotalmem as *u8)
        setMethod(ctx, exports, "getUptime", osGetUptime as *u8)
        setMethod(ctx, exports, "getOsRelease", osGetOsRelease as *u8)
        setMethod(ctx, exports, "getLoadAvg1", osGetLoadavg1 as *u8)
        setMethod(ctx, exports, "getLoadAvg5", osGetLoadavg5 as *u8)
        setMethod(ctx, exports, "getLoadAvg15", osGetLoadavg15 as *u8)
        setMethod(ctx, exports, "setPriority", osSetPriority as *u8)
        setMethod(ctx, exports, "getPriority", osGetPriority as *u8)
    }
}

// --- exported for other bindings ---

fn nm_os_getuid(): u32 { unsafe { return getuid() } }
fn nm_os_getgid(): u32 { unsafe { return getgid() } }
fn nm_os_geteuid(): u32 { unsafe { return geteuid() } }
fn nm_os_getegid(): u32 { unsafe { return getegid() } }
