// os bindings — native OS info via v8 wrapper, calling POSIX/macOS APIs directly

from "../v8/v8" import { CallbackInfo, Context, Value }

// POSIX / macOS syscalls
extern fn gethostname(name: *u8, len: i64): i32
extern fn getuid(): u32
extern fn getgid(): u32
extern fn geteuid(): u32
extern fn getegid(): u32
extern fn getpid(): i32
extern fn getppid(): i32
extern fn umask(mask: u32): u32
extern fn setuid(uid: u32): i32
extern fn setgid(gid: u32): i32
extern fn seteuid(uid: u32): i32
extern fn setegid(gid: u32): i32
extern fn getpriority(which: i32, who: i32): i32
extern fn setpriority(which: i32, who: i32, prio: i32): i32
extern fn sysconf(name: i32): i64
extern fn sysctlbyname(name: *u8, oldp: *u8, oldlenp: *i64, newp: *u8, newlen: i64): i32
extern fn sysctl(name: *i32, namelen: u32, oldp: *u8, oldlenp: *i64, newp: *u8, newlen: i64): i32
extern fn getloadavg(loadavg: *f64, nelem: i32): i32
extern fn gettimeofday(tv: *i64, tz: *u8): i32

// Mach (macOS)
extern fn mach_host_self(): u32
extern fn host_processor_info(host: u32, flavor: i32, count: *u32, info: **i32, info_count: *u32): i32
extern fn host_statistics64(host: u32, flavor: i32, info: *u8, count: *u32): i32
extern fn vm_deallocate(task: u32, addr: i64, size: i64): i32
extern fn mach_task_self_(): u32
extern fn strlen(s: *u8): i64
extern fn malloc(size: i64): *u8
extern fn free(ptr: *u8): void

// C helpers in entry.c
extern fn nm_cpu_speed(): i64
extern fn nm_cpu_times(outTimes: *u32, maxCpus: i32): i32
extern fn nm_net_interfaces(out: *u8, outLen: i32): i32
extern fn nm_userinfo(uid: i32, out: *u8, outLen: i32): i32
extern fn nm_uname_machine(out: *u8, outLen: i32): i32
extern fn nm_resolve_user(name: *u8): i32
extern fn nm_resolve_group(name: *u8): i32
extern fn nm_uname_sysname(out: *u8, outLen: i32): i32

fn osGetHostname(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    var buf: [u8; 256] = [0; 256]
    unsafe {
        if gethostname(buf as *u8, 256) == 0 {
            ci.retStr(buf as *u8)
        }
    }
}

fn osGetCpus(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    unsafe {
        var n = sysconf(58) as i32
        if n < 1 { n = 1 }
        ci.retI32(n)
    }
}

fn osGetPid(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    unsafe { ci.retI32(getpid()) }
}

fn osGetPpid(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    unsafe { ci.retI32(getppid()) }
}

fn osGetCpuModel(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    var buf: [u8; 256] = [0; 256]
    unsafe {
        var len: [i64; 1] = [256]
        sysctlbyname("machdep.cpu.brand_string", buf as *u8, len as *i64, 0 as *u8, 0)
        ci.retStr(buf as *u8)
    }
}

fn osGetFreemem(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    // HOST_VM_INFO64 = 4, HOST_VM_INFO64_COUNT = 38
    // vm_statistics64_data_t: free_count is natural_t (u32) at offset 0
    var stats: [u8; 512] = [0; 512]
    var count: [u32; 1] = [38]
    unsafe {
        if host_statistics64(mach_host_self(), 4, stats as *u8, count as *u32) == 0 {
            let free_pages = (stats as *u32)[0] as i64
            let page_size = sysconf(29)
            ci.retF64((free_pages * page_size) as f64)
        } else {
            ci.retF64(0.0)
        }
    }
}

fn osGetTotalmem(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    var mem: [i64; 1] = [0]
    var len: [i64; 1] = [8]
    unsafe {
        sysctlbyname("hw.memsize", mem as *u8, len as *i64, 0 as *u8, 0)
        ci.retF64(mem[0] as f64)
    }
}

fn osGetUptime(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    // sysctl CTL_KERN=1, KERN_BOOTTIME=21
    var mib: [i32; 2] = [1, 21]
    var boottime: [i64; 2] = [0, 0]
    var len: [i64; 1] = [16]
    unsafe {
        if sysctl(mib as *i32, 2, boottime as *u8, len as *i64, 0 as *u8, 0) != 0 {
            ci.retF64(0.0)
            return
        }
        var now: [i64; 2] = [0, 0]
        gettimeofday(now as *i64, 0 as *u8)
        let secs = now[0] - boottime[0]
        ci.retF64(secs as f64)
    }
}

fn osGetLoadavg1(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    var avg: [f64; 3] = [0.0; 3]
    unsafe {
        getloadavg(avg as *f64, 3)
        ci.retF64(avg[0])
    }
}

fn osGetLoadavg5(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    var avg: [f64; 3] = [0.0; 3]
    unsafe {
        getloadavg(avg as *f64, 3)
        ci.retF64(avg[1])
    }
}

fn osGetLoadavg15(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    var avg: [f64; 3] = [0.0; 3]
    unsafe {
        getloadavg(avg as *f64, 3)
        ci.retF64(avg[2])
    }
}

fn osGetOsRelease(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    var buf: [u8; 256] = [0; 256]
    unsafe {
        var len: [i64; 1] = [256]
        sysctlbyname("kern.osrelease", buf as *u8, len as *i64, 0 as *u8, 0)
        ci.retStr(buf as *u8)
    }
}

fn osSetPriority(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    unsafe {
        let pid = ci.i32Arg(0, 0)
        let prio = ci.i32Arg(1, 0)
        ci.retI32(setpriority(0, pid, prio))
    }
}

fn osGetPriority(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    unsafe {
        let pid = ci.i32Arg(0, 0)
        ci.retI32(getpriority(0, pid))
    }
}

fn osUmask(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    unsafe {
        if ci.length() > 0 {
            let new_mask = ci.i32Arg(0, -1)
            if new_mask >= 0 {
                let old = umask(new_mask as u32)
                ci.retU32(old)
                return
            }
        }
        let cur = umask(0)
        umask(cur)
        ci.retU32(cur)
    }
}

fn osGetCpuSpeed(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    unsafe { ci.retI32(nm_cpu_speed() as i32) }
}

fn osGetCpuTimes(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    let iso = ci.isolate()
    let ctx = ci.context()
    unsafe {
        var times: [u32; 256] = [0; 256]
        let ncpu = nm_cpu_times(times as *u32, 64)
        if ncpu < 0 {
            ci.ret(iso.array(0))
            return
        }
        let arr = iso.array(ncpu)
        for i in 0..ncpu {
            let cpuObj = iso.object()
            ctx.objectSet(cpuObj, "user" as *u8, iso.number(times[(i * 4) as i64] as f64 * 10.0))
            ctx.objectSet(cpuObj, "sys" as *u8, iso.number(times[(i * 4 + 1) as i64] as f64 * 10.0))
            ctx.objectSet(cpuObj, "idle" as *u8, iso.number(times[(i * 4 + 2) as i64] as f64 * 10.0))
            ctx.objectSet(cpuObj, "nice" as *u8, iso.number(times[(i * 4 + 3) as i64] as f64 * 10.0))
            ctx.objectSetIndex(arr, i as u32, cpuObj)
        }
        ci.ret(arr)
    }
}

fn osGetNetInterfaces(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    unsafe {
        var buf: [u8; 8192] = [0; 8192]
        let count = nm_net_interfaces(buf as *u8, 8192)
        if count <= 0 {
            ci.retStr("" as *u8)
            return
        }
        let len = strlen(buf as *u8)
        ci.retStrLen(buf as *u8, len as i32)
    }
}

fn nm_init_os(_iso: *u8, ctx: *u8, exports: i32): void {
    let c = Context { ptr: ctx }
    let exp = Value { slot: exports }
    unsafe {
        c.setMethod(exp, "getHostname" as *u8, osGetHostname as *u8)
        c.setMethod(exp, "getAvailableParallelism" as *u8, osGetCpus as *u8)
        c.setMethod(exp, "getPid" as *u8, osGetPid as *u8)
        c.setMethod(exp, "getPpid" as *u8, osGetPpid as *u8)
        c.setMethod(exp, "umask" as *u8, osUmask as *u8)
        c.setMethod(exp, "getCpuModel" as *u8, osGetCpuModel as *u8)
        c.setMethod(exp, "getFreeMem" as *u8, osGetFreemem as *u8)
        c.setMethod(exp, "getTotalMem" as *u8, osGetTotalmem as *u8)
        c.setMethod(exp, "getUptime" as *u8, osGetUptime as *u8)
        c.setMethod(exp, "getOsRelease" as *u8, osGetOsRelease as *u8)
        c.setMethod(exp, "getLoadAvg1" as *u8, osGetLoadavg1 as *u8)
        c.setMethod(exp, "getLoadAvg5" as *u8, osGetLoadavg5 as *u8)
        c.setMethod(exp, "getLoadAvg15" as *u8, osGetLoadavg15 as *u8)
        c.setMethod(exp, "setPriority" as *u8, osSetPriority as *u8)
        c.setMethod(exp, "getPriority" as *u8, osGetPriority as *u8)
        c.setMethod(exp, "getCpuSpeed" as *u8, osGetCpuSpeed as *u8)
        c.setMethod(exp, "getCpuTimes" as *u8, osGetCpuTimes as *u8)
        c.setMethod(exp, "getNetInterfaces" as *u8, osGetNetInterfaces as *u8)
        c.setMethod(exp, "getUid" as *u8, osGetUid as *u8)
        c.setMethod(exp, "getGid" as *u8, osGetGid as *u8)
        c.setMethod(exp, "getEuid" as *u8, osGetEuid as *u8)
        c.setMethod(exp, "getEgid" as *u8, osGetEgid as *u8)
        c.setMethod(exp, "setUid" as *u8, osSetUid as *u8)
        c.setMethod(exp, "setGid" as *u8, osSetGid as *u8)
        c.setMethod(exp, "setEuid" as *u8, osSetEuid as *u8)
        c.setMethod(exp, "setEgid" as *u8, osSetEgid as *u8)
        c.setMethod(exp, "resolveUser" as *u8, osResolveUser as *u8)
        c.setMethod(exp, "resolveGroup" as *u8, osResolveGroup as *u8)
        c.setMethod(exp, "getUserInfo" as *u8, osGetUserInfo as *u8)
        c.setMethod(exp, "getMachine" as *u8, osGetMachine as *u8)
        c.setMethod(exp, "getSysname" as *u8, osGetSysname as *u8)
    }
}

fn osGetUid(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    unsafe { ci.retU32(getuid()) }
}

fn osGetGid(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    unsafe { ci.retU32(getgid()) }
}

fn osGetEuid(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    unsafe { ci.retU32(geteuid()) }
}

fn osGetMachine(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    var buf: [u8; 64] = [0; 64]
    unsafe {
        if nm_uname_machine(buf as *u8, 64) == 0 {
            ci.retStr(buf as *u8)
        } else {
            ci.retStr("unknown" as *u8)
        }
    }
}

fn osGetSysname(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    var buf: [u8; 64] = [0; 64]
    unsafe {
        if nm_uname_sysname(buf as *u8, 64) == 0 {
            ci.retStr(buf as *u8)
        } else {
            ci.retStr("Darwin" as *u8)
        }
    }
}

fn osGetUserInfo(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    unsafe {
        let uid = getuid() as i32
        var buf: [u8; 1024] = [0; 1024]
        if nm_userinfo(uid, buf as *u8, 1024) == 0 {
            ci.retStr(buf as *u8)
        } else {
            ci.retStr("" as *u8)
        }
    }
}

fn osGetEgid(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    unsafe { ci.retU32(getegid()) }
}

fn osSetUid(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    let id = ci.i32Arg(0, -1)
    if id < 0 {
        ci.retI32(-1)
        return
    }
    unsafe { ci.retI32(setuid(id as u32)) }
}

fn osSetGid(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    let id = ci.i32Arg(0, -1)
    if id < 0 {
        ci.retI32(-1)
        return
    }
    unsafe { ci.retI32(setgid(id as u32)) }
}

fn osSetEuid(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    let id = ci.i32Arg(0, -1)
    if id < 0 {
        ci.retI32(-1)
        return
    }
    unsafe { ci.retI32(seteuid(id as u32)) }
}

fn osSetEgid(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    let id = ci.i32Arg(0, -1)
    if id < 0 {
        ci.retI32(-1)
        return
    }
    unsafe { ci.retI32(setegid(id as u32)) }
}

fn osResolveUser(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    let iso = ci.isolate()
    unsafe {
        var buf: [u8; 256] = [0; 256]
        ci.arg(0).writeUtf8(iso, buf as *u8, 256)
        ci.retI32(nm_resolve_user(buf as *u8))
    }
}

fn osResolveGroup(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    let iso = ci.isolate()
    unsafe {
        var buf: [u8; 256] = [0; 256]
        ci.arg(0).writeUtf8(iso, buf as *u8, 256)
        ci.retI32(nm_resolve_group(buf as *u8))
    }
}
