// zlib bindings — deflate/inflate via system zlib through C helpers

from "../v8/v8" import { CallbackInfo, Isolate, Context, Value }

// C helpers in entry.c
// windowBits: 15=deflate, 15+16=gzip, -15=raw deflate
extern fn nm_zlib_deflate(input: *u8, inputLen: i32, output: *u8, outputLen: i32, level: i32, windowBits: i32): i32
extern fn nm_zlib_inflate(input: *u8, inputLen: i32, output: *u8, outputLen: i32, windowBits: i32): i32
extern fn nm_zlib_stream_create(isDeflate: i32, level: i32, windowBits: i32, memLevel: i32, strategy: i32): *u8
extern fn nm_zlib_stream_write(handle: *u8, isDeflate: i32, input: *u8, inputLen: i32, output: *u8, outputLen: i32, flush: i32): i32
extern fn nm_zlib_stream_reset(handle: *u8, isDeflate: i32): i32
extern fn nm_zlib_stream_close(handle: *u8, isDeflate: i32): void
extern fn malloc(size: i64): *u8
extern fn realloc(ptr: *u8, size: i64): *u8
extern fn memcpy(dst: *u8, src: *u8, n: i64): *u8
extern fn free(ptr: *u8): void

// zlibOp(inputUint8Array, mode, level) → Uint8Array
// mode: 0=gzip, 1=gunzip, 2=deflate, 3=inflate, 4=deflateRaw, 5=inflateRaw
fn zlibOp(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    if ci.length() < 2 { return }
    let iso = ci.isolate()

    unsafe {
        let inputArr = ci.arg(0)
        let inputData = inputArr.typedArrayData(iso)
        let inputLen = inputArr.typedArrayByteLength(iso) as i32
        // A zero-length input has a null data pointer but is valid: gzip(Buffer.alloc(0)) = 20
        // bytes in node. Only null WITH bytes to read is a real failure.
        if inputLen > 0 && inputData as i64 == 0 { return }

        let mode = ci.i32Arg(1, 0)
        let level = ci.i32Arg(2, -1)

        var windowBits: i32 = 15
        var isCompress = true
        if mode == 0 { windowBits = 15 + 16 }
        if mode == 1 {
            windowBits = 15 + 32
            isCompress = false
        }
        if mode == 2 { windowBits = 15 }
        if mode == 3 {
            windowBits = 15 + 32
            isCompress = false
        }
        if mode == 4 { windowBits = 0 - 15 }
        if mode == 5 {
            windowBits = 0 - 15
            isCompress = false
        }

        if isCompress {
            // Output buffer: input size + 128 for headers (generous for small inputs)
            let outSize = inputLen + inputLen / 10 + 256
            let outBuf = malloc(outSize as i64)
            if outBuf as i64 == 0 { return }

            let written = nm_zlib_deflate(inputData, inputLen, outBuf, outSize, level, windowBits)
            if written < 0 {
                free(outBuf)
                return
            }

            let ab = iso.arraybufferNew(written as i64)
            let result = iso.uint8arrayNew(ab, 0, written as i64)
            let resultData = result.typedArrayData(iso)
            for i in 0..written as i64 {
                resultData[i] = outBuf[i]
            }
            free(outBuf)
            ci.ret(result)
        } else {
            // Decompress: output may be much larger — keep doubling until it fits
            var outSize: i32 = inputLen * 4 + 1024
            if outSize < 16384 { outSize = 16384 }
            var outBuf = malloc(outSize as i64)
            if outBuf as i64 == 0 { return }

            var written = nm_zlib_inflate(inputData, inputLen, outBuf, outSize, windowBits)
            var attempts = 0
            // -1 = failure (buffer too small), retry; < -1 = truncated (partial data), don't retry
            while written == -1 && attempts < 8 {
                free(outBuf)
                outSize = outSize * 4
                outBuf = malloc(outSize as i64)
                if outBuf as i64 == 0 { return }
                written = nm_zlib_inflate(inputData, inputLen, outBuf, outSize, windowBits)
                attempts = attempts + 1
            }
            if written == -1 {
                free(outBuf)
                return
            }

            // Decode: >= 0 means complete, < -1 means truncated (actual = -(written+1))
            var actualLen = written
            var truncated = false
            if written < -1 {
                actualLen = 0 - (written + 1)
                truncated = true
            }

            let ab = iso.arraybufferNew(actualLen as i64)
            let result = iso.uint8arrayNew(ab, 0, actualLen as i64)
            let resultData = result.typedArrayData(iso)
            for i in 0..actualLen as i64 {
                resultData[i] = outBuf[i]
            }
            free(outBuf)

            if truncated {
                let ctx = ci.context()
                let negOne = iso.number(0.0 - 1.0)
                ctx.objectSet(result, "truncated" as *u8, negOne)
            }

            ci.ret(result)
        }
    }
}

// streamCreate(isDeflate, level, windowBits, memLevel, strategy) → handle (as number/pointer)
fn zlibStreamCreate(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    if ci.length() < 3 { return }
    let iso = ci.isolate()
    let isDeflate = ci.i32Arg(0, 1)
    let level = ci.i32Arg(1, -1)
    let windowBits = ci.i32Arg(2, 15)
    let memLevel = ci.i32Arg(3, 8)
    let strategy = ci.i32Arg(4, 0)
    unsafe {
        let handle = nm_zlib_stream_create(isDeflate, level, windowBits, memLevel, strategy)
        if handle as i64 == 0 { return }
        // Return handle as a float64 (pointer fits in f64 mantissa on 48-bit address space)
        let val = iso.number(handle as i64 as f64)
        ci.ret(val)
    }
}

// streamWrite(handle, isDeflate, inputUint8Array, flush) → Uint8Array
fn zlibStreamWrite(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    if ci.length() < 4 { return }
    let iso = ci.isolate()
    unsafe {
        let handleVal = ci.i64Arg(0, 0)
        let handle = handleVal as *u8
        if handle as i64 == 0 { return }
        let isDeflate = ci.i32Arg(1, 1)
        let inputArr = ci.arg(2)
        let inputData = inputArr.typedArrayData(iso)
        let inputLen = inputArr.typedArrayByteLength(iso) as i32
        let flush = ci.i32Arg(3, 0)

        // Scratch buffer big enough for the real-input call (deflate output <= ~2x input).
        // Any OVERFLOW happens on Z_FINISH, where all input is already consumed and only
        // pending output remains — so after the first call we drain with EMPTY input until
        // the buffer stops coming back full. The old code did ONE call into ONE buffer and
        // silently dropped everything past it, capping every stream chunk at 16384 and
        // truncating any gzip response over 16KB (the app's compression middleware).
        var outSize: i64 = (inputLen as i64) * 2 + 256
        if outSize < 65536 { outSize = 65536 }
        let scratch = malloc(outSize)
        if scratch as i64 == 0 { return }

        var accum = malloc(0 as i64)
        var accumLen: i64 = 0
        var first = true
        var failed = false
        var draining = true
        while draining {
            var inPtr = inputData
            var inLen = inputLen
            if !first { inPtr = scratch; inLen = 0 }   // drain-only: no new input
            let written = nm_zlib_stream_write(handle, isDeflate, inPtr, inLen, scratch, outSize as i32, flush)
            first = false
            if written < 0 { failed = true; draining = false }
            else {
                if written > 0 {
                    accum = realloc(accum, accumLen + written as i64)
                    memcpy((accum as i64 + accumLen) as *u8, scratch, written as i64)
                    accumLen = accumLen + written as i64
                }
                // buffer not full => zlib had room left => all output drained.
                if (written as i64) < outSize { draining = false }
            }
        }
        free(scratch)
        if failed { free(accum); return }

        let ab = iso.arraybufferNew(accumLen)
        let result = iso.uint8arrayNew(ab, 0, accumLen)
        let resultData = result.typedArrayData(iso)
        var j: i64 = 0
        while j < accumLen { resultData[j] = accum[j]; j = j + 1 }
        free(accum)
        ci.ret(result)
    }
}

// streamReset(handle, isDeflate) → 0 on success
fn zlibStreamReset(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    if ci.length() < 2 { return }
    let iso = ci.isolate()
    unsafe {
        let handleVal = ci.i64Arg(0, 0)
        let handle = handleVal as *u8
        let isDeflate = ci.i32Arg(1, 1)
        let ret = nm_zlib_stream_reset(handle, isDeflate)
        ci.ret(iso.number(ret as f64))
    }
}

// streamClose(handle, isDeflate)
fn zlibStreamClose(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    if ci.length() < 2 { return }
    unsafe {
        let handleVal = ci.i64Arg(0, 0)
        let handle = handleVal as *u8
        let isDeflate = ci.i32Arg(1, 1)
        nm_zlib_stream_close(handle, isDeflate)
    }
}

fn nm_init_zlib(_iso: *u8, ctxPtr: *u8, exports: i32): void {
    let ctx = Context { ptr: ctxPtr }
    let exp = Value { slot: exports }
    unsafe {
        ctx.setMethod(exp, "zlibOp" as *u8, zlibOp as *u8)
        ctx.setMethod(exp, "streamCreate" as *u8, zlibStreamCreate as *u8)
        ctx.setMethod(exp, "streamWrite" as *u8, zlibStreamWrite as *u8)
        ctx.setMethod(exp, "streamReset" as *u8, zlibStreamReset as *u8)
        ctx.setMethod(exp, "streamClose" as *u8, zlibStreamClose as *u8)
    }
}
