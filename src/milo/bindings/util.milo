// util binding — V8 introspection APIs needed by lib/internal/util/inspect.js and lib/internal/errors.js

from "../v8/v8" import { CallbackInfo, Isolate, Context, Value }

extern fn v8c_isolate_get_continuation_data(iso: *u8): i32
extern fn v8c_isolate_set_continuation_data(iso: *u8, v: i32): void

// AsyncLocalStorage substrate: read/write V8's continuation-preserved embedder
// data, which V8 propagates across await/promise continuations.
fn asyncContextGet(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    let iso = ci.isolate()
    var slot: i32 = -1
    unsafe { slot = v8c_isolate_get_continuation_data(iso.ptr) }
    if slot < 0 {
        ci.retUndefined()
    } else {
        ci.ret(Value { slot: slot })
    }
}

fn asyncContextSet(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    let iso = ci.isolate()
    var slot: i32 = -1
    if ci.length() > 0 {
        slot = ci.arg(0).slot
    }
    unsafe { v8c_isolate_set_continuation_data(iso.ptr, slot) }
}

fn utilGetOwnNonIndexProperties(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    if ci.length() < 2 { return }
    let iso = ci.isolate()
    let ctx = ci.context()
    let obj = ci.arg(0)
    if obj.isObject(iso) == 0 {
        ci.ret(iso.array(0))
        return
    }
    var filter: i32 = 0
    ci.ret(ctx.getPropertyNames(obj, filter))
}

fn utilGetConstructorName(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    unsafe {
        if ci.length() < 1 {
            ci.retStr("" as *u8)
            return
        }
        let iso = ci.isolate()
        if ci.arg(0).isObject(iso) == 0 {
            ci.retStr("" as *u8)
            return
        }
        ci.retStr("Object" as *u8)
    }
}

fn utilGetPromiseDetails(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    ci.retUndefined()
}

fn utilGetProxyDetails(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    ci.retUndefined()
}

fn utilPreviewEntries(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    let iso = ci.isolate()
    let ctx = ci.context()
    let result = iso.array(2)
    ctx.objectSetIndex(result, 0, iso.array(0))
    ctx.objectSetIndex(result, 1, iso.falseVal())
    ci.ret(result)
}

fn utilGetExternalValue(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    ci.ret(ci.isolate().bigintI64(0))
}

fn utilIsInsideNodeModules(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    ci.retBool(0)
}

fn utilGetCallerLocation(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    ci.retUndefined()
}

fn utilSleep(_info: *u8, _ud: *u8): void {}

fn nm_init_util(iso: *u8, ctx: *u8, exports: i32): void {
    let i = Isolate { ptr: iso }
    let c = Context { ptr: ctx }
    let exp = Value { slot: exports }
    unsafe {
        let consts = i.object()
        c.objectSet(consts, "ALL_PROPERTIES" as *u8, i.int32(0))
        c.objectSet(consts, "ONLY_ENUMERABLE" as *u8, i.int32(2))
        c.objectSet(consts, "kPending" as *u8, i.int32(0))
        c.objectSet(consts, "kFulfilled" as *u8, i.int32(1))
        c.objectSet(consts, "kRejected" as *u8, i.int32(2))
        c.objectSet(exp, "constants" as *u8, consts)

        let privSyms = i.object()
        c.objectSet(privSyms, "arrow_message_private_symbol" as *u8,
            i.symbolNew("node:arrowMessage" as *u8))
        c.objectSet(privSyms, "decorated_private_symbol" as *u8,
            i.symbolNew("node:decorated" as *u8))
        c.objectSet(privSyms, "transfer_mode_private_symbol" as *u8,
            i.symbolNew("node:transfer_mode" as *u8))
        c.objectSet(privSyms, "untransferable_object_private_symbol" as *u8,
            i.symbolNew("node:untransferable" as *u8))
        c.objectSet(exp, "privateSymbols" as *u8, privSyms)

        c.setMethod(exp, "getOwnNonIndexProperties" as *u8, utilGetOwnNonIndexProperties as *u8)
        c.setMethod(exp, "getConstructorName" as *u8, utilGetConstructorName as *u8)
        c.setMethod(exp, "getPromiseDetails" as *u8, utilGetPromiseDetails as *u8)
        c.setMethod(exp, "getProxyDetails" as *u8, utilGetProxyDetails as *u8)
        c.setMethod(exp, "previewEntries" as *u8, utilPreviewEntries as *u8)
        c.setMethod(exp, "getExternalValue" as *u8, utilGetExternalValue as *u8)
        c.setMethod(exp, "isInsideNodeModules" as *u8, utilIsInsideNodeModules as *u8)
        c.setMethod(exp, "getCallerLocation" as *u8, utilGetCallerLocation as *u8)
        c.setMethod(exp, "sleep" as *u8, utilSleep as *u8)
        c.setMethod(exp, "asyncContextGet" as *u8, asyncContextGet as *u8)
        c.setMethod(exp, "asyncContextSet" as *u8, asyncContextSet as *u8)
    }
}
