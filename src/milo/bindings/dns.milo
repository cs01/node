// dns bindings — hostname resolution via getaddrinfo (C helper)

from "../v8/v8" import { CallbackInfo, Isolate, Context, Value }

extern fn nm_dns_lookup(hostname: *u8, family: i32, outIp: *u8, outLen: i32, outFamily: *i32): i32
extern fn strlen(s: *u8): i64

// lookup(hostname, family) → { address, family } or null
fn dnsLookup(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    if ci.length() < 1 { return }
    let iso = ci.isolate()
    let ctx = ci.context()
    unsafe {
        var hostBuf: [u8; 256] = [0; 256]
        let hlen = ci.arg(0).writeUtf8(iso, hostBuf as *u8, 256)
        if hlen <= 0 { return }

        let family = ci.i32Arg(1, 0)

        var ipBuf: [u8; 64] = [0; 64]
        var outFamily: [i32; 1] = [4]
        let r = nm_dns_lookup(hostBuf as *u8, family, ipBuf as *u8, 64, outFamily as *i32)

        if r != 0 {
            ci.retI32(-1)
            return
        }

        let result = iso.object()
        let ipLen = strlen(ipBuf as *u8)
        ctx.objectSet(result, "address" as *u8, iso.stringLen(ipBuf as *u8, ipLen as i32))
        ctx.objectSet(result, "family" as *u8, iso.int32(outFamily[0]))
        ci.ret(result)
    }
}

fn nm_init_dns(_iso: *u8, ctxPtr: *u8, exports: i32): void {
    let ctx = Context { ptr: ctxPtr }
    let exp = Value { slot: exports }
    unsafe {
        ctx.setMethod(exp, "lookup" as *u8, dnsLookup as *u8)
    }
}
