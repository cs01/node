// tcp binding — POSIX sockets + kqueue I/O polling

from "../v8/v8" import { CallbackInfo, Isolate, Context, Value }

// POSIX socket API
extern fn socket(domain: i32, socktype: i32, protocol: i32): i32
extern fn bind(fd: i32, addr: *u8, addrlen: i32): i32
extern fn listen(fd: i32, backlog: i32): i32
extern fn accept(fd: i32, addr: *u8, addrlen: *i32): i32
extern fn connect(fd: i32, addr: *u8, addrlen: i32): i32
extern fn close(fd: i32): i32
extern fn setsockopt(fd: i32, level: i32, optname: i32, optval: *u8, optlen: i32): i32
extern fn getsockopt(fd: i32, level: i32, optname: i32, optval: *u8, optlen: *u8): i32
// fcntl is VARIADIC — calling it with a fixed 3-arity extern puts arg 3 in a register
// while the ARM64 variadic ABI reads it off the stack, so F_SETFL wrote garbage and
// O_NONBLOCK never landed. Both of these go through C wrappers instead.
extern fn nm_set_nonblock(fd: i32): i32
extern fn nm_write(fd: i32, buf: *u8, len: i64): i64
extern fn strlen(s: *u8): i64
extern fn memset(s: *u8, c: i32, n: i64): *u8
extern fn calloc(count: i64, size: i64): *u8
extern fn free(ptr: *u8): void
extern fn memcpy(dst: *u8, src: *u8, len: i64): *u8

// read/write for connected sockets
extern fn read(fd: i32, buf: *u8, len: i64): i64
extern fn write(fd: i32, buf: *u8, len: i64): i64
extern fn nm_set_cloexec(fd: i32): i32
extern fn sendto(fd: i32, buf: *u8, len: i64, flags: i32, addr: *u8, addrlen: i32): i64
extern fn recvfrom(fd: i32, buf: *u8, len: i64, flags: i32, addr: *u8, addrlen: *i32): i64

// kqueue
extern fn kqueue(): i32
// Cross-thread loop wakeup (EVFILT_USER). C-side because kevent() must be callable from any
// thread; it is the uv_async_send equivalent and what napi_threadsafe_function needs.
extern fn nm_kq_wake_register(kq: i32): i32
extern fn nm_kq_wake(kq: i32): i32
extern fn nm_kq_set_main(kq: i32): void
extern fn kevent(kq: i32, changelist: *u8, nchanges: i32, eventlist: *u8, nevents: i32, timeout: *u8): i32

// inet_pton / inet_ntop / getsockname
extern fn inet_pton(af: i32, src: *u8, dst: *u8): i32
extern fn inet_ntop(af: i32, src: *u8, dst: *u8, size: i32): *u8
// <net/if.h> — link-local v6 addresses carry a zone ("fe80::1%lo0"); these map the zone
// name to the sin6_scope_id the kernel wants, and back for reporting.
extern fn if_nametoindex(name: *u8): u32
extern fn if_indextoname(idx: u32, buf: *u8): *u8
extern fn getsockname(fd: i32, addr: *u8, addrlen: *i32): i32
extern fn getpeername(fd: i32, addr: *u8, addrlen: *i32): i32
extern fn shutdown(fd: i32, how: i32): i32
extern fn nm_fs_open(path: *u8, flags: i32, mode: i32): i32

// TLS via OpenSSL (helpers in entry.c)
extern fn nm_ssl_connect(fd: i32, hostname: *u8): i64
extern fn nm_ssl_connect_start(fd: i32, hostname: *u8, caPem: *u8, verifyHost: *u8, minVer: *u8, maxVer: *u8, ciphers: *u8, cipherSuites: *u8, certPem: *u8, keyPem: *u8): i64
extern fn nm_ssl_connect_continue(ssl: i64): i32
extern fn nm_ssl_verify_result(ssl: i64): i64
extern fn nm_ssl_peer_cert_json(ssl: i64): *u8
extern fn nm_ssl_cipher_info(ssl: i64): *u8
extern fn nm_ssl_protocol(ssl: i64): *u8
extern fn nm_ssl_read(ssl: i64, buf: *u8, len: i32): i32
extern fn nm_ssl_write(ssl: i64, data: *u8, len: i32): i32
extern fn nm_ssl_pending(ssl: i64): i32
extern fn nm_ssl_shutdown(ssl: i64): void
extern fn nm_ssl_server_ctx_new(cert: *u8, certLen: i32, key: *u8, keyLen: i32, minVer: *u8, maxVer: *u8, ciphers: *u8, cipherSuites: *u8, caPem: *u8, requestCert: i32, rejectUnauth: i32): i64
extern fn nm_ssl_accept(ctx: i64, fd: i32): i64
extern fn nm_ssl_accept_new(ctx: i64, fd: i32): i64
extern fn nm_ssl_accept_continue(ssl: i64): i32
extern fn nm_ssl_ctx_free(ctx: i64): void

// macOS constants
// AF_INET=2, SOCK_STREAM=1, SOL_SOCKET=0xffff, SO_REUSEADDR=4
// F_SETFL=4, F_GETFL=3, O_NONBLOCK=4
// EVFILT_READ=-1(0xffff as i16), EVFILT_WRITE=-2
// EV_ADD=1, EV_DELETE=2, EV_ENABLE=4, EV_ONESHOT=0x10, EV_EOF=0x8000

// htons for little-endian (arm64)
fn htons(val: i32): i32 {
    return ((val & 0xff) << 8) | ((val >> 8) & 0xff)
}

// ── address families ───────────────────────────────────────────────────────────
// AF_INET6 is 30 on macOS and 10 on Linux — one of the few socket constants that
// actually differs. This whole binding is macOS-only already (kqueue/EVFILT above),
// so 30 is correct here; a Linux port changes this line, not the call sites.
// Verified against <sys/socket.h> on both: sockaddr_in6 is 28 bytes on each, with the
// address at offset 8 and scope_id at 24, so only the family number moves.
let AF_INET: i32 = 2
let AF_INET6: i32 = 30
let IPPROTO_IPV6: i32 = 41
let IPV6_V6ONLY: i32 = 27   // macOS; Linux uses 26
let SOCKADDR_IN_LEN: i64 = 16
let SOCKADDR_IN6_LEN: i64 = 28

// A ':' anywhere means an IPv6 literal — no v4 address or hostname contains one, and
// the port is a separate argument here, so there is no "host:port" ambiguity.
fn hostIsV6(host: *u8): bool {
    unsafe {
        var i: i64 = 0
        while i < 256 {
            let c = (host as i64 + i) as *u8
            let b = *c
            if b == 0 {
                return false
            }
            if b == 58 {   // ':'
                return true
            }
            i = i + 1
        }
    }
    return false
}

fn hostIsEmpty(host: *u8): bool {
    unsafe {
        return *host == 0
    }
}

// Fill `addr` with a sockaddr_in (16B) or sockaddr_in6 (28B) for host:port and return its
// length, or -1 if the literal does not parse for that family.
//
// Returning -1 is the point. inet_pton's result used to be discarded, so
// inet_pton(AF_INET, "::1") failed, left the address zeroed, and the caller bound
// 0.0.0.0 — which still reaches localhost, so a v6 request quietly became a v4 one and
// address() then reported IPv4. A wrong address that works by accident is why this hid
// for so long; now it fails where the mistake is.
//
// An empty host means "any": 0.0.0.0 for v4, :: for v6 — both already all-zero.
fn buildSockAddr(host: *u8, port: i32, addr: *u8, family: i32): i64 {
    let port_n = htons(port)
    unsafe {
        if family == AF_INET6 {
            *((addr as i64 + 0) as *u8) = 28 as u8       // sin6_len
            *((addr as i64 + 1) as *u8) = AF_INET6 as u8 // sin6_family
            *((addr as i64 + 2) as *u8) = (port_n & 0xff) as u8
            *((addr as i64 + 3) as *u8) = ((port_n >> 8) & 0xff) as u8
            // flowinfo (4..8) stays 0; addr at 8; scope_id (24..28) stays 0
            if hostIsEmpty(host) {
                return SOCKADDR_IN6_LEN   // :: — in6addr_any, already zeroed
            }
            var addrPart: [u8; 256] = [0; 256]
            var zonePart: [u8; 64] = [0; 64]
            let hasZone = splitZone(host, addrPart as *u8, zonePart as *u8)
            if inet_pton(AF_INET6, addrPart as *u8, (addr as i64 + 8) as *u8) != 1 {
                return -1
            }
            if hasZone {
                let idx = if_nametoindex(zonePart as *u8)
                if idx == 0 as u32 {
                    return -1   // named an interface that does not exist
                }
                setSockAddrScopeId(addr, idx)
            }
            return SOCKADDR_IN6_LEN
        }
        *((addr as i64 + 0) as *u8) = 16 as u8
        *((addr as i64 + 1) as *u8) = AF_INET as u8
        *((addr as i64 + 2) as *u8) = (port_n & 0xff) as u8
        *((addr as i64 + 3) as *u8) = ((port_n >> 8) & 0xff) as u8
        if hostIsEmpty(host) {
            return SOCKADDR_IN_LEN       // 0.0.0.0 — INADDR_ANY, already zeroed
        }
        if inet_pton(AF_INET, host, (addr as i64 + 4) as *u8) != 1 {
            return -1
        }
        return SOCKADDR_IN_LEN
    }
}

// sin6_scope_id: 4 bytes at offset 24, host byte order (unlike the port, which is network
// order). Zero means "no zone", which is every address except a link-local one.
fn sockAddrScopeId(addr: *u8): u32 {
    unsafe {
        var v: u32 = 0
        var i: i64 = 0
        while i < 4 {
            let b = (*((addr as i64 + 24 + i) as *u8)) as u32
            v = v | (b << ((i * 8) as u32))
            i = i + 1
        }
        return v
    }
}

fn setSockAddrScopeId(addr: *u8, scope: u32): void {
    unsafe {
        var i: i64 = 0
        while i < 4 {
            *((addr as i64 + 24 + i) as *u8) = ((scope >> ((i * 8) as u32)) & 0xff) as u8
            i = i + 1
        }
    }
}

// Split "fe80::1%lo0" at the '%'. Writes the address part into `addrOut` and the zone into
// `zoneOut`; returns true if a zone was present.
//
// inet_pton on macOS actually ACCEPTS the %zone suffix and returns 1 — but it only writes
// the 16 address bytes and silently drops the zone, so the scope_id stays 0 and the
// address comes back as a bare "fe80::1". A link-local address without its zone is not
// routable, so the zone has to be carried separately.
fn splitZone(host: *u8, addrOut: *u8, zoneOut: *u8): bool {
    unsafe {
        var i: i64 = 0
        var pct: i64 = -1
        while i < 255 {
            let b = *((host as i64 + i) as *u8)
            if b == 0 {
                break
            }
            if b == 37 && pct < 0 {   // '%'
                pct = i
            }
            i = i + 1
        }
        let total = i
        let addrLen = if pct < 0 { total } else { pct }
        var j: i64 = 0
        while j < addrLen {
            *((addrOut as i64 + j) as *u8) = *((host as i64 + j) as *u8)
            j = j + 1
        }
        *((addrOut as i64 + addrLen) as *u8) = 0 as u8
        if pct < 0 {
            *(zoneOut) = 0 as u8
            return false
        }
        var k: i64 = 0
        while pct + 1 + k < total {
            *((zoneOut as i64 + k) as *u8) = *((host as i64 + pct + 1 + k) as *u8)
            k = k + 1
        }
        *((zoneOut as i64 + k) as *u8) = 0 as u8
        return true
    }
}

// Read the family byte a kernel wrote into a sockaddr. accept/getsockname/getpeername all
// fill this in, so the reply can report what the socket actually is instead of asserting
// IPv4 and being wrong half the time.
fn sockAddrFamily(addr: *u8): i32 {
    unsafe {
        return (*((addr as i64 + 1) as *u8)) as i32
    }
}

// Port is at offset 2 in both layouts, network byte order.
fn sockAddrPort(addr: *u8): i32 {
    unsafe {
        let hi = (*((addr as i64 + 2) as *u8)) as i32
        let lo = (*((addr as i64 + 3) as *u8)) as i32
        return (hi << 8) | lo
    }
}

// Format the address text out of a kernel-filled sockaddr, v4 at +4 and v6 at +8.
fn sockAddrText(addr: *u8, out: *u8, outLen: i32): bool {
    let fam = sockAddrFamily(addr)
    unsafe {
        if fam == AF_INET6 {
            if (inet_ntop(AF_INET6, (addr as i64 + 8) as *u8, out, outLen) as i64) == 0 {
                return false
            }
            // inet_ntop never emits the zone, so a link-local address would read back as a
            // bare "fe80::1" — which is what node reports as "fe80::1%lo0".
            let scope = sockAddrScopeId(addr)
            if scope != 0 as u32 {
                var nameBuf: [u8; 64] = [0; 64]
                if (if_indextoname(scope, nameBuf as *u8) as i64) != 0 {
                    var n: i64 = 0
                    while n < outLen as i64 {
                        if *((out as i64 + n) as *u8) == 0 {
                            break
                        }
                        n = n + 1
                    }
                    *((out as i64 + n) as *u8) = 37 as u8   // '%'
                    var m: i64 = 0
                    while m < 63 {
                        let b = *((nameBuf as *u8 as i64 + m) as *u8)
                        if b == 0 {
                            break
                        }
                        *((out as i64 + n + 1 + m) as *u8) = b
                        m = m + 1
                    }
                    *((out as i64 + n + 1 + m) as *u8) = 0 as u8
                }
            }
            return true
        }
        return (inet_ntop(AF_INET, (addr as i64 + 4) as *u8, out, outLen) as i64) != 0
    }
}

// thread_local: each isolate/thread polls its own kqueue (worker threads must not
// share the main thread's event-loop fd).
thread_local var kq_fd: i32 = -1

// --- kevent struct layout (macOS arm64, 32 bytes) ---
// offset 0:  ident  (i64) — fd
// offset 8:  filter (i16)
// offset 10: flags  (u16)
// offset 12: fflags (u32)
// offset 16: data   (i64)
// offset 24: udata  (i64/ptr)

fn kevent_set(buf: *u8, ident: i64, filter: i32, flags: i32): void {
    unsafe {
        let p = buf
        // ident (8 bytes)
        (p as *i64)[0] = ident
        // filter (2 bytes at offset 8)
        let fp = (p as i64 + 8) as *u8
        fp[0] = (filter & 0xff) as u8
        fp[1] = ((filter >> 8) & 0xff) as u8
        // flags (2 bytes at offset 10)
        let flp = (p as i64 + 10) as *u8
        flp[0] = (flags & 0xff) as u8
        flp[1] = ((flags >> 8) & 0xff) as u8
        // fflags, data, udata = 0
        (p as i64 + 12) as *i32
        let ffp = (p as i64 + 12) as *i32
        ffp[0] = 0
        let dp = (p as i64 + 16) as *i64
        dp[0] = 0
        let up = (p as i64 + 24) as *i64
        up[0] = 0
    }
}

fn kevent_set_vnode(buf: *u8, ident: i64, flags: i32, fflags: i32): void {
    unsafe {
        (buf as *i64)[0] = ident
        // filter = EVFILT_VNODE = -4
        let fp = (buf as i64 + 8) as *u8
        fp[0] = 0xfc as u8
        fp[1] = 0xff as u8
        // flags
        let flp = (buf as i64 + 10) as *u8
        flp[0] = (flags & 0xff) as u8
        flp[1] = ((flags >> 8) & 0xff) as u8
        // fflags (NOTE_* flags)
        let ffp = (buf as i64 + 12) as *i32
        ffp[0] = fflags
        // data, udata = 0
        let dp = (buf as i64 + 16) as *i64
        dp[0] = 0
        let up = (buf as i64 + 24) as *i64
        up[0] = 0
    }
}

fn kevent_get_fflags(buf: *u8): i32 {
    unsafe {
        let ffp = (buf as i64 + 12) as *i32
        return ffp[0]
    }
}

// kevent.data (offset 16, intptr_t). For a failed non-blocking connect macOS
// sets EV_EOF on the WRITE event and stores the connect errno here.
fn kevent_get_data(buf: *u8): i64 {
    unsafe {
        let dp = (buf as i64 + 16) as *i64
        return dp[0]
    }
}

fn kevent_get_ident(buf: *u8): i64 {
    unsafe { return (buf as *i64)[0] }
}

fn kevent_get_filter(buf: *u8): i32 {
    unsafe {
        let fp = (buf as i64 + 8) as *u8
        let lo = fp[0] as i32
        let hi = fp[1] as i32
        let val = lo | (hi << 8)
        // sign extend from 16 bits
        if val > 32767 { return val - 65536 }
        return val
    }
}

fn kevent_get_flags(buf: *u8): i32 {
    unsafe {
        let fp = (buf as i64 + 10) as *u8
        return fp[0] as i32 | ((fp[1] as i32) << 8)
    }
}

// tcpSocket(family?) -> fd. family defaults to AF_INET so existing v4 callers are
// unchanged; pass AF_INET6 (30) for a v6 or dual-stack socket.
fn tcpSocket(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    unsafe {
        let family = ci.i32Arg(0, AF_INET)
        let fd = socket(family, 1, 0)
        if fd >= 0 && family == AF_INET6 {
            // Dual-stack: a :: listener answers v4 clients as v4-mapped, which is what
            // makes Node's listen(0) + connect('127.0.0.1') work. Set explicitly rather
            // than inherit the platform default (macOS and Linux disagree, and the sysctl
            // is tunable). The kernel does the v4-mapping on accept — nothing here has to
            // build ::ffff: addresses, which matters because inet_pton(AF_INET6,
            // "127.0.0.1") returns 0 and would not produce one anyway.
            var v6only: [i32; 1] = [0]
            setsockopt(fd, IPPROTO_IPV6, IPV6_V6ONLY, v6only as *u8, 4)
        }
        if fd < 0 {
            ci.retI32(-1)
            return
        }
        // SO_REUSEADDR
        var one: i32 = 1
        let one_ptr = one.addrOf()
        setsockopt(fd, 0xffff, 4, one_ptr as *u8, 4)
        // non-blocking
        nm_set_nonblock(fd)
        // FD_CLOEXEC via a C wrapper (variadic fcntl can't be called directly on
        // ARM64): the socket must close on execve so a replaced process image can
        // rebind the port (Node default).
        nm_set_cloexec(fd)
        ci.retI32(fd)
    }
}

// tcpBind(fd, host_str, port) -> 0 on success
fn tcpBind(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    let fd = ci.i32Arg(0, -1)
    let port = ci.i32Arg(2, 0)
    let iso = ci.isolate()

    unsafe {
        var host_buf: [u8; 256] = [0; 256]
        let host_arg = ci.arg(1)
        host_arg.writeUtf8(iso, host_buf as *u8, 256)

        // 28 bytes: big enough for either sockaddr_in (16) or sockaddr_in6 (28).
        var addr: [u8; 28] = [0; 28]
        var family = AF_INET
        if hostIsV6(host_buf as *u8) {
            family = AF_INET6
        }
        let alen = buildSockAddr(host_buf as *u8, port, addr as *u8, family)
        if alen < 0 {
            // The literal did not parse for its family. This used to be silent: the
            // failed inet_pton left the address zeroed, so a v6 bind became 0.0.0.0 and
            // reached localhost anyway. -1 instead of a wrong address that works.
            ci.retI32(-1)
            return
        }
        let r = bind(fd, addr as *u8, alen as i32)
        ci.retI32(r)
    }
}

// tcpListen(fd, backlog) -> 0 on success
fn tcpListen(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    let fd = ci.i32Arg(0, -1)
    let backlog = ci.i32Arg(1, 128)
     ci.retI32(listen(fd, backlog)) 
}

// tcpAccept(fd) -> new_fd or -1
fn tcpAccept(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    let fd = ci.i32Arg(0, -1)
    unsafe {
        // 28B: a v6 peer's sockaddr does not fit in 16 and would be truncated.
        var addr: [u8; 28] = [0; 28]
        var addrlen: i32 = 28
        let new_fd = accept(fd, addr as *u8, addrlen.addrOf())
        if new_fd >= 0 {
            // make non-blocking; accepted fds do NOT inherit O_NONBLOCK from the listener
            nm_set_nonblock(new_fd)
            // accepted fds were also missing FD_CLOEXEC (only the listener got it)
            nm_set_cloexec(new_fd)
        }
        ci.retI32(new_fd)
    }
}

// tcpConnect(fd, host, port) -> 0 or errno
fn tcpConnect(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    let fd = ci.i32Arg(0, -1)
    let port = ci.i32Arg(2, 0)
    let iso = ci.isolate()

    unsafe {
        var host_buf: [u8; 256] = [0; 256]
        let host_arg = ci.arg(1)
        host_arg.writeUtf8(iso, host_buf as *u8, 256)

        // Family comes from the host, exactly as tcpBind does. This fn only gets
        // (fd, host, port), and the alternative — asking the fd via getsockopt(SO_DOMAIN)
        // — is Linux-only, so there is nothing to read it off on macOS. net.js computes
        // the same thing for tcp.socket(), so the two agree by construction.
        var addr: [u8; 28] = [0; 28]
        var family = AF_INET
        if hostIsV6(host_buf as *u8) {
            family = AF_INET6
        }
        let alen = buildSockAddr(host_buf as *u8, port, addr as *u8, family)
        if alen < 0 {
            // Same silent failure as bind had: inet_pton's result was discarded, so
            // connect('::1') went to 0.0.0.0 — which reaches localhost, so it appeared to
            // work. That accident is exactly why the v4-only stack went unnoticed.
            ci.retI32(-1)
            return
        }
        let r = connect(fd, addr as *u8, alen as i32)
        ci.retI32(r)
    }
}

// tcpSend(fd, string) -> bytes written or -1
fn tcpSend(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    let fd = ci.i32Arg(0, -1)
    let iso = ci.isolate()
    unsafe {
        let buf = calloc(1, 65536)
        let arg = ci.arg(1)
        var len = arg.writeUtf8(iso, buf, 65536)
        // strip null terminator from writeUtf8 count
        if len > 0 {
            let last = (buf as i64 + (len - 1) as i64) as *u8
            if last[0] == 0 { len = len - 1 }
        }
        if len <= 0 {
            free(buf)
            ci.retI32(0)
            return
        }
        let n = write(fd, buf, len as i64)
        free(buf)
        ci.retI32(n as i32)
    }
}

// tcpSendBinary(fd, uint8Array) -> bytes written — raw binary, no UTF-8 conversion
fn tcpSendBinary(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    let fd = ci.i32Arg(0, -1)
    let iso = ci.isolate()
    let arr = ci.arg(1)
    let dataPtr = arr.typedArrayData(iso)
    let dataLen = arr.typedArrayByteLength(iso)
    if dataLen <= 0 {
        ci.retI32(0)
        return
    }
    // nm_write captures errno in the syscall's own frame and returns -errno, so the JS
    // layer can tell EAGAIN (-35 = kernel sndbuf full -> backpressure, retry on
    // EVFILT_WRITE) apart from a genuine error. Reading errno back across the FFI seam
    // instead would race (see nm_fs_open).
    let n = nm_write(fd, dataPtr, dataLen)
    ci.retI32(n as i32)
}

// tcpRecv(fd) -> string or empty string if EAGAIN, or undefined if closed
fn tcpRecv(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    let fd = ci.i32Arg(0, -1)
    unsafe {
        let buf = calloc(1, 65536)
        let n = read(fd, buf, 65535)
        if n > 0 {
            ci.retStrLen(buf, n as i32)
        } else if n == 0 {
            ci.retUndefined()
        } else {
            ci.retStr("" as *u8)
        }
        free(buf)
    }
}

// tcpRecvBinary(fd) -> Uint8Array or empty Uint8Array if EAGAIN, or undefined if closed
fn tcpRecvBinary(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    let fd = ci.i32Arg(0, -1)
    let iso = ci.isolate()
    unsafe {
        let buf = calloc(1, 65536)
        let n = read(fd, buf, 65535)
        if n > 0 {
            let ab = iso.arraybufferNew(n)
            let result = iso.uint8arrayNew(ab, 0, n)
            let resultPtr = result.typedArrayData(iso)
            memcpy(resultPtr, buf, n)
            free(buf)
            ci.ret(result)
        } else if n == 0 {
            free(buf)
            ci.retUndefined()
        } else {
            free(buf)
            let ab = iso.arraybufferNew(0)
            let result = iso.uint8arrayNew(ab, 0, 0)
            ci.ret(result)
        }
    }
}

// tcpShutdown(fd, how) — SHUT_RD=0, SHUT_WR=1, SHUT_RDWR=2
fn tcpShutdown(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    let fd = ci.i32Arg(0, -1)
    let how = ci.i32Arg(1, 1)
     shutdown(fd, how) 
}

// tcpClose(fd)
fn tcpClose(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    let fd = ci.i32Arg(0, -1)
     close(fd) 
}

// tcpGetSockName(fd) -> {port, address}
fn tcpGetSockName(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    let fd = ci.i32Arg(0, -1)
    let iso = ci.isolate()
    let ctx = ci.context()

    unsafe {
        // 28B so a v6 socket's address is not truncated into a v4-shaped answer.
        var addr: [u8; 28] = [0; 28]
        var addrlen: i32 = 28
        let r = getsockname(fd, addr as *u8, addrlen.addrOf())
        if r != 0 {
            ci.retUndefined()
            return
        }
        let obj = iso.object()
        ctx.objectSet(obj, "port" as *u8, iso.int32(sockAddrPort(addr as *u8)))

        var ip_buf: [u8; 64] = [0; 64]
        sockAddrText(addr as *u8, ip_buf as *u8, 64)
        ctx.objectSet(obj, "address" as *u8, iso.string(ip_buf as *u8))
        // Report what the socket actually is. This said "IPv4" unconditionally, so a v6
        // socket reported IPv4 — and address().family is asserted all over the suite.
        if sockAddrFamily(addr as *u8) == AF_INET6 {
            ctx.objectSet(obj, "family" as *u8, iso.string("IPv6" as *u8))
        } else {
            ctx.objectSet(obj, "family" as *u8, iso.string("IPv4" as *u8))
        }
        ci.ret(obj)
    }
}

fn tcpGetPeerName(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    let fd = ci.i32Arg(0, -1)
    let iso = ci.isolate()
    let ctx = ci.context()

    unsafe {
        var addr: [u8; 28] = [0; 28]
        var addrlen: i32 = 28
        let r = getpeername(fd, addr as *u8, addrlen.addrOf())
        if r != 0 {
            ci.retUndefined()
            return
        }
        let obj = iso.object()
        ctx.objectSet(obj, "port" as *u8, iso.int32(sockAddrPort(addr as *u8)))

        var ip_buf: [u8; 64] = [0; 64]
        sockAddrText(addr as *u8, ip_buf as *u8, 64)
        ctx.objectSet(obj, "address" as *u8, iso.string(ip_buf as *u8))
        if sockAddrFamily(addr as *u8) == AF_INET6 {
            ctx.objectSet(obj, "family" as *u8, iso.string("IPv6" as *u8))
        } else {
            ctx.objectSet(obj, "family" as *u8, iso.string("IPv4" as *u8))
        }
        ci.ret(obj)
    }
}

// --- kqueue poller ---

// pollInit() -> kqueue fd
fn pollInit(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    
        kq_fd = kqueue()
        // Arm the wakeup channel up front so any thread can wake this loop.
        nm_kq_wake_register(kq_fd)
        // First caller is the main thread; workers must not steal the wake target.
        nm_kq_set_main(kq_fd)
        ci.retI32(kq_fd)
    
}

// pollWake() — wake the loop from anywhere (EVFILT_USER trigger). Thread-safe.
fn pollWake(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    ci.retI32(nm_kq_wake(kq_fd))
}

// pollAdd(fd, filter) — add fd to kqueue (filter: -1=read, -2=write)
fn pollAdd(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    let fd = ci.i32Arg(0, -1)
    let filter = ci.i32Arg(1, -1)
    unsafe {
        var ev: [u8; 32] = [0; 32]
        kevent_set(ev as *u8, fd as i64, filter, 1) // EV_ADD=1
        kevent(kq_fd, ev as *u8, 1, 0 as *u8, 0, 0 as *u8)
    }
}

// pollRemove(fd, filter)
fn pollRemove(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    let fd = ci.i32Arg(0, -1)
    let filter = ci.i32Arg(1, -1)
    unsafe {
        var ev: [u8; 32] = [0; 32]
        kevent_set(ev as *u8, fd as i64, filter, 2) // EV_DELETE=2
        kevent(kq_fd, ev as *u8, 1, 0 as *u8, 0, 0 as *u8)
    }
}

// pollWait(timeout_ms) -> array of {fd, filter, flags}
fn pollWait(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    let timeout_ms = ci.i32Arg(0, 0)
    let iso = ci.isolate()
    let ctx = ci.context()

    unsafe {
        // timespec for kevent timeout
        var ts: [i64; 2] = [0, 0]
        ts[0] = timeout_ms as i64 / 1000
        ts[1] = (timeout_ms as i64 % 1000) * 1000000

        // space for 64 events (64 * 32 = 2048 bytes)
        let events = calloc(64, 32)
        let n = kevent(kq_fd, 0 as *u8, 0, events, 64, ts as *u8)

        if n <= 0 {
            free(events)
            ci.ret(iso.array(0))
            return
        }

        let arr = iso.array(n)
        for i in 0..n {
            let ev_ptr = (events as i64 + (i as i64) * 32) as *u8
            let ident = kevent_get_ident(ev_ptr)
            let filter = kevent_get_filter(ev_ptr)
            let flags = kevent_get_flags(ev_ptr)

            let fflags = kevent_get_fflags(ev_ptr)
            let obj = iso.object()
            ctx.objectSet(obj, "fd" as *u8, iso.int32(ident as i32))
            ctx.objectSet(obj, "filter" as *u8, iso.int32(filter))
            ctx.objectSet(obj, "flags" as *u8, iso.int32(flags))
            ctx.objectSet(obj, "fflags" as *u8, iso.int32(fflags))
            ctx.objectSet(obj, "data" as *u8, iso.int32(kevent_get_data(ev_ptr) as i32))
            ctx.objectSetIndex(arr, i as u32, obj)
        }
        free(events)
        ci.ret(arr)
    }
}

// --- file watching via kqueue EVFILT_VNODE ---
// NOTE_DELETE=1, NOTE_WRITE=2, NOTE_EXTEND=4, NOTE_ATTRIB=8, NOTE_LINK=16, NOTE_RENAME=32, NOTE_REVOKE=64
// EV_ADD=1, EV_ENABLE=4, EV_CLEAR=0x20

// watchFile(path) -> fd (or -1 on error)
fn tcpWatchFile(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    let iso = ci.isolate()
    unsafe {
        var pathBuf: [u8; 4096] = [0; 4096]
        let plen = ci.arg(0).writeUtf8(iso, pathBuf as *u8, 4096)
        if plen <= 0 {
            ci.retI32(-1)
            return
        }
        // O_EVTONLY = 0x8000 — open for kqueue monitoring only
        let fd = nm_fs_open(pathBuf as *u8, 0x8000, 0)
        if fd < 0 {
            ci.retI32(-1)
            return
        }
        if kq_fd < 0 {
            kq_fd = kqueue()
        }
        var ev: [u8; 32] = [0; 32]
        // EV_ADD | EV_ENABLE | EV_CLEAR = 1 | 4 | 0x20 = 0x25
        // NOTE_DELETE|NOTE_WRITE|NOTE_EXTEND|NOTE_ATTRIB|NOTE_RENAME = 1|2|4|8|32 = 47
        kevent_set_vnode(ev as *u8, fd as i64, 0x25, 47)
        kevent(kq_fd, ev as *u8, 1, 0 as *u8, 0, 0 as *u8)
        ci.retI32(fd)
    }
}

// unwatchFile(fd)
fn tcpUnwatchFile(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    let fd = ci.i32Arg(0, -1)
    unsafe {
        if fd >= 0 {
            // EV_DELETE = 2
            var ev: [u8; 32] = [0; 32]
            kevent_set_vnode(ev as *u8, fd as i64, 2, 0)
            kevent(kq_fd, ev as *u8, 1, 0 as *u8, 0, 0 as *u8)
            close(fd)
        }
    }
}

// TCP_NODELAY=1, IPPROTO_TCP=6, SO_KEEPALIVE=8, SOL_SOCKET=0xffff
fn tcpSetNoDelay(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    unsafe {
        let fd = ci.i32Arg(0, -1)
        let on = ci.i32Arg(1, 1)
        var val: [i32; 1] = [on]
        setsockopt(fd, 6, 1, val as *u8, 4)
        ci.retI32(0)
    }
}

// soError(fd) → pending socket error (errno), 0 if none. Used after async
// connect completes to distinguish success from ECONNREFUSED/ETIMEDOUT/etc.
// (a failed connect also makes the socket write-ready). SOL_SOCKET=0xffff,
// SO_ERROR=0x1007 on darwin.
fn tcpSoError(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    unsafe {
        let fd = ci.i32Arg(0, -1)
        var val: [i32; 1] = [0]
        var len: [i32; 1] = [4]
        let r = getsockopt(fd, 0xffff, 0x1007, val as *u8, len as *u8)
        if r != 0 {
            ci.retI32(-1)
        } else {
            ci.retI32(val[0])
        }
    }
}

fn tcpSetKeepAlive(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    unsafe {
        let fd = ci.i32Arg(0, -1)
        let on = ci.i32Arg(1, 1)
        var val: [i32; 1] = [on]
        setsockopt(fd, 0xffff, 8, val as *u8, 4)
        ci.retI32(0)
    }
}

fn tcpSetLinger(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    unsafe {
        let fd = ci.i32Arg(0, -1)
        let on = ci.i32Arg(1, 0)
        let secs = ci.i32Arg(2, 0)
        // struct linger { int l_onoff; int l_linger; }
        var ling: [i32; 2] = [on, secs]
        setsockopt(fd, 0xffff, 0x80, ling as *u8, 8)
        ci.retI32(0)
    }
}

// --- TLS ---
// sslConnect(fd, hostname) → ssl handle (i64), or 0 on failure
fn sslConnect(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    let fd = ci.i32Arg(0, -1)
    let iso = ci.isolate()
    unsafe {
        var hostBuf: [u8; 256] = [0; 256]
        if ci.length() > 1 {
            let arg = ci.arg(1)
            arg.writeUtf8(iso, hostBuf as *u8, 255)
        }
        let ssl = nm_ssl_connect(fd, hostBuf as *u8)
        ci.retF64(ssl as f64)
    }
}

// sslConnectStart(fd, hostname, caPem?, verifyHost?, minVer?, maxVer?, ciphers?, suites?)
//   → ssl handle or -1 on error
fn sslConnectStart(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    if ci.length() < 2 { return }
    let iso = ci.isolate()
    unsafe {
        let fd = ci.i32Arg(0, -1)
        var hostBuf: [u8; 256] = [0; 256]
        ci.arg(1).writeUtf8(iso, hostBuf as *u8, 255)
        // A ca bundle is far too big for a stack buffer. Left empty when absent — the C side
        // reads an empty string as "no ca given" and keeps the default trust roots.
        let caBuf = calloc(1, 65536)
        if ci.length() > 2 {
            ci.arg(2).writeUtf8(iso, caBuf, 65535)
        }
        // arg 3 = the name the cert must be valid for; empty means skip the hostname check.
        var vhBuf: [u8; 256] = [0; 256]
        if ci.length() > 3 {
            ci.arg(3).writeUtf8(iso, vhBuf as *u8, 255)
        }
        // args 4-7: optional tls restrictions; empty = keep the default.
        var cMinBuf: [u8; 32] = [0; 32]
        var cMaxBuf: [u8; 32] = [0; 32]
        let cCsBuf = calloc(1, 4096)
        let cSuBuf = calloc(1, 1024)
        if ci.length() > 4 { ci.arg(4).writeUtf8(iso, cMinBuf as *u8, 31) }
        if ci.length() > 5 { ci.arg(5).writeUtf8(iso, cMaxBuf as *u8, 31) }
        if ci.length() > 6 { ci.arg(6).writeUtf8(iso, cCsBuf, 4095) }
        if ci.length() > 7 { ci.arg(7).writeUtf8(iso, cSuBuf, 1023) }
        // args 8-9: client identity for mutual tls. Heap: a cert bundle + key exceed any
        // sane stack buffer.
        let certBuf = calloc(1, 65536)
        let keyBuf = calloc(1, 65536)
        if ci.length() > 8 { ci.arg(8).writeUtf8(iso, certBuf, 65535) }
        if ci.length() > 9 { ci.arg(9).writeUtf8(iso, keyBuf, 65535) }
        let ssl = nm_ssl_connect_start(fd, hostBuf as *u8, caBuf, vhBuf as *u8,
                                       cMinBuf as *u8, cMaxBuf as *u8, cCsBuf, cSuBuf,
                                       certBuf, keyBuf)
        free(cCsBuf)
        free(cSuBuf)
        free(certBuf)
        free(keyBuf)
        free(caBuf)
        ci.retF64(ssl as f64)
    }
}

// Read the ssl handle from arg 0. Three near-identical ops below rather than one helper
// dispatching on a function pointer — that comparison does not do what it looks like and
// called the wrong function, returning garbage that OOM'd v8.
fn _sslArg(ci: CallbackInfo, iso: Isolate): i64 {
    unsafe {
        var sslVal: [f64; 1] = [0.0]
        ci.arg(0).toF64(iso, sslVal as *f64)
        return sslVal[0] as i64
    }
}

// sslPeerCertJson(sslHandle) → JSON string of the peer cert, or "" if none. C mallocs; free it.
fn sslPeerCertJson(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    if ci.length() < 1 { return }
    let iso = ci.isolate()
    unsafe {
        let p = nm_ssl_peer_cert_json(_sslArg(ci, iso))
        if p as i64 == 0 { ci.retStr("" as *u8); return }
        ci.retStr(p)
        free(p)
    }
}

// sslCipherInfo(sslHandle) → "name/version/bits", or ""
fn sslCipherInfo(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    if ci.length() < 1 { return }
    let iso = ci.isolate()
    unsafe {
        let p = nm_ssl_cipher_info(_sslArg(ci, iso))
        if p as i64 == 0 { ci.retStr("" as *u8); return }
        ci.retStr(p)
        free(p)
    }
}

// sslProtocol(sslHandle) → e.g. "TLSv1.3". Borrowed from OpenSSL — do NOT free.
fn sslProtocolOp(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    if ci.length() < 1 { return }
    let iso = ci.isolate()
    unsafe {
        let p = nm_ssl_protocol(_sslArg(ci, iso))
        if p as i64 == 0 { ci.retStr("" as *u8); return }
        ci.retStr(p)
    }
}

// sslVerifyResult(sslHandle) → 0 = chain verified, -2 = peer sent no cert, else X509_V_ERR_*
fn sslVerifyResultOp(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    if ci.length() < 1 { return }
    let iso = ci.isolate()
    unsafe {
        var sslVal: [f64; 1] = [0.0]
        ci.arg(0).toF64(iso, sslVal as *f64)
        let r = nm_ssl_verify_result(sslVal[0] as i64)
        ci.retI32(r as i32)
    }
}

// sslConnectContinue(sslHandle) → 1=done, 0=want_read/write, -1=error
fn sslConnectContinueOp(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    let iso = ci.isolate()
    unsafe {
        let sslArg = ci.arg(0)
        var sslVal: [f64; 1] = [0.0]
        sslArg.toF64(iso, sslVal as *f64)
        let ssl = sslVal[0] as i64
        let result = nm_ssl_connect_continue(ssl)
        ci.retI32(result)
    }
}

// sslRead(sslHandle) → Uint8Array or undefined (closed) or empty Uint8Array (EAGAIN)
fn sslRead(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    unsafe {
        let iso = ci.isolate()
        let sslArg = ci.arg(0)
        var sslVal: [f64; 1] = [0.0]
        sslArg.toF64(iso, sslVal as *f64)
        let ssl = sslVal[0] as i64
        let buf = calloc(1, 65536)
        let n = nm_ssl_read(ssl, buf, 65535)
        if n > 0 {
            let nLen = n as i64
            let ab = iso.arraybufferNew(nLen)
            let result = iso.uint8arrayNew(ab, 0 as i64, nLen)
            let resultPtr = result.typedArrayData(iso)
            memcpy(resultPtr, buf, nLen)
            free(buf)
            ci.ret(result)
        } else if n == 0 {
            free(buf)
            ci.retUndefined()
        } else {
            free(buf)
            let ab = iso.arraybufferNew(0 as i64)
            let result = iso.uint8arrayNew(ab, 0 as i64, 0 as i64)
            ci.ret(result)
        }
    }
}

// sslWrite(sslHandle, data) → bytes written — data can be string or Uint8Array
fn sslWrite(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    let iso = ci.isolate()
    unsafe {
        let sslArg = ci.arg(0)
        var sslVal: [f64; 1] = [0.0]
        sslArg.toF64(iso, sslVal as *f64)
        let ssl = sslVal[0] as i64
        let arg = ci.arg(1)
        if arg.isString(iso) == 1 {
            let buf = calloc(1, 65536)
            var len = arg.writeUtf8(iso, buf, 65536)
            if len > 0 {
                let last = (buf as i64 + (len - 1) as i64) as *u8
                if last[0] == 0 { len = len - 1 }
            }
            if len <= 0 {
                free(buf)
                ci.retI32(0)
                return
            }
            let n = nm_ssl_write(ssl, buf, len)
            free(buf)
            ci.retI32(n)
        } else {
            let dataPtr = arg.typedArrayData(iso)
            let dataLen = arg.typedArrayByteLength(iso) as i32
            if dataLen <= 0 {
                ci.retI32(0)
                return
            }
            let n = nm_ssl_write(ssl, dataPtr, dataLen)
            ci.retI32(n)
        }
    }
}

// sslPending(sslHandle) → bytes pending in SSL buffer
fn sslPending(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    let iso = ci.isolate()
    unsafe {
        let sslArg = ci.arg(0)
        var sslVal: [f64; 1] = [0.0]
        sslArg.toF64(iso, sslVal as *f64)
        let ssl = sslVal[0] as i64
        ci.retI32(nm_ssl_pending(ssl))
    }
}

// sslShutdown(sslHandle)
fn sslShutdown(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    let iso = ci.isolate()
    unsafe {
        let sslArg = ci.arg(0)
        var sslVal: [f64; 1] = [0.0]
        sslArg.toF64(iso, sslVal as *f64)
        let ssl = sslVal[0] as i64
        nm_ssl_shutdown(ssl)
    }
}

// sslServerCtxNew(certStr, keyStr, minVersion?, maxVersion?, ciphers?, ciphersuites?,
//                 caPem?, requestCert?, rejectUnauthorized?)
//   → ctx handle (f64), or 0 on failure
fn sslServerCtxNew(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    if ci.length() < 2 { return }
    let iso = ci.isolate()
    unsafe {
        var certBuf: [u8; 16384] = [0; 16384]
        let certLen = ci.arg(0).writeUtf8(iso, certBuf as *u8, 16383)
        var keyBuf: [u8; 16384] = [0; 16384]
        let keyLen = ci.arg(1).writeUtf8(iso, keyBuf as *u8, 16383)

        // Optional tls restrictions; empty string = "caller said nothing, keep the default".
        var minBuf: [u8; 32] = [0; 32]
        var maxBuf: [u8; 32] = [0; 32]
        let csBuf = calloc(1, 4096)
        let suBuf = calloc(1, 1024)
        if ci.length() > 2 { ci.arg(2).writeUtf8(iso, minBuf as *u8, 31) }
        if ci.length() > 3 { ci.arg(3).writeUtf8(iso, maxBuf as *u8, 31) }
        if ci.length() > 4 { ci.arg(4).writeUtf8(iso, csBuf, 4095) }
        if ci.length() > 5 { ci.arg(5).writeUtf8(iso, suBuf, 1023) }
        // args 6-8: client-cert verification (mutual tls).
        let sCaBuf = calloc(1, 65536)
        if ci.length() > 6 { ci.arg(6).writeUtf8(iso, sCaBuf, 65535) }
        let reqCert = ci.i32Arg(7, 0)
        let rejUnauth = ci.i32Arg(8, 0)
        let ctx = nm_ssl_server_ctx_new(certBuf as *u8, certLen, keyBuf as *u8, keyLen,
                                        minBuf as *u8, maxBuf as *u8, csBuf, suBuf,
                                        sCaBuf, reqCert, rejUnauth)
        free(csBuf)
        free(suBuf)
        free(sCaBuf)
        ci.retF64(ctx as f64)
    }
}

// sslAccept(ctxHandle, fd) → ssl handle (f64), or 0 on failure
fn sslAcceptOp(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    if ci.length() < 2 { return }
    let iso = ci.isolate()
    unsafe {
        let ctxArg = ci.arg(0)
        var ctxVal: [f64; 1] = [0.0]
        ctxArg.toF64(iso, ctxVal as *f64)
        let ctx = ctxVal[0] as i64

        let fd = ci.i32Arg(1, -1)
        let ssl = nm_ssl_accept(ctx, fd)
        ci.retF64(ssl as f64)
    }
}

// sslAcceptNew(ctxHandle, fd) → ssl handle for non-blocking accept
fn sslAcceptNewOp(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    if ci.length() < 2 { return }
    let iso = ci.isolate()
    unsafe {
        let ctxArg = ci.arg(0)
        var ctxVal: [f64; 1] = [0.0]
        ctxArg.toF64(iso, ctxVal as *f64)
        let ctx = ctxVal[0] as i64
        let fd = ci.i32Arg(1, -1)
        let ssl = nm_ssl_accept_new(ctx, fd)
        ci.retF64(ssl as f64)
    }
}

// sslAcceptContinue(sslHandle) → 1=done, 0=want_read/write, -1=error
fn sslAcceptContinueOp(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    let iso = ci.isolate()
    unsafe {
        let sslArg = ci.arg(0)
        var sslVal: [f64; 1] = [0.0]
        sslArg.toF64(iso, sslVal as *f64)
        let ssl = sslVal[0] as i64
        let result = nm_ssl_accept_continue(ssl)
        ci.retI32(result)
    }
}

// sslCtxFree(ctxHandle)
fn sslCtxFree(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    let iso = ci.isolate()
    unsafe {
        let ctxArg = ci.arg(0)
        var ctxVal: [f64; 1] = [0.0]
        ctxArg.toF64(iso, ctxVal as *f64)
        let ctx = ctxVal[0] as i64
        nm_ssl_ctx_free(ctx)
    }
}

// --- UDP bindings ---

// udpSocket() → fd  (AF_INET=2, SOCK_DGRAM=2)
// udpSocket(family?) -> fd. Defaults to AF_INET; pass AF_INET6 (30) for udp6.
// dgram.createSocket('udp6') used to get an AF_INET socket, which is the same root cause
// as tcp's: the family is fixed here, and nothing downstream can change it.
fn udpSocket(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    
        let family = ci.i32Arg(0, AF_INET)
        let fd = socket(family, 2, 0)
        if fd >= 0 {
            nm_set_nonblock(fd)
        }
        ci.retI32(fd)
    
}

// udpBind(fd, port, host)
fn udpBind(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    let iso = ci.isolate()
    let fd = ci.i32Arg(0, -1)
    let port = ci.i32Arg(1, 0)
    unsafe {
        var host_buf: [u8; 256] = [0; 256]
        if ci.length() > 2 {
            ci.arg(2).writeUtf8(iso, host_buf as *u8, 256)
        }

        var addr: [u8; 28] = [0; 28]
        var family = AF_INET
        if hostIsV6(host_buf as *u8) {
            family = AF_INET6
        }
        let alen = buildSockAddr(host_buf as *u8, port, addr as *u8, family)
        if alen < 0 {
            ci.retI32(-1)
            return
        }
        // SO_REUSEADDR
        var on: [i32; 1] = [1]
        setsockopt(fd, 0xffff, 4, on as *u8, 4)

        let r = bind(fd, addr as *u8, alen as i32)
        ci.retI32(r)
    }
}

// udpSend(fd, data, port, host) → bytes sent
// udpSendBinary(fd, uint8Array, port, address) -> bytes sent.
// udpSend() takes a STRING and does writeUtf8, so dgram.js had to call buf.toString() and
// every non-utf8 byte became U+FFFD — binary payloads were silently corrupted on the wire
// (8 bytes of binary came back as 19). This is the raw path, mirroring tcpSendBinary.
fn udpSendBinaryOp(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    let iso = ci.isolate()
    let fd = ci.i32Arg(0, -1)
    let port = ci.i32Arg(2, 0)
    unsafe {
        let arr = ci.arg(1)
        let dataPtr = arr.typedArrayData(iso)
        let dataLen = arr.typedArrayByteLength(iso)

        var host_buf: [u8; 256] = [0; 256]
        if ci.length() > 3 {
            ci.arg(3).writeUtf8(iso, host_buf as *u8, 256)
        }

        // No host keeps the old default of 127.0.0.1 — an empty host means loopback here,
        // not INADDR_ANY, so buildSockAddr's "any" rule is not what this wants.
        var addr: [u8; 28] = [0; 28]
        var host_p = host_buf as *u8
        if host_buf[0] == 0 {
            host_p = "127.0.0.1" as *u8
        }
        var family = AF_INET
        if hostIsV6(host_p) {
            family = AF_INET6
        }
        let alen = buildSockAddr(host_p, port, addr as *u8, family)
        if alen < 0 {
            ci.retI32(-1)
            return
        }
        // The length must match the family: sending a 16-byte sockaddr for a v6
        // destination is how a udp6 datagram ends up addressed to 0.0.0.0.
        let n = sendto(fd, dataPtr, dataLen, 0, addr as *u8, alen as i32)
        ci.retI32(n as i32)
    }
}

fn udpSendOp(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    let iso = ci.isolate()
    let fd = ci.i32Arg(0, -1)
    let port = ci.i32Arg(2, 0)
    unsafe {
        var dataBuf: [u8; 65536] = [0; 65536]
        let dataLen = ci.arg(1).writeUtf8(iso, dataBuf as *u8, 65536)

        var host_buf: [u8; 256] = [0; 256]
        if ci.length() > 3 {
            ci.arg(3).writeUtf8(iso, host_buf as *u8, 256)
        }

        // Same treatment as udpSendBinary: an empty host still means loopback (not
        // INADDR_ANY), so the default is spelled out rather than left to buildSockAddr.
        var addr: [u8; 28] = [0; 28]
        var host_p = host_buf as *u8
        if host_buf[0] == 0 {
            host_p = "127.0.0.1" as *u8
        }
        var family = AF_INET
        if hostIsV6(host_p) {
            family = AF_INET6
        }
        let alen = buildSockAddr(host_p, port, addr as *u8, family)
        if alen < 0 {
            ci.retI32(-1)
            return
        }
        let n = sendto(fd, dataBuf as *u8, dataLen as i64, 0, addr as *u8, alen as i32)
        ci.retI32(n as i32)
    }
}

// udpRecv(fd) → {data, rinfo: {address, port, family, size}} or undefined
fn udpRecvOp(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    let iso = ci.isolate()
    let ctx = ci.context()
    let fd = ci.i32Arg(0, -1)
    unsafe {
        let buf = calloc(1, 65536)
        // 28B: recvfrom writes a sockaddr_in6 for a v6 sender, and 16 bytes truncates it
        // — the address would be garbage, not merely mislabelled.
        var srcAddr: [u8; 28] = [0; 28]
        var addrLen: [i32; 1] = [28]
        let n = recvfrom(fd, buf, 65535, 0, srcAddr as *u8, addrLen as *i32)
        if n <= 0 {
            ci.retUndefined()
            free(buf)
            return
        }

        // Extract source address and port
        var addrStr: [u8; 64] = [0; 64]
        // The kernel filled in the family; read it rather than assume it.
        sockAddrText(srcAddr as *u8, addrStr as *u8, 64)
        let srcPort = sockAddrPort(srcAddr as *u8)

        // `data` used to be iso.stringLen(...) — a V8 STRING, i.e. the payload was utf8
        // decoded on arrival and every invalid byte became U+FFFD. Together with the old
        // utf8 send path this corrupted every binary datagram in both directions.
        // Return raw bytes (dgram.js is the only consumer).
        let result = iso.object()
        let ab = iso.arraybufferNew(n)
        let dataArr = iso.uint8arrayNew(ab, 0, n)
        memcpy(dataArr.typedArrayData(iso), buf, n)
        ctx.objectSet(result, "data" as *u8, dataArr)

        let rinfo = iso.object()
        ctx.objectSet(rinfo, "address" as *u8, iso.string(addrStr as *u8))
        ctx.objectSet(rinfo, "port" as *u8, iso.int32(srcPort))
        // Third instance of the same bug: the kernel knows who sent the datagram, and
        // this overwrote it with 'IPv4'. rinfo is { address, family, port, size }.
        if sockAddrFamily(srcAddr as *u8) == AF_INET6 {
            ctx.objectSet(rinfo, "family" as *u8, iso.string("IPv6" as *u8))
        } else {
            ctx.objectSet(rinfo, "family" as *u8, iso.string("IPv4" as *u8))
        }
        ctx.objectSet(rinfo, "size" as *u8, iso.int32(n as i32))
        ctx.objectSet(result, "rinfo" as *u8, rinfo)

        ci.ret(result)
        free(buf)
    }
}

// udpSetOpt(fd, optName, value) — generic setsockopt for UDP
// optName: 1=SO_BROADCAST, 2=IP_TTL, 3=IP_MULTICAST_TTL
// udpSetOpt(fd, opt, val) -> 0, or -1 if the setsockopt failed / opt is unknown.
// Returning the result is the point: every one of these used to return void, so the JS
// side's `if (r < 0)` compared `undefined < 0` and no failure could ever surface.
fn udpSetOpt(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    let fd = ci.i32Arg(0, -1)
    let opt = ci.i32Arg(1, 0)
    let val = ci.i32Arg(2, 0)
    unsafe {
        var optVal: [i32; 1] = [val]
        var r: i32 = -1
        if opt == 1 {
            // SO_BROADCAST: SOL_SOCKET=0xffff, SO_BROADCAST=0x20
            r = setsockopt(fd, 0xffff, 0x20, optVal as *u8, 4)
        }
        if opt == 2 {
            // IP_TTL: IPPROTO_IP=0, IP_TTL=4
            r = setsockopt(fd, 0, 4, optVal as *u8, 4)
        }
        if opt == 3 {
            // IP_MULTICAST_TTL: IPPROTO_IP=0, IP_MULTICAST_TTL=10
            r = setsockopt(fd, 0, 10, optVal as *u8, 4)
        }
        if opt == 4 {
            // IP_MULTICAST_LOOP: IPPROTO_IP=0, IP_MULTICAST_LOOP=11
            r = setsockopt(fd, 0, 11, optVal as *u8, 4)
        }
        ci.retI32(r)
    }
}

// udpAddMembership(fd, multicastAddr, interfaceAddr)
fn udpAddMembership(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    let iso = ci.isolate()
    let fd = ci.i32Arg(0, -1)
    unsafe {
        var mcastBuf: [u8; 256] = [0; 256]
        ci.arg(1).writeUtf8(iso, mcastBuf as *u8, 256)
        var ifBuf: [u8; 256] = [0; 256]
        if ci.length() > 2 {
            ci.arg(2).writeUtf8(iso, ifBuf as *u8, 256)
        }

        // ip_mreq: multicast addr (4 bytes) + interface addr (4 bytes)
        var mreq: [u8; 8] = [0; 8]
        // inet_pton returns 1 on success. Discarding it meant "256.256.256.256" left mreq
        // zeroed and joined INADDR_ANY instead of failing — the same silent-parse bug that
        // made listen(0, '::1') bind 0.0.0.0.
        if inet_pton(2, mcastBuf as *u8, mreq as *u8) != 1 {
            ci.retI32(-1)
            return
        }
        if ifBuf[0] != 0 {
            if inet_pton(2, ifBuf as *u8, (mreq as *u8 as i64 + 4) as *u8) != 1 {
                ci.retI32(-1)
                return
            }
        }
        // IP_ADD_MEMBERSHIP: IPPROTO_IP=0, IP_ADD_MEMBERSHIP=12
        ci.retI32(setsockopt(fd, 0, 12, mreq as *u8, 8))
    }
}

// udpDropMembership(fd, multicastAddr, interfaceAddr)
fn udpDropMembership(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    let iso = ci.isolate()
    let fd = ci.i32Arg(0, -1)
    unsafe {
        var mcastBuf: [u8; 256] = [0; 256]
        ci.arg(1).writeUtf8(iso, mcastBuf as *u8, 256)
        var ifBuf: [u8; 256] = [0; 256]
        if ci.length() > 2 {
            ci.arg(2).writeUtf8(iso, ifBuf as *u8, 256)
        }
        var mreq: [u8; 8] = [0; 8]
        if inet_pton(2, mcastBuf as *u8, mreq as *u8) != 1 {
            ci.retI32(-1)
            return
        }
        if ifBuf[0] != 0 {
            if inet_pton(2, ifBuf as *u8, (mreq as *u8 as i64 + 4) as *u8) != 1 {
                ci.retI32(-1)
                return
            }
        }
        // IP_DROP_MEMBERSHIP: IPPROTO_IP=0, IP_DROP_MEMBERSHIP=13
        ci.retI32(setsockopt(fd, 0, 13, mreq as *u8, 8))
    }
}

// udpSetMulticastInterface(fd, addr, family) -> 0 / -1.
// The two families disagree about what "interface" even means: IPv4 takes an in_addr, IPv6
// takes a u_int interface index (from the "%zone" suffix). Same option number (9), totally
// different payload — so this can't ride on udpSetOpt's i32 value, and family must come
// from the caller rather than be guessed from the string.
fn udpSetMulticastInterface(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    let iso = ci.isolate()
    let fd = ci.i32Arg(0, -1)
    unsafe {
        var addrBuf: [u8; 256] = [0; 256]
        ci.arg(1).writeUtf8(iso, addrBuf as *u8, 256)
        let family = ci.i32Arg(2, AF_INET)

        if family == AF_INET6 {
            var addrPart: [u8; 256] = [0; 256]
            var zonePart: [u8; 256] = [0; 256]
            if !splitZone(addrBuf as *u8, addrPart as *u8, zonePart as *u8) {
                ci.retI32(-1)
                return
            }
            // No zone means "default selection" (index 0), which the test accepts; but an
            // empty address is a plain EINVAL.
            var idxVal: [u32; 1] = [0]
            if zonePart[0] != 0 {
                idxVal[0] = if_nametoindex(zonePart as *u8)
            } else {
                if addrPart[0] == 0 {
                    ci.retI32(-1)
                    return
                }
            }
            // IPPROTO_IPV6=41, IPV6_MULTICAST_IF=9
            ci.retI32(setsockopt(fd, IPPROTO_IPV6, 9, idxVal as *u8, 4))
            return
        }

        var ia: [u8; 4] = [0; 4]
        // A v6 literal ("::") fails here rather than silently selecting 0.0.0.0; the test
        // accepts EINVAL for that case on a udp4 socket.
        if inet_pton(2, addrBuf as *u8, ia as *u8) != 1 {
            ci.retI32(-1)
            return
        }
        // IPPROTO_IP=0, IP_MULTICAST_IF=9
        ci.retI32(setsockopt(fd, 0, 9, ia as *u8, 4))
    }
}

// udpSetSourceMembership(fd, mcast, source, iface, add) -> 0 / -1.
// ip_mreq_source is {multiaddr, sourceaddr, interface} — source comes BEFORE interface,
// which is the reverse of what the argument order suggests (checked against netinet/in.h).
fn udpSetSourceMembership(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    let iso = ci.isolate()
    let fd = ci.i32Arg(0, -1)
    unsafe {
        var mcastBuf: [u8; 256] = [0; 256]
        ci.arg(1).writeUtf8(iso, mcastBuf as *u8, 256)
        var srcBuf: [u8; 256] = [0; 256]
        ci.arg(2).writeUtf8(iso, srcBuf as *u8, 256)
        var ifBuf: [u8; 256] = [0; 256]
        if ci.length() > 3 {
            ci.arg(3).writeUtf8(iso, ifBuf as *u8, 256)
        }
        let add = ci.i32Arg(4, 1)

        var mreq: [u8; 12] = [0; 12]
        let base = mreq as *u8 as i64
        if inet_pton(2, mcastBuf as *u8, mreq as *u8) != 1 {
            ci.retI32(-1)
            return
        }
        if inet_pton(2, srcBuf as *u8, (base + 4) as *u8) != 1 {
            ci.retI32(-1)
            return
        }
        if ifBuf[0] != 0 {
            if inet_pton(2, ifBuf as *u8, (base + 8) as *u8) != 1 {
                ci.retI32(-1)
                return
            }
        }
        // IPPROTO_IP=0; IP_ADD_SOURCE_MEMBERSHIP=70, IP_DROP_SOURCE_MEMBERSHIP=71 (macOS;
        // Linux uses 39/40).
        var opt: i32 = 71
        if add == 1 {
            opt = 70
        }
        ci.retI32(setsockopt(fd, 0, opt, mreq as *u8, 12))
    }
}

fn nm_init_tcp(_iso: *u8, ctx: *u8, exports: i32): void {
    let c = Context { ptr: ctx }
    let exp = Value { slot: exports }
    unsafe {
        c.setMethod(exp, "socket" as *u8, tcpSocket as *u8)
        c.setMethod(exp, "bind" as *u8, tcpBind as *u8)
        c.setMethod(exp, "listen" as *u8, tcpListen as *u8)
        c.setMethod(exp, "accept" as *u8, tcpAccept as *u8)
        c.setMethod(exp, "connect" as *u8, tcpConnect as *u8)
        c.setMethod(exp, "send" as *u8, tcpSend as *u8)
        c.setMethod(exp, "sendBinary" as *u8, tcpSendBinary as *u8)
        c.setMethod(exp, "recv" as *u8, tcpRecv as *u8)
        c.setMethod(exp, "recvBinary" as *u8, tcpRecvBinary as *u8)
        c.setMethod(exp, "shutdown" as *u8, tcpShutdown as *u8)
        c.setMethod(exp, "close" as *u8, tcpClose as *u8)
        c.setMethod(exp, "getSockName" as *u8, tcpGetSockName as *u8)
        c.setMethod(exp, "getPeerName" as *u8, tcpGetPeerName as *u8)
        c.setMethod(exp, "pollInit" as *u8, pollInit as *u8)
        c.setMethod(exp, "pollAdd" as *u8, pollAdd as *u8)
        c.setMethod(exp, "pollRemove" as *u8, pollRemove as *u8)
        c.setMethod(exp, "pollWait" as *u8, pollWait as *u8)
        c.setMethod(exp, "setNoDelay" as *u8, tcpSetNoDelay as *u8)
        c.setMethod(exp, "soError" as *u8, tcpSoError as *u8)
        c.setMethod(exp, "setKeepAlive" as *u8, tcpSetKeepAlive as *u8)
        c.setMethod(exp, "setLinger" as *u8, tcpSetLinger as *u8)
        c.setMethod(exp, "watchFile" as *u8, tcpWatchFile as *u8)
        c.setMethod(exp, "unwatchFile" as *u8, tcpUnwatchFile as *u8)
        c.setMethod(exp, "sslConnect" as *u8, sslConnect as *u8)
        c.setMethod(exp, "pollWake" as *u8, pollWake as *u8)
        c.setMethod(exp, "sslConnectStart" as *u8, sslConnectStart as *u8)
        c.setMethod(exp, "sslVerifyResult" as *u8, sslVerifyResultOp as *u8)
        c.setMethod(exp, "sslPeerCertJson" as *u8, sslPeerCertJson as *u8)
        c.setMethod(exp, "sslCipherInfo" as *u8, sslCipherInfo as *u8)
        c.setMethod(exp, "sslProtocol" as *u8, sslProtocolOp as *u8)
        c.setMethod(exp, "sslConnectContinue" as *u8, sslConnectContinueOp as *u8)
        c.setMethod(exp, "sslRead" as *u8, sslRead as *u8)
        c.setMethod(exp, "sslWrite" as *u8, sslWrite as *u8)
        c.setMethod(exp, "sslPending" as *u8, sslPending as *u8)
        c.setMethod(exp, "sslShutdown" as *u8, sslShutdown as *u8)
        c.setMethod(exp, "sslServerCtxNew" as *u8, sslServerCtxNew as *u8)
        c.setMethod(exp, "sslAccept" as *u8, sslAcceptOp as *u8)
        c.setMethod(exp, "sslAcceptNew" as *u8, sslAcceptNewOp as *u8)
        c.setMethod(exp, "sslAcceptContinue" as *u8, sslAcceptContinueOp as *u8)
        c.setMethod(exp, "sslCtxFree" as *u8, sslCtxFree as *u8)

        // UDP
        c.setMethod(exp, "udpSocket" as *u8, udpSocket as *u8)
        c.setMethod(exp, "udpBind" as *u8, udpBind as *u8)
        c.setMethod(exp, "udpSend" as *u8, udpSendOp as *u8)
        c.setMethod(exp, "udpSendBinary" as *u8, udpSendBinaryOp as *u8)
        c.setMethod(exp, "udpRecv" as *u8, udpRecvOp as *u8)
        c.setMethod(exp, "udpSetOpt" as *u8, udpSetOpt as *u8)
        c.setMethod(exp, "udpAddMembership" as *u8, udpAddMembership as *u8)
        c.setMethod(exp, "udpDropMembership" as *u8, udpDropMembership as *u8)
        c.setMethod(exp, "udpSetSourceMembership" as *u8, udpSetSourceMembership as *u8)
        c.setMethod(exp, "udpSetMulticastInterface" as *u8, udpSetMulticastInterface as *u8)

        // constants
        let i = Isolate { ptr: _iso }
        c.objectSet(exp, "EVFILT_READ" as *u8, i.int32(-1))
        c.objectSet(exp, "EVFILT_WRITE" as *u8, i.int32(-2))
        c.objectSet(exp, "EV_EOF" as *u8, i.int32(0x8000))
    }
}
