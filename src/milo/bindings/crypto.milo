// crypto binding — real hashing via CommonCrypto, secure random via getentropy

from "../v8/v8" import { CallbackInfo, Isolate, Context, Value }

extern fn getentropy(buf: *u8, len: i64): i32
extern fn CC_SHA256(data: *u8, len: u32, md: *u8): *u8
extern fn CC_SHA1(data: *u8, len: u32, md: *u8): *u8
extern fn CC_MD5(data: *u8, len: u32, md: *u8): *u8
extern fn CC_SHA512(data: *u8, len: u32, md: *u8): *u8

// CommonCrypto symmetric cipher + PBKDF2
// CCCrypt(op, alg, options, key, keyLen, iv, dataIn, dataInLen, dataOut, dataOutAvail, dataOutMoved) → i32
extern fn CCCrypt(op: u32, alg: u32, options: u32, key: *u8, keyLen: i64, iv: *u8, dataIn: *u8, dataInLen: i64, dataOut: *u8, dataOutAvail: i64, dataOutMoved: *i64): i32
// CCKeyDerivationPBKDF(algo, password, passLen, salt, saltLen, prf, rounds, derivedKey, derivedKeyLen) → i32
extern fn CCKeyDerivationPBKDF(algo: u32, password: *u8, passLen: i64, salt: *u8, saltLen: i64, prf: u32, rounds: u32, derivedKey: *u8, derivedKeyLen: i64): i32

// AES-GCM via CommonCrypto helper in entry.c
extern fn nm_aes_gcm_crypt(encrypt: i32, key: *u8, keyLen: i32, iv: *u8, ivLen: i32, aad: *u8, aadLen: i32, input: *u8, inputLen: i32, output: *u8, tagBuf: *u8, tagLen: i32): i32

extern fn malloc(size: i64): *u8
extern fn free(ptr: *u8): void
extern fn memcpy(dst: *u8, src: *u8, len: i64): *u8

// cryptoRandomBytes(size) -> fills a Buffer with secure random bytes
// Takes a Uint8Array/Buffer as arg[0] and fills it
fn randomFill(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    if ci.length() < 2 { return }
    let iso = ci.isolate()
    let buf = ci.arg(0)
    let size = ci.i32Arg(1, 0)
    if size <= 0 { return }
    unsafe {
        let ptr = buf.typedArrayData(iso)
        if ptr as i64 == 0 { return }
        // getentropy max 256 bytes per call
        var filled: i32 = 0
        while filled < size {
            var chunk = size - filled
            if chunk > 256 { chunk = 256 }
            let dest = (ptr as i64 + filled as i64) as *u8
            getentropy(dest, chunk as i64)
            filled = filled + chunk
        }
    }
}

// cryptoHash(algorithm_int, data_ptr, data_len) -> hash bytes as hex string
// algorithm: 0=md5, 1=sha1, 2=sha256, 3=sha512
fn hashDigest(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    if ci.length() < 2 { return }
    let iso = ci.isolate()
    let algo = ci.i32Arg(0, 2)
    let dataBuf = ci.arg(1)
    let dataLen = ci.i32Arg(2, 0)

    unsafe {
        let dataPtr = dataBuf.typedArrayData(iso)
        if dataPtr as i64 == 0 { return }

        var hashLen: i32 = 32
        if algo == 0 { hashLen = 16 }
        if algo == 1 { hashLen = 20 }
        if algo == 3 { hashLen = 64 }

        var hashBuf: [u8; 64] = [0; 64]
        if algo == 0 { CC_MD5(dataPtr, dataLen as u32, hashBuf as *u8) }
        if algo == 1 { CC_SHA1(dataPtr, dataLen as u32, hashBuf as *u8) }
        if algo == 2 { CC_SHA256(dataPtr, dataLen as u32, hashBuf as *u8) }
        if algo == 3 { CC_SHA512(dataPtr, dataLen as u32, hashBuf as *u8) }

        // Return raw hash bytes into a result Uint8Array
        let result = iso.uint8arrayNew(iso.arraybufferNew(hashLen as i64), 0, hashLen)
        let resultPtr = result.typedArrayData(iso)
        memcpy(resultPtr, hashBuf as *u8, hashLen as i64)
        ci.ret(result)
    }
}

// crypt(op, alg, options, keyUint8, ivUint8, dataUint8) → Uint8Array
// op: 0=encrypt, 1=decrypt
// alg: 0=AES
// options: 1=PKCS7 padding
fn cryptOp(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    if ci.length() < 6 { return }
    let iso = ci.isolate()
    unsafe {
        let op = ci.i32Arg(0, 0) as u32
        let alg = ci.i32Arg(1, 0) as u32
        let options = ci.i32Arg(2, 1) as u32

        let keyArr = ci.arg(3)
        let keyPtr = keyArr.typedArrayData(iso)
        let keyLen = keyArr.typedArrayByteLength(iso)

        let ivArr = ci.arg(4)
        let ivPtr = ivArr.typedArrayData(iso)

        let dataArr = ci.arg(5)
        let dataPtr = dataArr.typedArrayData(iso)
        let dataLen = dataArr.typedArrayByteLength(iso)

        // Output buffer: dataLen + one block (16 for AES) for padding
        let outSize = dataLen + 16
        let outBuf = malloc(outSize)
        if outBuf as i64 == 0 { return }

        var outMoved: [i64; 1] = [0]
        let status = CCCrypt(op, alg, options, keyPtr, keyLen, ivPtr, dataPtr, dataLen, outBuf, outSize, outMoved as *i64)

        if status != 0 {
            free(outBuf)
            ci.retI32(0 - status)
            return
        }

        let written = outMoved[0] as i32
        let ab = iso.arraybufferNew(written as i64)
        let result = iso.uint8arrayNew(ab, 0, written)
        let resultPtr = result.typedArrayData(iso)
        memcpy(resultPtr, outBuf, written as i64)
        free(outBuf)
        ci.ret(result)
    }
}

// pbkdf2(password, salt, iterations, keyLen, hmacAlgo) → Uint8Array
// hmacAlgo: 1=SHA1, 2=SHA256, 3=SHA512
fn pbkdf2Op(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    if ci.length() < 5 { return }
    let iso = ci.isolate()
    unsafe {
        let passArr = ci.arg(0)
        let passPtr = passArr.typedArrayData(iso)
        let passLen = passArr.typedArrayByteLength(iso)

        let saltArr = ci.arg(1)
        let saltPtr = saltArr.typedArrayData(iso)
        let saltLen = saltArr.typedArrayByteLength(iso)

        let iterations = ci.i32Arg(2, 1) as u32
        let keyLen = ci.i32Arg(3, 32)
        let hmacAlgo = ci.i32Arg(4, 2) as u32

        let outBuf = malloc(keyLen as i64)
        if outBuf as i64 == 0 { return }

        // kCCPBKDF2 = 2
        let status = CCKeyDerivationPBKDF(2, passPtr, passLen, saltPtr, saltLen, hmacAlgo, iterations, outBuf, keyLen as i64)

        if status != 0 {
            free(outBuf)
            return
        }

        let ab = iso.arraybufferNew(keyLen as i64)
        let result = iso.uint8arrayNew(ab, 0, keyLen)
        let resultPtr = result.typedArrayData(iso)
        memcpy(resultPtr, outBuf, keyLen as i64)
        free(outBuf)
        ci.ret(result)
    }
}

// gcmCrypt(encrypt, keyU8, ivU8, aadU8, dataU8, tagU8) → { data: Uint8Array, tag: Uint8Array }
// encrypt=1: tagU8 is empty buffer of desired tag length; returns filled tag
// encrypt=0: tagU8 is expected auth tag; returns 1 on mismatch
fn gcmCrypt(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    if ci.length() < 6 { return }
    let iso = ci.isolate()
    let ctx = ci.context()
    unsafe {
        let encrypt = ci.i32Arg(0, 1)

        let keyArr = ci.arg(1)
        let keyPtr = keyArr.typedArrayData(iso)
        let keyLen = keyArr.typedArrayByteLength(iso) as i32

        let ivArr = ci.arg(2)
        let ivPtr = ivArr.typedArrayData(iso)
        let ivLen = ivArr.typedArrayByteLength(iso) as i32

        let aadArr = ci.arg(3)
        let aadPtr = aadArr.typedArrayData(iso)
        let aadLen = aadArr.typedArrayByteLength(iso) as i32

        let dataArr = ci.arg(4)
        let dataPtr = dataArr.typedArrayData(iso)
        let dataLen = dataArr.typedArrayByteLength(iso) as i32

        let tagArr = ci.arg(5)
        let tagPtr = tagArr.typedArrayData(iso)
        let tagLen = tagArr.typedArrayByteLength(iso) as i32

        let outBuf = malloc(dataLen as i64)
        if outBuf as i64 == 0 { return }

        // For decrypt, copy expected tag into a mutable buffer
        var tagBuf: [u8; 16] = [0; 16]
        if tagLen > 0 { memcpy(tagBuf as *u8, tagPtr, tagLen as i64) }

        let status = nm_aes_gcm_crypt(encrypt, keyPtr, keyLen, ivPtr, ivLen,
                                       aadPtr, aadLen, dataPtr, dataLen,
                                       outBuf, tagBuf as *u8, tagLen)

        if status != 0 {
            free(outBuf)
            ci.retI32(status)
            return
        }

        let dataAb = iso.arraybufferNew(dataLen as i64)
        let dataResult = iso.uint8arrayNew(dataAb, 0, dataLen)
        let dataResultPtr = dataResult.typedArrayData(iso)
        memcpy(dataResultPtr, outBuf, dataLen as i64)
        free(outBuf)

        let tagAb = iso.arraybufferNew(tagLen as i64)
        let tagResult = iso.uint8arrayNew(tagAb, 0, tagLen)
        let tagResultPtr = tagResult.typedArrayData(iso)
        memcpy(tagResultPtr, tagBuf as *u8, tagLen as i64)

        let result = iso.object()
        ctx.objectSet(result, "data" as *u8, dataResult)
        ctx.objectSet(result, "tag" as *u8, tagResult)
        ci.ret(result)
    }
}

fn nm_init_crypto(_iso: *u8, ctx: *u8, exports: i32): void {
    let c = Context { ptr: ctx }
    let exp = Value { slot: exports }
    unsafe {
        c.setMethod(exp, "randomFill" as *u8, randomFill as *u8)
        c.setMethod(exp, "hash" as *u8, hashDigest as *u8)
        c.setMethod(exp, "crypt" as *u8, cryptOp as *u8)
        c.setMethod(exp, "pbkdf2" as *u8, pbkdf2Op as *u8)
        c.setMethod(exp, "gcmCrypt" as *u8, gcmCrypt as *u8)
    }
}
