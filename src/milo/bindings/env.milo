// env bindings — registers __nm_env.get via V8 C API

from "std/os" import { getenv, strlen }

// V8 C API
extern fn v8c_return_string_len(info: *u8, str: *u8, len: i32): void
extern fn v8c_args_count(info: *u8): i32
extern fn v8c_arg_string(info: *u8, idx: i32, buf: *u8, bufsize: i32): i32
extern fn v8c_obj_new(rt: *u8): i32
extern fn v8c_obj_set_fn(rt: *u8, obj: i32, name: *u8, cb: *u8, user_data: *u8): void
extern fn v8c_set_global(rt: *u8, name: *u8, obj: i32): void

fn env_get(info: *u8, _ud: *u8): void {
    var name_buf: [u8; 256] = [0; 256]
    unsafe {
        let len = v8c_arg_string(info, 0, name_buf as *u8, 256)
        if len < 0 { return }

        let val = getenv(name_buf as *u8)
        if val as i64 == 0 as i64 { return }

        let vlen = strlen(val)
        v8c_return_string_len(info, val, vlen as i32)
    }
}

fn nm_setup_env(rt: *u8): void {
    unsafe {
        let env = v8c_obj_new(rt)
        v8c_obj_set_fn(rt, env, "get", env_get as *u8, 0 as *u8)
        v8c_set_global(rt, "__nm_env", env)
    }
}
