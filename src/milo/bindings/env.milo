// env bindings — getenv/environ via v8 wrapper

from "../v8/v8" import { CallbackInfo, Isolate, Context, Value }

extern fn getenv(name: *u8): *u8
extern fn setenv(name: *u8, value: *u8, overwrite: i32): i32
extern fn unsetenv(name: *u8): i32
extern fn strlen(s: *u8): i64
extern fn environ_get(): **u8

fn envGet(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    let iso = ci.isolate()
    var nameBuf: [u8; 256] = [0; 256]
    if ci.length() < 1 { return }
    unsafe {
        let len = ci.arg(0).writeUtf8(iso, nameBuf as *u8, 256)
        if len < 0 { return }
        let val = getenv(nameBuf as *u8)
        if val as i64 == 0 { return }
        let vlen = strlen(val)
        ci.retStrLen(val, vlen as i32)
    }
}

// Returns a JS array of "KEY=VALUE" strings from environ
fn envEnumerate(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    let iso = ci.isolate()
    let ctx = ci.context()
    unsafe {
        let env = environ_get()
        if env as i64 == 0 {
            ci.ret(iso.array(0))
            return
        }
        // Count entries — env is *(*u8), index as pointer array
        let envArr = env as *i64
        var count: i32 = 0
        while envArr[count as i64] != 0 {
            count = count + 1
        }
        let arr = iso.array(count)
        for i in 0..count {
            let entry = envArr[i as i64] as *u8
            let entryLen = strlen(entry)
            ctx.objectSetIndex(arr, i as u32, iso.stringLen(entry, entryLen as i32))
        }
        ci.ret(arr)
    }
}

fn envSet(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    let iso = ci.isolate()
    if ci.length() < 2 { return }
    var nameBuf: [u8; 256] = [0; 256]
    var valBuf: [u8; 4096] = [0; 4096]
    unsafe {
        ci.arg(0).writeUtf8(iso, nameBuf as *u8, 256)
        ci.arg(1).writeUtf8(iso, valBuf as *u8, 4096)
        setenv(nameBuf as *u8, valBuf as *u8, 1)
    }
}

fn envUnset(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    let iso = ci.isolate()
    if ci.length() < 1 { return }
    var nameBuf: [u8; 256] = [0; 256]
    unsafe {
        ci.arg(0).writeUtf8(iso, nameBuf as *u8, 256)
        unsetenv(nameBuf as *u8)
    }
}

fn nm_init_env(_iso: *u8, ctx: *u8, exports: i32): void {
    let c = Context { ptr: ctx }
    let exp = Value { slot: exports }
    unsafe {
        c.setMethod(exp, "get" as *u8, envGet as *u8)
        c.setMethod(exp, "set" as *u8, envSet as *u8)
        c.setMethod(exp, "unset" as *u8, envUnset as *u8)
        c.setMethod(exp, "enumerate" as *u8, envEnumerate as *u8)
    }
}
