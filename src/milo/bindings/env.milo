// env bindings — getenv via v8 wrapper

from "../v8/v8" import { CallbackInfo, Context, Value }

extern fn getenv(name: *u8): *u8
extern fn strlen(s: *u8): i64

fn env_get(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    let iso = ci.isolate()
    var name_buf: [u8; 256] = [0; 256]
    if ci.length() < 1 { return }
    unsafe {
        let len = ci.arg(0).writeUtf8(iso, name_buf as *u8, 256)
        if len < 0 { return }
        let val = getenv(name_buf as *u8)
        if val as i64 == 0 as i64 { return }
        let vlen = strlen(val)
        ci.retStrLen(val, vlen as i32)
    }
}

fn nm_init_env(_iso: *u8, ctx: *u8, exports: i32): void {
    let c = Context { ptr: ctx }
    let exp = Value { slot: exports }
    unsafe { c.setMethod(exp, "get" as *u8, env_get as *u8) }
}
