// env bindings — getenv via v8capi

extern fn getenv(name: *u8): *u8
extern fn strlen(s: *u8): i64

// v8capi FFI — v8c_value is struct { i32 slot }, ABI-equivalent to i32
extern fn v8c_fci_length(info: *u8): i32
extern fn v8c_fci_arg(info: *u8, idx: i32): i32
extern fn v8c_fci_isolate(info: *u8): *u8
extern fn v8c_fci_context(info: *u8): *u8
extern fn v8c_fci_return_string_len(info: *u8, str: *u8, len: i32): void
extern fn v8c_string_write_utf8(iso: *u8, str: i32, buf: *u8, bufsize: i32): i32
extern fn v8c_object_new(iso: *u8): i32
extern fn v8c_object_set(ctx: *u8, obj: i32, key: *u8, val: i32): i32
extern fn v8c_function_new(ctx: *u8, cb: *u8, data: *u8): i32
extern fn v8c_context_global(ctx: *u8): i32

fn env_get(info: *u8, _ud: *u8): void {
    var name_buf: [u8; 256] = [0; 256]
    unsafe {
        if v8c_fci_length(info) < 1 { return }
        let arg = v8c_fci_arg(info, 0)
        let iso = v8c_fci_isolate(info)
        let len = v8c_string_write_utf8(iso, arg, name_buf as *u8, 256)
        if len < 0 { return }

        let val = getenv(name_buf as *u8)
        if val as i64 == 0 as i64 { return }

        let vlen = strlen(val)
        v8c_fci_return_string_len(info, val, vlen as i32)
    }
}

// Binding init — populates exports object for internalBinding('env')
fn nm_init_env(iso: *u8, ctx: *u8, exports: i32): void {
    unsafe {
        let get_fn = v8c_function_new(ctx, env_get as *u8, 0 as *u8)
        v8c_object_set(ctx, exports, "get", get_fn)
    }
}
