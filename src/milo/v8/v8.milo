// v8.milo — safe wrapper types over v8capi C FFI
// Single source of truth for all v8capi declarations. Nothing else imports v8capi directly.

// --- v8capi extern declarations ---

// FunctionCallbackInfo
extern fn v8c_fci_length(info: *u8): i32
extern fn v8c_fci_arg(info: *u8, idx: i32): i32
extern fn v8c_fci_isolate(info: *u8): *u8
extern fn v8c_fci_context(info: *u8): *u8
extern fn v8c_fci_return(info: *u8, val: i32): void
extern fn v8c_fci_return_int32(info: *u8, val: i32): void
extern fn v8c_fci_return_uint32(info: *u8, val: u32): void
extern fn v8c_fci_return_double(info: *u8, val: f64): void
extern fn v8c_fci_return_bool(info: *u8, val: i32): void
extern fn v8c_fci_return_undefined(info: *u8): void
extern fn v8c_fci_return_string(info: *u8, str: *u8): void
extern fn v8c_fci_return_string_len(info: *u8, str: *u8, len: i32): void

// Value constructors
extern fn v8c_int32(iso: *u8, val: i32): i32
extern fn v8c_number(iso: *u8, val: f64): i32
extern fn v8c_string_utf8(iso: *u8, data: *u8): i32
extern fn v8c_string_utf8_len(iso: *u8, data: *u8, len: i32): i32
extern fn v8c_object_new(iso: *u8): i32
extern fn v8c_array_new(iso: *u8, length: i32): i32
extern fn v8c_undefined(iso: *u8): i32
extern fn v8c_true(iso: *u8): i32
extern fn v8c_false(iso: *u8): i32
extern fn v8c_bigint_i64(iso: *u8, val: i64): i32
extern fn v8c_symbol_new(iso: *u8, desc: *u8): i32
extern fn v8c_arraybuffer_new(iso: *u8, size: i64): i32
extern fn v8c_uint32array_new(iso: *u8, ab: i32, offset: i64, length: i64): i32
extern fn v8c_biguint64array_new(iso: *u8, ab: i32, offset: i64, length: i64): i32

// Value operations
extern fn v8c_to_int32(iso: *u8, val: i32, out: *i32): i32
extern fn v8c_to_double(iso: *u8, val: i32, out: *f64): i32
extern fn v8c_string_write_utf8(iso: *u8, str: i32, buf: *u8, bufsize: i32): i32
extern fn v8c_array_length(iso: *u8, arr: i32): i32
extern fn v8c_value_is_object(iso: *u8, val: i32): i32
extern fn v8c_value_is_function(iso: *u8, val: i32): i32
extern fn v8c_value_is_string(iso: *u8, val: i32): i32
extern fn v8c_value_is_number(iso: *u8, val: i32): i32
extern fn v8c_value_is_array(iso: *u8, val: i32): i32
extern fn v8c_value_is_null_or_undefined(iso: *u8, val: i32): i32

// Context operations
extern fn v8c_context_new(iso: *u8): *u8
extern fn v8c_context_enter(ctx: *u8): void
extern fn v8c_context_exit(ctx: *u8): void
extern fn v8c_context_dispose(ctx: *u8): void
extern fn v8c_context_global(ctx: *u8): i32
extern fn v8c_object_set(ctx: *u8, obj: i32, key: *u8, val: i32): i32
extern fn v8c_object_get(ctx: *u8, obj: i32, key: *u8): i32
extern fn v8c_object_set_index(ctx: *u8, obj: i32, idx: u32, val: i32): i32
extern fn v8c_object_get_index(ctx: *u8, obj: i32, idx: u32): i32
extern fn v8c_function_new(ctx: *u8, cb: *u8, data: *u8): i32
extern fn v8c_object_get_property_names(ctx: *u8, obj: i32, filter: i32): i32
extern fn v8c_script_compile_run(ctx: *u8, source: *u8, source_len: i32, filename: *u8): i32

// Isolate lifecycle
extern fn v8c_isolate_new(): *u8
extern fn v8c_isolate_enter(iso: *u8): void
extern fn v8c_isolate_exit(iso: *u8): void
extern fn v8c_isolate_dispose(iso: *u8): void

// HandleScope
extern fn v8c_handle_scope_new(iso: *u8): *u8
extern fn v8c_handle_scope_delete(hs: *u8): void

// TryCatch
extern fn v8c_try_catch_new(iso: *u8): *u8
extern fn v8c_try_catch_has_caught(tc: *u8): i32
extern fn v8c_try_catch_message(tc: *u8): i32
extern fn v8c_try_catch_delete(tc: *u8): void

// Platform
extern fn v8c_platform_init(execPath: *u8): i32
extern fn v8c_platform_shutdown(): void

// --- wrapper types ---

struct Isolate { ptr: *u8 }
struct Context { ptr: *u8 }
struct Value { slot: i32 }
struct CallbackInfo { ptr: *u8 }
struct HandleScope { ptr: *u8 }
struct TryCatch { ptr: *u8 }

// --- CallbackInfo: wraps V8 FunctionCallbackInfo ---

impl CallbackInfo {
    fn length(self: CallbackInfo): i32 {
        unsafe { return v8c_fci_length(self.ptr) }
    }

    fn arg(self: CallbackInfo, idx: i32): Value {
        unsafe { return Value { slot: v8c_fci_arg(self.ptr, idx) } }
    }

    fn isolate(self: CallbackInfo): Isolate {
        unsafe { return Isolate { ptr: v8c_fci_isolate(self.ptr) } }
    }

    fn context(self: CallbackInfo): Context {
        unsafe { return Context { ptr: v8c_fci_context(self.ptr) } }
    }

    fn ret(self: CallbackInfo, val: Value): void {
        unsafe { v8c_fci_return(self.ptr, val.slot) }
    }

    fn retI32(self: CallbackInfo, val: i32): void {
        unsafe { v8c_fci_return_int32(self.ptr, val) }
    }

    fn retU32(self: CallbackInfo, val: u32): void {
        unsafe { v8c_fci_return_uint32(self.ptr, val) }
    }

    fn retF64(self: CallbackInfo, val: f64): void {
        unsafe { v8c_fci_return_double(self.ptr, val) }
    }

    fn retBool(self: CallbackInfo, val: i32): void {
        unsafe { v8c_fci_return_bool(self.ptr, val) }
    }

    fn retUndefined(self: CallbackInfo): void {
        unsafe { v8c_fci_return_undefined(self.ptr) }
    }

    fn retStr(self: CallbackInfo, str: *u8): void {
        unsafe { v8c_fci_return_string(self.ptr, str) }
    }

    fn retStrLen(self: CallbackInfo, str: *u8, len: i32): void {
        unsafe { v8c_fci_return_string_len(self.ptr, str, len) }
    }

    fn i32Arg(self: CallbackInfo, idx: i32, defaultVal: i32): i32 {
        unsafe {
            if idx >= v8c_fci_length(self.ptr) { return defaultVal }
            let arg = v8c_fci_arg(self.ptr, idx)
            let iso = v8c_fci_isolate(self.ptr)
            var out: i32 = defaultVal
            v8c_to_int32(iso, arg, &out)
            return out
        }
    }
}

// --- Isolate: value constructors ---

impl Isolate {
    fn int32(self: Isolate, val: i32): Value {
        unsafe { return Value { slot: v8c_int32(self.ptr, val) } }
    }

    fn number(self: Isolate, val: f64): Value {
        unsafe { return Value { slot: v8c_number(self.ptr, val) } }
    }

    fn string(self: Isolate, data: *u8): Value {
        unsafe { return Value { slot: v8c_string_utf8(self.ptr, data) } }
    }

    fn stringLen(self: Isolate, data: *u8, len: i32): Value {
        unsafe { return Value { slot: v8c_string_utf8_len(self.ptr, data, len) } }
    }

    fn object(self: Isolate): Value {
        unsafe { return Value { slot: v8c_object_new(self.ptr) } }
    }

    fn array(self: Isolate, length: i32): Value {
        unsafe { return Value { slot: v8c_array_new(self.ptr, length) } }
    }

    fn undefined(self: Isolate): Value {
        unsafe { return Value { slot: v8c_undefined(self.ptr) } }
    }

    fn trueVal(self: Isolate): Value {
        unsafe { return Value { slot: v8c_true(self.ptr) } }
    }

    fn falseVal(self: Isolate): Value {
        unsafe { return Value { slot: v8c_false(self.ptr) } }
    }

    fn bigintI64(self: Isolate, val: i64): Value {
        unsafe { return Value { slot: v8c_bigint_i64(self.ptr, val) } }
    }

    fn symbolNew(self: Isolate, desc: *u8): Value {
        unsafe { return Value { slot: v8c_symbol_new(self.ptr, desc) } }
    }

    fn arraybufferNew(self: Isolate, size: i64): Value {
        unsafe { return Value { slot: v8c_arraybuffer_new(self.ptr, size) } }
    }

    fn uint32arrayNew(self: Isolate, ab: Value, offset: i64, length: i64): Value {
        unsafe { return Value { slot: v8c_uint32array_new(self.ptr, ab.slot, offset, length) } }
    }

    fn biguint64arrayNew(self: Isolate, ab: Value, offset: i64, length: i64): Value {
        unsafe { return Value { slot: v8c_biguint64array_new(self.ptr, ab.slot, offset, length) } }
    }
}

// --- Value: type checks + extractors ---

impl Value {
    fn isObject(self: Value, iso: Isolate): i32 {
        unsafe { return v8c_value_is_object(iso.ptr, self.slot) }
    }

    fn isFunction(self: Value, iso: Isolate): i32 {
        unsafe { return v8c_value_is_function(iso.ptr, self.slot) }
    }

    fn isString(self: Value, iso: Isolate): i32 {
        unsafe { return v8c_value_is_string(iso.ptr, self.slot) }
    }

    fn isNumber(self: Value, iso: Isolate): i32 {
        unsafe { return v8c_value_is_number(iso.ptr, self.slot) }
    }

    fn isArray(self: Value, iso: Isolate): i32 {
        unsafe { return v8c_value_is_array(iso.ptr, self.slot) }
    }

    fn isNullOrUndefined(self: Value, iso: Isolate): i32 {
        unsafe { return v8c_value_is_null_or_undefined(iso.ptr, self.slot) }
    }

    fn toI32(self: Value, iso: Isolate, out: *i32): i32 {
        unsafe { return v8c_to_int32(iso.ptr, self.slot, out) }
    }

    fn toF64(self: Value, iso: Isolate, out: *f64): i32 {
        unsafe { return v8c_to_double(iso.ptr, self.slot, out) }
    }

    fn writeUtf8(self: Value, iso: Isolate, buf: *u8, bufsize: i32): i32 {
        unsafe { return v8c_string_write_utf8(iso.ptr, self.slot, buf, bufsize) }
    }

    fn arrayLength(self: Value, iso: Isolate): i32 {
        unsafe { return v8c_array_length(iso.ptr, self.slot) }
    }
}

// --- Context: object/function/script ops ---

impl Context {
    fn global(self: Context): Value {
        unsafe { return Value { slot: v8c_context_global(self.ptr) } }
    }

    fn objectSet(self: Context, obj: Value, key: *u8, val: Value): i32 {
        unsafe { return v8c_object_set(self.ptr, obj.slot, key, val.slot) }
    }

    fn objectGet(self: Context, obj: Value, key: *u8): Value {
        unsafe { return Value { slot: v8c_object_get(self.ptr, obj.slot, key) } }
    }

    fn objectSetIndex(self: Context, obj: Value, idx: u32, val: Value): i32 {
        unsafe { return v8c_object_set_index(self.ptr, obj.slot, idx, val.slot) }
    }

    fn objectGetIndex(self: Context, obj: Value, idx: u32): Value {
        unsafe { return Value { slot: v8c_object_get_index(self.ptr, obj.slot, idx) } }
    }

    fn functionNew(self: Context, cb: *u8, data: *u8): Value {
        unsafe { return Value { slot: v8c_function_new(self.ptr, cb, data) } }
    }

    fn getPropertyNames(self: Context, obj: Value, filter: i32): Value {
        unsafe { return Value { slot: v8c_object_get_property_names(self.ptr, obj.slot, filter) } }
    }

    fn compileRun(self: Context, source: *u8, sourceLen: i32, filename: *u8): Value {
        unsafe { return Value { slot: v8c_script_compile_run(self.ptr, source, sourceLen, filename) } }
    }

    fn setMethod(self: Context, obj: Value, name: *u8, cb: *u8): void {
        unsafe {
            let fnVal = v8c_function_new(self.ptr, cb, 0 as *u8)
            v8c_object_set(self.ptr, obj.slot, name, fnVal)
        }
    }
}

