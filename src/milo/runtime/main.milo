// Milo runtime spine — V8 bootstrap with binding registry + file loading
// Phase 3b: internalBinding(), require() shim, file execution

// POSIX — declared directly (Milo stdlib duplicate symbol issue, needs linkonce_odr)
extern fn write(fd: i32, buf: *u8, len: i64): i64
extern fn read(fd: i32, buf: *u8, len: i64): i64
extern fn open(path: *u8, flags: i32): i32
extern fn close(fd: i32): i32
extern fn lseek(fd: i32, offset: i64, whence: i32): i64
extern fn exit(code: i32): void
extern fn strlen(s: *u8): i64
extern fn malloc(size: i64): *u8
extern fn free(ptr: *u8): void
extern fn getpid(): i32
extern fn getppid(): i32
extern fn getcwd(buf: *u8, size: i64): *u8

// --- Binding registry ---
extern fn nm_binding_register(name: *u8, init: *u8): void
extern fn nm_internal_binding(info: *u8, ud: *u8): void

// --- Binding init functions ---
extern fn nm_init_os(iso: *u8, ctx: *u8, exports: i32): void
extern fn nm_init_env(iso: *u8, ctx: *u8, exports: i32): void
extern fn nm_init_fs(iso: *u8, ctx: *u8, exports: i32): void
extern fn nm_init_process_methods(iso: *u8, ctx: *u8, exports: i32): void
extern fn nm_init_util(iso: *u8, ctx: *u8, exports: i32): void
extern fn nm_init_buffer(iso: *u8, ctx: *u8, exports: i32): void

// --- v8capi FFI ---
extern fn v8c_platform_init(execPath: *u8): i32
extern fn v8c_platform_shutdown(): void
extern fn v8c_isolate_new(): *u8
extern fn v8c_isolate_dispose(iso: *u8): void
extern fn v8c_isolate_enter(iso: *u8): void
extern fn v8c_isolate_exit(iso: *u8): void
extern fn v8c_handle_scope_new(iso: *u8): *u8
extern fn v8c_handle_scope_delete(hs: *u8): void
extern fn v8c_context_new(iso: *u8): *u8
extern fn v8c_context_dispose(ctx: *u8): void
extern fn v8c_context_enter(ctx: *u8): void
extern fn v8c_context_exit(ctx: *u8): void
extern fn v8c_script_compile_run(ctx: *u8, source: *u8, source_len: i32, filename: *u8): i32
extern fn v8c_string_write_utf8(iso: *u8, val: i32, buf: *u8, bufsize: i32): i32
extern fn v8c_to_double(iso: *u8, val: i32, out: *f64): i32
extern fn v8c_value_is_string(iso: *u8, val: i32): i32
extern fn v8c_value_is_number(iso: *u8, val: i32): i32
extern fn v8c_value_is_null_or_undefined(iso: *u8, val: i32): i32
extern fn v8c_object_new(iso: *u8): i32
extern fn v8c_object_set(ctx: *u8, obj: i32, key: *u8, val: i32): i32
extern fn v8c_function_new(ctx: *u8, cb: *u8, data: *u8): i32
extern fn v8c_context_global(ctx: *u8): i32
extern fn v8c_int32(iso: *u8, val: i32): i32
extern fn v8c_string_utf8(iso: *u8, data: *u8): i32
extern fn v8c_string_utf8_len(iso: *u8, data: *u8, len: i32): i32
extern fn v8c_try_catch_new(iso: *u8): *u8
extern fn v8c_try_catch_delete(tc: *u8): void
extern fn v8c_try_catch_has_caught(tc: *u8): i32
extern fn v8c_try_catch_message(tc: *u8): i32
extern fn v8c_array_new(iso: *u8, length: i32): i32
extern fn v8c_object_set_index(ctx: *u8, obj: i32, idx: u32, val: i32): i32
extern fn v8c_fci_length(info: *u8): i32
extern fn v8c_fci_arg(info: *u8, idx: i32): i32
extern fn v8c_fci_isolate(info: *u8): *u8
extern fn v8c_fci_context(info: *u8): *u8
extern fn v8c_fci_return(info: *u8, val: i32): void

fn printStr(s: *u8): void {
    unsafe {
        let len = strlen(s)
        write(1, s, len)
    }
}

fn printErr(s: *u8): void {
    unsafe {
        let len = strlen(s)
        write(2, s, len)
    }
}

fn printVal(iso: *u8, val: i32): void {
    unsafe {
        if v8c_value_is_null_or_undefined(iso, val) != 0 {
            printStr("undefined\n")
            return
        }

        if v8c_value_is_string(iso, val) != 0 {
            var buf: [u8; 4096] = [0; 4096]
            let len = v8c_string_write_utf8(iso, val, buf as *u8, 4096)
            if len > 0 {
                write(1, buf as *u8, len as i64)
                write(1, "\n", 1)
            }
            return
        }

        if v8c_value_is_number(iso, val) != 0 {
            var d: f64 = 0.0
            v8c_to_double(iso, val, &d)
            let i = d as i64
            if i as f64 == d {
                var nbuf: [u8; 32] = [0; 32]
                let len = i64ToStr(i, nbuf as *u8, 32)
                write(1, nbuf as *u8, len as i64)
                write(1, "\n", 1)
            } else {
                printStr("<number>\n")
            }
            return
        }

        printStr("[object]\n")
    }
}

fn i64ToStr(val: i64, buf: *u8, _bufsize: i32): i32 {
    unsafe {
        var n = val
        if n == 0 {
            buf[0] = 48
            return 1
        }

        var neg = false
        if n < 0 {
            neg = true
            n = 0 - n
        }

        var tmp: [u8; 32] = [0; 32]
        var i: i64 = 0
        while n > 0 {
            tmp[i] = (48 + (n % 10) as i32) as u8
            n = n / 10
            i = i + 1
        }

        var pos: i64 = 0
        if neg {
            buf[0] = 45
            pos = 1
        }

        var j = i - 1
        while j >= 0 {
            buf[pos] = tmp[j]
            pos = pos + 1
            j = j - 1
        }

        return pos as i32
    }
}

// Read file into malloc'd buffer. Returns ptr (caller frees) and sets *out_len.
// Returns null on failure.
fn readFile(path: *u8, out_len: *i64): *u8 {
    unsafe {
        // O_RDONLY = 0
        let fd = open(path, 0)
        if fd < 0 { return 0 as *u8 }

        // SEEK_END = 2, SEEK_SET = 0
        let size = lseek(fd, 0, 2)
        if size < 0 {
            close(fd)
            return 0 as *u8
        }
        lseek(fd, 0, 0)

        let buf = malloc(size + 1)
        if buf as i64 == 0 {
            close(fd)
            return 0 as *u8
        }

        var total: i64 = 0
        while total < size {
            let ptr = (buf as i64 + total) as *u8
            let n = read(fd, ptr, size - total)
            if n <= 0 { break }
            total = total + n
        }
        buf[total] = 0
        out_len[0] = total
        close(fd)
        return buf
    }
}

// V8 callback: load and evaluate a JS file, return its module.exports
// Called as: __loadBuiltin(filename) from JS
fn nativeLoadBuiltin(info: *u8, _ud: *u8): void {
    unsafe {
        if v8c_fci_length(info) < 1 { return }
        let iso = v8c_fci_isolate(info)
        let ctx = v8c_fci_context(info)
        let arg = v8c_fci_arg(info, 0)

        // Get filename string
        var nameBuf: [u8; 512] = [0; 512]
        let nameLen = v8c_string_write_utf8(iso, arg, nameBuf as *u8, 512)
        if nameLen <= 0 { return }

        // Build path: LIB_DIR + "/" + name + ".js"
        var pathBuf: [u8; 1024] = [0; 1024]
        let libDir = nm_get_lib_dir()
        let libLen = strlen(libDir)
        var pos: i32 = 0
        var j: i32 = 0
        while j < libLen as i32 {
            pathBuf[j as i64] = libDir[j as i64]
            j = j + 1
        }
        pos = j
        pathBuf[pos as i64] = 47  // '/'
        pos = pos + 1
        j = 0
        while j < nameLen && nameBuf[j as i64] != 0 {
            pathBuf[pos as i64] = nameBuf[j as i64]
            pos = pos + 1
            j = j + 1
        }
        // Append .js
        pathBuf[pos as i64] = 46   // '.'
        pos = pos + 1
        pathBuf[pos as i64] = 106  // 'j'
        pos = pos + 1
        pathBuf[pos as i64] = 115  // 's'
        pos = pos + 1
        pathBuf[pos as i64] = 0

        // Read file and return source as string
        var fileLen: [i64; 1] = [0]
        let source = readFile(pathBuf as *u8, fileLen as *i64)
        if source as i64 == 0 { return }

        let str_val = v8c_string_utf8_len(iso, source, fileLen[0] as i32)
        free(source)
        if str_val >= 0 {
            v8c_fci_return(info, str_val)
        }
    }
}

// Stored externally in C (module-level vars not allowed in Milo)
extern fn nm_set_lib_dir(dir: *u8): void
extern fn nm_get_lib_dir(): *u8

fn registerBuiltinBindings(): void {
    unsafe {
        nm_binding_register("os", nm_init_os as *u8)
        nm_binding_register("env", nm_init_env as *u8)
        nm_binding_register("fs", nm_init_fs as *u8)
        nm_binding_register("process_methods", nm_init_process_methods as *u8)
        nm_binding_register("util", nm_init_util as *u8)
        nm_binding_register("buffer", nm_init_buffer as *u8)
    }
}

extern fn v8c_fci_return_string(info: *u8, str: *u8): void

extern fn v8c_to_int32(iso: *u8, val: i32, out: *i32): i32

fn processCwd(info: *u8, _ud: *u8): void {
    var buf: [u8; 4096] = [0; 4096]
    unsafe {
        let r = getcwd(buf as *u8, 4096)
        if r as i64 != 0 {
            v8c_fci_return_string(info, buf as *u8)
        }
    }
}

fn processExit(info: *u8, _ud: *u8): void {
    unsafe {
        var code: i32 = 0
        if v8c_fci_length(info) > 0 {
            let iso = v8c_fci_isolate(info)
            let arg = v8c_fci_arg(info, 0)
            v8c_to_int32(iso, arg, &code)
        }
        exit(code)
    }
}

fn setupProcessObject(iso: *u8, ctx: *u8, argc: i32, argv: *i64): i32 {
    unsafe {
        let proc = v8c_object_new(iso)
        v8c_object_set(ctx, proc, "pid", v8c_int32(iso, getpid()))
        v8c_object_set(ctx, proc, "ppid", v8c_int32(iso, getppid()))
        v8c_object_set(ctx, proc, "platform", v8c_string_utf8(iso, "darwin"))
        v8c_object_set(ctx, proc, "version", v8c_string_utf8(iso, "v27.0.0-milo"))

        // process.argv
        let arr = v8c_array_new(iso, argc)
        var i: i32 = 0
        while i < argc {
            let arg = (argv as *i64)[i as i64] as *u8
            v8c_object_set_index(ctx, arr, i as u32, v8c_string_utf8(iso, arg))
            i = i + 1
        }
        v8c_object_set(ctx, proc, "argv", arr)

        // process.cwd() / process.exit() / process.env proxy
        let cwd_fn = v8c_function_new(ctx, processCwd as *u8, 0 as *u8)
        v8c_object_set(ctx, proc, "cwd", cwd_fn)
        let exit_fn = v8c_function_new(ctx, processExit as *u8, 0 as *u8)
        v8c_object_set(ctx, proc, "exit", exit_fn)

        return proc
    }
}

// Bootstrap JS: defines console.log and require()
fn runBootstrap(iso: *u8, ctx: *u8): i32 {
    unsafe {
        let bootstrap = "(function() {
  // primordials — frozen copies of built-in prototypes
  // Node's lib/*.js use these to protect against prototype pollution
  const primordials = {};
  const _pSrc = __loadBuiltin('internal/per_context/primordials');
  if (_pSrc) {
    (new Function('primordials', _pSrc))(primordials);
  }
  globalThis.primordials = primordials;

  // Register constants binding (pure JS data)
  const _constants = {
    os: {
      signals: {
        SIGHUP:1, SIGINT:2, SIGQUIT:3, SIGILL:4, SIGTRAP:5, SIGABRT:6,
        SIGFPE:8, SIGKILL:9, SIGBUS:10, SIGSEGV:11, SIGSYS:12, SIGPIPE:13,
        SIGALRM:14, SIGTERM:15, SIGURG:16, SIGSTOP:17, SIGTSTP:18,
        SIGCONT:19, SIGCHLD:20, SIGTTIN:21, SIGTTOU:22, SIGIO:23,
        SIGXCPU:24, SIGXFSZ:25, SIGVTALRM:26, SIGPROF:27, SIGINFO:29,
        SIGUSR1:30, SIGUSR2:31,
      },
      errno: {
        E2BIG:7, EACCES:13, EADDRINUSE:48, EADDRNOTAVAIL:49,
        EAGAIN:35, EALREADY:37, EBADF:9, EBUSY:16, ECANCELED:89,
        ECHILD:10, ECONNABORTED:53, ECONNREFUSED:61, ECONNRESET:54,
        EDEADLK:11, EDESTADDRREQ:39, EDOM:33, EEXIST:17, EFAULT:14,
        EFBIG:27, EHOSTUNREACH:65, EINPROGRESS:36, EINTR:4, EINVAL:22,
        EIO:5, EISCONN:56, EISDIR:21, ELOOP:62, EMFILE:24, EMLINK:31,
        EMSGSIZE:40, ENAMETOOLONG:63, ENETDOWN:50, ENETUNREACH:51,
        ENFILE:23, ENOBUFS:55, ENODEV:19, ENOENT:2, ENOMEM:12,
        ENOSPC:28, ENOSYS:78, ENOTCONN:57, ENOTDIR:20, ENOTEMPTY:66,
        ENOTSOCK:38, ENOTSUP:45, EPERM:1, EPIPE:32, ERANGE:34,
        EROFS:30, ESPIPE:29, ESRCH:3, ETIMEDOUT:60, EXDEV:18,
      },
      priority: {
        PRIORITY_LOW:19, PRIORITY_BELOW_NORMAL:10, PRIORITY_NORMAL:0,
        PRIORITY_ABOVE_NORMAL:-7, PRIORITY_HIGH:-14, PRIORITY_HIGHEST:-20,
      },
    },
    fs: {
      O_RDONLY:0, O_WRONLY:1, O_RDWR:2, O_CREAT:512, O_EXCL:2048,
      O_TRUNC:1024, O_APPEND:8, O_DIRECTORY:1048576, O_NOFOLLOW:256,
      O_SYNC:128, O_SYMLINK:2097152, O_NONBLOCK:4,
      S_IFMT:61440, S_IFREG:32768, S_IFDIR:16384, S_IFLNK:40960,
      S_IFCHR:8192, S_IFBLK:24576, S_IFIFO:4096, S_IFSOCK:49152,
      S_IRWXU:448, S_IRUSR:256, S_IWUSR:128, S_IXUSR:64,
      S_IRWXG:56, S_IRGRP:32, S_IWGRP:16, S_IXGRP:8,
      S_IRWXO:7, S_IROTH:4, S_IWOTH:2, S_IXOTH:1,
      F_OK:0, R_OK:4, W_OK:2, X_OK:1,
      UV_FS_COPYFILE_EXCL:1, UV_FS_COPYFILE_FICLONE:2,
      COPYFILE_EXCL:1, COPYFILE_FICLONE:2,
    },
  };
  // types binding — V8 type checks via JS
  const _types = {
    isDate: (v) => v instanceof Date,
    isMap: (v) => v instanceof Map,
    isSet: (v) => v instanceof Set,
    isWeakMap: (v) => v instanceof WeakMap,
    isWeakSet: (v) => v instanceof WeakSet,
    isRegExp: (v) => v instanceof RegExp,
    isPromise: (v) => v instanceof Promise,
    isNativeError: (v) => v instanceof Error,
    isArrayBuffer: (v) => v instanceof ArrayBuffer,
    isSharedArrayBuffer: (v) => typeof SharedArrayBuffer !== 'undefined' && v instanceof SharedArrayBuffer,
    isProxy: (v) => false,
    isExternal: (v) => false,
    isAnyArrayBuffer: (v) => v instanceof ArrayBuffer || (typeof SharedArrayBuffer !== 'undefined' && v instanceof SharedArrayBuffer),
    isTypedArray: (v) => ArrayBuffer.isView(v) && !(v instanceof DataView),
    isDataView: (v) => v instanceof DataView,
  };

  // JS-defined bindings
  const _mksnapshot = { isBuildingSnapshotBuffer: new Uint8Array(1) };
  const _jsBindings = { constants: _constants, types: _types, mksnapshot: _mksnapshot };
  const _origInternalBinding = internalBinding;
  const _emptyBinding = Object.freeze(Object.create(null));
  globalThis.internalBinding = function(name) {
    if (_jsBindings[name]) return _jsBindings[name];
    try { return _origInternalBinding(name); }
    catch(e) { return _emptyBinding; }
  };
  globalThis.getInternalBinding = globalThis.internalBinding;

  // Minimal stubs for internal modules needed by lib/*.js
  const _internalModules = {
    'internal/util': {
      isWindows: process.platform === 'win32',
      isMacOS: process.platform === 'darwin',
      getLazy(init) { let v; return () => (v ??= init()); },
      spliceOne(list, idx) { for (let i=idx; i<list.length-1; i++) list[i]=list[i+1]; list.pop(); },
      kEmptyObject: Object.freeze(Object.create(null)),
      normalizeEncoding(enc) {
        if (!enc || enc === 'utf8' || enc === 'utf-8') return 'utf8';
        return enc.toLowerCase();
      },
      isError(e) { return e instanceof Error; },
      setOwnProperty(obj, key, val) { Object.defineProperty(obj, key, {value:val, writable:true, enumerable:true, configurable:true}); },
    },
    'internal/validators': {
      validateString(v, name) { if (typeof v !== 'string') throw new TypeError(name + ' must be a string'); },
      validateObject(v, name, opts) { if (typeof v !== 'object' || v === null) throw new TypeError(name + ' must be an object'); },
      validateInt32(v, name) { if (typeof v !== 'number' || v !== (v|0)) throw new RangeError(name + ' must be a 32-bit integer'); },
      validateFunction(v, name) { if (typeof v !== 'function') throw new TypeError(name + ' must be a function'); },
      validateBoolean(v, name) { if (typeof v !== 'boolean') throw new TypeError(name + ' must be a boolean'); },
      validateNumber(v, name) { if (typeof v !== 'number') throw new TypeError(name + ' must be a number'); },
      validateOneOf(v, name, oneOf) { if (!oneOf.includes(v)) throw new TypeError(name + ' must be one of: ' + oneOf.join(', ')); },
      validateAbortSignal(v, name) {},
    },
    'internal/util/types': _types,
    'internal/assert': function assert(cond, msg) { if (!cond) throw new Error(msg || 'assertion failed'); },
    'internal/bootstrap/realm': {
      BuiltinModule: {
        normalizeRequirableId(id) { return id; },
        isBuiltin(id) { return false; },
        map: new Map(),
      },
    },
    'internal/events/abort_listener': {
      addAbortListener(signal, listener) { if (signal) signal.addEventListener('abort', listener, {once: true}); return { [Symbol.dispose]() {} }; },
    },
  };
  // Pre-seed module cache with internal stubs
  globalThis.__internalModules = _internalModules;

  // process stubs that need JS-level implementation
  process.emitWarning = function(msg) { console.error('Warning:', msg); };
  process.env = new Proxy({}, {
    get(_, key) { return internalBinding('env').get(String(key)); },
    has(_, key) { return internalBinding('env').get(String(key)) !== undefined; },
  });

  // console.log/error/warn
  globalThis.console = {
    log(...args) {
      const s = args.map(a => typeof a === 'object' ? JSON.stringify(a) : String(a)).join(' ');
      internalBinding('_console').write(s + '\\n');
    },
    error(...args) {
      const s = args.map(a => typeof a === 'object' ? JSON.stringify(a) : String(a)).join(' ');
      internalBinding('_console').writeError(s + '\\n');
    },
    warn(...args) { console.error(...args); },
  };

  // require() shim — wraps internalBinding with Node-compatible API
  const moduleCache = {};
  const moduleFactories = {
    os() {
      const b = internalBinding('os');
      return {
        hostname: () => b.getHostname(),
        cpus: () => ({ length: b.getAvailableParallelism() }),
        availableParallelism: () => b.getAvailableParallelism(),
        freemem: () => b.getFreeMem(),
        totalmem: () => b.getTotalMem(),
        uptime: () => b.getUptime(),
        loadavg: () => [b.getLoadAvg1(), b.getLoadAvg5(), b.getLoadAvg15()],
        release: () => b.getOsRelease(),
        pid: process.pid,
        platform: 'darwin',
        type: () => 'Darwin',
        arch: 'arm64',
        homedir: () => internalBinding('env').get('HOME') || '/',
        tmpdir: () => internalBinding('env').get('TMPDIR') || '/tmp',
      };
    },
    process() { return internalBinding('process_methods'); },
    fs() {
      const b = internalBinding('fs');
      return {
        readFileSync(path, opts) {
          const enc = typeof opts === 'string' ? opts : (opts && opts.encoding);
          const r = b.readFile(String(path));
          if (r === -1) throw new Error('ENOENT: no such file: ' + path);
          return r;
        },
        writeFileSync(path, data) {
          const r = b.writeFile(String(path), String(data));
          if (r === -1) throw new Error('EIO: write failed: ' + path);
        },
        statSync(path) {
          const s = b.stat(String(path));
          if (s === -1) throw new Error('ENOENT: no such file: ' + path);
          return { ...s, isFile: () => !!s.isFile, isDirectory: () => !!s.isDirectory };
        },
        existsSync(path) { return !!b.exists(String(path)); },
        mkdirSync(path, opts) {
          const mode = (opts && opts.mode) || 0o777;
          const r = b.mkdir(String(path), mode);
          if (r !== 0) throw new Error('EEXIST: mkdir failed: ' + path);
        },
        unlinkSync(path) { b.unlink(String(path)); },
        rmdirSync(path) { b.rmdir(String(path)); },
        renameSync(old, n) { b.rename(String(old), String(n)); },
        readdirSync(path) { return b.readdir(String(path)) || []; },
        realpathSync(path) { return b.realpath(String(path)); },
        chmodSync(path, mode) { b.chmod(String(path), mode); },
      };
    },
  };
  globalThis.require = function require(id) {
    if (moduleCache[id]) return moduleCache[id];
    if (moduleFactories[id]) {
      moduleCache[id] = moduleFactories[id]();
      return moduleCache[id];
    }
    // Internal module stubs
    if (__internalModules[id]) {
      moduleCache[id] = __internalModules[id];
      return moduleCache[id];
    }
    // Try loading from lib/ as CJS module first
    const src = __loadBuiltin(id);
    if (src !== undefined) {
      const mod = { exports: {} };
      const wrapped = new Function('exports', 'require', 'module', '__filename', '__dirname', 'primordials', src);
      wrapped(mod.exports, require, mod, id, '', primordials);
      moduleCache[id] = mod.exports;
      return mod.exports;
    }
    // Fall back to native bindings
    const binding = internalBinding(id);
    if (binding !== _emptyBinding) {
      moduleCache[id] = binding;
      return binding;
    }
    throw new Error('Cannot find module \\'' + id + '\\'');
  };
})();"
        let len = strlen(bootstrap) as i32
        return v8c_script_compile_run(ctx, bootstrap, len, "[bootstrap]")
    }
}

// V8 callback: console write to stdout
fn consoleWrite(info: *u8, _ud: *u8): void {
    unsafe {
        if v8c_fci_length(info) < 1 { return }
        let iso = v8c_fci_isolate(info)
        let arg = v8c_fci_arg(info, 0)
        var buf: [u8; 8192] = [0; 8192]
        let len = v8c_string_write_utf8(iso, arg, buf as *u8, 8192)
        if len > 0 {
            write(1, buf as *u8, len as i64)
        }
    }
}

// V8 callback: console write to stderr
fn consoleWriteError(info: *u8, _ud: *u8): void {
    unsafe {
        if v8c_fci_length(info) < 1 { return }
        let iso = v8c_fci_isolate(info)
        let arg = v8c_fci_arg(info, 0)
        var buf: [u8; 8192] = [0; 8192]
        let len = v8c_string_write_utf8(iso, arg, buf as *u8, 8192)
        if len > 0 {
            write(2, buf as *u8, len as i64)
        }
    }
}

extern fn strcmp(a: *u8, b: *u8): i32

fn milo_node_main(argc: i32, argv: *i64): i32 {
    unsafe {
        var script: *u8 = 0 as *u8
        var scriptFile: *u8 = 0 as *u8
        var isEval = false
        var printResult = false
        var i: i64 = 1
        let ac = argc as i64
        while i < ac {
            let arg = argv[i] as *u8
            if strcmp(arg, "-e") == 0 || strcmp(arg, "--eval") == 0 {
                if i + 1 < ac {
                    script = argv[i + 1] as *u8
                    isEval = true
                }
                break
            }
            if strcmp(arg, "-p") == 0 || strcmp(arg, "--print") == 0 {
                if i + 1 < ac {
                    script = argv[i + 1] as *u8
                    isEval = true
                    printResult = true
                }
                break
            }
            if arg[0] != 45 {
                scriptFile = arg
                break
            }
            i = i + 1
        }

        if script as i64 == 0 && scriptFile as i64 == 0 {
            printStr("usage: milo-node [-e '<script>' | -p '<expr>' | <file.js>]\n")
            return 1
        }

        // Read file if needed
        var fileBuf: *u8 = 0 as *u8
        var fileLen: [i64; 1] = [0]
        if scriptFile as i64 != 0 {
            fileBuf = readFile(scriptFile, fileLen as *i64)
            if fileBuf as i64 == 0 {
                printErr("error: cannot read file: ")
                printErr(scriptFile)
                printErr("\n")
                return 1
            }
            script = fileBuf
        }

        registerBuiltinBindings()

        // Set lib dir for builtin JS module loading
        // Derive from execPath: strip last 3 components (out/Release/milo-node) to get repo root
        let exec = argv[0] as *u8
        var libPath: [u8; 1024] = [0; 1024]
        let execLen = strlen(exec)
        // Copy exec path
        var k: i64 = 0
        while k < execLen {
            libPath[k] = exec[k]
            k = k + 1
        }
        // Walk back 3 slashes to get repo root
        var slashes: i32 = 0
        while k > 0 && slashes < 3 {
            k = k - 1
            if libPath[k] == 47 { slashes = slashes + 1 }
        }
        if slashes == 3 {
            libPath[k] = 47  // '/'
            libPath[k + 1] = 108  // 'l'
            libPath[k + 2] = 105  // 'i'
            libPath[k + 3] = 98  // 'b'
            libPath[k + 4] = 0
            nm_set_lib_dir(libPath as *u8)
        }

        // Boot V8
        let execPath = argv[0] as *u8
        if v8c_platform_init(execPath) != 0 {
            printErr("error: v8c_platform_init failed\n")
            return 1
        }

        let iso = v8c_isolate_new()
        if iso as i64 == 0 {
            printErr("error: v8c_isolate_new failed\n")
            return 1
        }

        v8c_isolate_enter(iso)
        let hs = v8c_handle_scope_new(iso)
        let ctx = v8c_context_new(iso)
        v8c_context_enter(ctx)

        // Expose internalBinding(), __loadBuiltin() and process on global
        let global = v8c_context_global(ctx)
        let ib_fn = v8c_function_new(ctx, nm_internal_binding as *u8, 0 as *u8)
        v8c_object_set(ctx, global, "internalBinding", ib_fn)
        let lb_fn = v8c_function_new(ctx, nativeLoadBuiltin as *u8, 0 as *u8)
        v8c_object_set(ctx, global, "__loadBuiltin", lb_fn)

        // Register _console binding (used by bootstrap's console.log)
        nm_binding_register("_console", nm_init_console as *u8)

        let proc = setupProcessObject(iso, ctx, argc, argv)
        v8c_object_set(ctx, global, "process", proc)

        // Run bootstrap (defines console.log, require)
        let tc = v8c_try_catch_new(iso)
        let bootResult = runBootstrap(iso, ctx)
        if bootResult < 0 {
            printErr("error: bootstrap failed\n")
            if v8c_try_catch_has_caught(tc) != 0 {
                let msg = v8c_try_catch_message(tc)
                if msg >= 0 {
                    var mbuf: [u8; 4096] = [0; 4096]
                    let mlen = v8c_string_write_utf8(iso, msg, mbuf as *u8, 4096)
                    if mlen > 0 {
                        write(2, mbuf as *u8, mlen as i64)
                        write(2, "\n", 1)
                    }
                }
            }
            v8c_try_catch_delete(tc)
            v8c_context_exit(ctx)
            v8c_handle_scope_delete(hs)
            v8c_context_dispose(ctx)
            v8c_isolate_exit(iso)
            v8c_isolate_dispose(iso)
            v8c_platform_shutdown()
            return 1
        }
        v8c_try_catch_delete(tc)

        // Run user script
        let scriptLen = strlen(script) as i32

        let tc2 = v8c_try_catch_new(iso)
        var result: i32 = -1
        if scriptFile as i64 != 0 {
            result = v8c_script_compile_run(ctx, script, scriptLen, scriptFile)
        } else {
            result = v8c_script_compile_run(ctx, script, scriptLen, "[eval]")
        }

        if result < 0 || v8c_try_catch_has_caught(tc2) != 0 {
            let msg = v8c_try_catch_message(tc2)
            if msg >= 0 {
                var mbuf: [u8; 4096] = [0; 4096]
                let mlen = v8c_string_write_utf8(iso, msg, mbuf as *u8, 4096)
                if mlen > 0 {
                    write(2, mbuf as *u8, mlen as i64)
                    write(2, "\n", 1)
                }
            } else {
                printErr("error: script execution failed\n")
            }
        } else {
            if printResult && result >= 0 {
                printVal(iso, result)
            }
        }

        v8c_try_catch_delete(tc2)

        // Cleanup
        if fileBuf as i64 != 0 {
            free(fileBuf)
        }
        v8c_context_exit(ctx)
        v8c_handle_scope_delete(hs)
        v8c_context_dispose(ctx)
        v8c_isolate_exit(iso)
        v8c_isolate_dispose(iso)
        v8c_platform_shutdown()

        if result >= 0 { return 0 }
        return 1
    }
}

// _console binding init — provides write/writeError for bootstrap's console
fn nm_init_console(iso: *u8, ctx: *u8, exports: i32): void {
    unsafe {
        let w_fn = v8c_function_new(ctx, consoleWrite as *u8, 0 as *u8)
        let we_fn = v8c_function_new(ctx, consoleWriteError as *u8, 0 as *u8)
        v8c_object_set(ctx, exports, "write", w_fn)
        v8c_object_set(ctx, exports, "writeError", we_fn)
    }
}
