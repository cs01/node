// A cross-thread message queue node. Shared heap (NOT thread_local) — both the
// parent and worker thread touch the channel under its mutex.
extern struct WMsg {
    bytes: *u8,
    len: i64,
    sabs: *u8,
    next: *u8,
}

extern struct WChannel {
    mutexMem: [u8; 64],     // pthread_mutex_t
    threadMem: [u8; 8],     // pthread_t
    toWorkerHead: *u8,
    toWorkerTail: *u8,
    toParentHead: *u8,
    toParentTail: *u8,
    scriptPath: *u8,
    wdBytes: *u8,
    wdLen: i64,
    wdSabs: *u8,
    threadId: i32,
    doneFlag: i32,
    terminateFlag: i32,
    exitCode: i32,
    workerIso: *u8,
    isEval: i32,
}

fn printStr(s: *u8): void {
    
        let len = strlen(s)
        write(1, s, len)
    
}

fn printErr(s: *u8): void {
    
        let len = strlen(s)
        write(2, s, len)
    
}

fn printVal(iso: Isolate, val: Value): void {
    unsafe {
        if val.isNullOrUndefined(iso) != 0 {
            printStr("undefined\n" as *u8)
            return
        }

        if val.isString(iso) != 0 {
            var buf: [u8; 4096] = [0; 4096]
            let len = val.writeUtf8(iso, buf as *u8, 4096) - 1
            if len > 0 {
                write(1, buf as *u8, len as i64)
                write(1, "\n" as *u8, 1)
            }
            return
        }

        if val.isNumber(iso) != 0 {
            var d: f64 = 0.0
            val.toF64(iso, d.addrOf())
            let i = d as i64
            if i as f64 == d {
                var nbuf: [u8; 32] = [0; 32]
                let len = i64ToStr(i, nbuf as *u8, 32)
                write(1, nbuf as *u8, len as i64)
                write(1, "\n" as *u8, 1)
            } else {
                printStr("<number>\n" as *u8)
            }
            return
        }

        printStr("[object]\n" as *u8)
    }
}

fn i64ToStr(val: i64, buf: *u8, _bufsize: i32): i32 {
    
        var n = val
        if n == 0 {
            buf[0] = 48
            return 1
        }

        var neg = false
        if n < 0 {
            neg = true
            n = 0 - n
        }

        var tmp: [u8; 32] = [0; 32]
        var i: i64 = 0
        while n > 0 {
            tmp[i] = (48 + (n % 10) as i32) as u8
            n = n / 10
            i = i + 1
        }

        var pos: i64 = 0
        if neg {
            buf[0] = 45
            pos = 1
        }

        var j = i - 1
        while j >= 0 {
            buf[pos] = tmp[j]
            pos = pos + 1
            j = j - 1
        }

        return pos as i32
    
}

fn readFile(path: *u8, out_len: *i64): *u8 {
    unsafe {
        let fd = open(path, 0)
        if fd < 0 { return 0 as *u8 }

        let size = lseek(fd, 0, 2)
        if size < 0 {
            close(fd)
            return 0 as *u8
        }
        lseek(fd, 0, 0)

        let buf = malloc(size + 1)
        if buf as i64 == 0 {
            close(fd)
            return 0 as *u8
        }

        var total: i64 = 0
        while total < size {
            let ptr = (buf as i64 + total) as *u8
            let n = read(fd, ptr, size - total)
            if n <= 0 { break }
            total = total + n
        }
        buf[total] = 0
        out_len[0] = total
        close(fd)
        return buf
    }
}

fn nativeGc(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    let iso = ci.isolate()
     v8c_isolate_request_gc(iso.ptr) 
}

fn nativeLoadBuiltin(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    if ci.length() < 1 { return }
    let iso = ci.isolate()

    unsafe {
        let arg = ci.arg(0)
        var nameBuf: [u8; 512] = [0; 512]
        let nameLen = arg.writeUtf8(iso, nameBuf as *u8, 512)
        if nameLen <= 0 { return }

        var pathBuf: [u8; 1024] = [0; 1024]
        let libDir = nm_get_lib_dir()
        let libLen = strlen(libDir)
        var pos: i32 = 0
        var j: i32 = 0
        while j < libLen as i32 {
            pathBuf[j as i64] = libDir[j as i64]
            j = j + 1
        }
        pos = j
        pathBuf[pos as i64] = 47
        pos = pos + 1
        j = 0
        while j < nameLen && nameBuf[j as i64] != 0 {
            pathBuf[pos as i64] = nameBuf[j as i64]
            pos = pos + 1
            j = j + 1
        }
        pathBuf[pos as i64] = 46
        pos = pos + 1
        pathBuf[pos as i64] = 106
        pos = pos + 1
        pathBuf[pos as i64] = 115
        pos = pos + 1
        pathBuf[pos as i64] = 0

        var fileLen: [i64; 1] = [0]
        let source = readFile(pathBuf as *u8, fileLen as *i64)
        if source as i64 == 0 { return }

        let strVal = iso.stringLen(source, fileLen[0] as i32)
        free(source)
        if strVal.slot >= 0 {
            ci.ret(strVal)
        }
    }
}

fn registerBuiltinBindings(): void {
    unsafe {
        nm_binding_register("os" as *u8, nm_init_os as *u8)
        nm_binding_register("env" as *u8, nm_init_env as *u8)
        nm_binding_register("fs" as *u8, nm_init_fs as *u8)
        nm_binding_register("process_methods" as *u8, nm_init_process_methods as *u8)
        nm_binding_register("util" as *u8, nm_init_util as *u8)
        nm_binding_register("buffer" as *u8, nm_init_buffer as *u8)
        nm_binding_register("timers" as *u8, nm_init_timers as *u8)
        nm_binding_register("tcp" as *u8, nm_init_tcp as *u8)
        nm_binding_register("crypto" as *u8, nm_init_crypto as *u8)
        nm_binding_register("spawn" as *u8, nm_init_spawn as *u8)
        nm_binding_register("dns" as *u8, nm_init_dns as *u8)
        nm_binding_register("zlib" as *u8, nm_init_zlib as *u8)
        nm_binding_register("vm" as *u8, nm_init_vm as *u8)
        nm_binding_register("worker" as *u8, nm_init_worker as *u8)
    }
}

fn processCwd(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    var buf: [u8; 4096] = [0; 4096]
    unsafe {
        let r = getcwd(buf as *u8, 4096)
        if r as i64 != 0 {
            ci.retStr(buf as *u8)
        }
    }
}

fn processExit(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    let code = ci.i32Arg(0, 0)
     exit(code) 
}

fn setupProcessObject(iso: Isolate, ctx: Context, argc: i32, argv: *i64): Value {
    unsafe {
        let proc = iso.object()
        ctx.objectSet(proc, "pid" as *u8, iso.int32(getpid()))
        ctx.objectSet(proc, "ppid" as *u8, iso.int32(getppid()))
        ctx.objectSet(proc, "platform" as *u8, iso.string("darwin" as *u8))
        ctx.objectSet(proc, "arch" as *u8, iso.string("arm64" as *u8))
        ctx.objectSet(proc, "version" as *u8, iso.string("v27.0.0-milo" as *u8))

        let versions = iso.object()
        ctx.objectSet(versions, "node" as *u8, iso.string("27.0.0" as *u8))
        ctx.objectSet(versions, "v8" as *u8, iso.string("12.4.0" as *u8))
        ctx.objectSet(proc, "versions" as *u8, versions)

        let arr = iso.array(argc)
        for i in 0..argc {
            let arg = (argv as *i64)[i as i64] as *u8
            ctx.objectSetIndex(arr, i as u32, iso.string(arg))
        }
        ctx.objectSet(proc, "argv" as *u8, arr)

        ctx.setMethod(proc, "cwd" as *u8, processCwd as *u8)
        ctx.setMethod(proc, "exit" as *u8, processExit as *u8)

        return proc
    }
}

fn runBootstrap(ctx: Context, path: *u8): Value {
    unsafe {
        var fileLen: [i64; 1] = [0]
        let source = readFile(path, fileLen as *i64)
        if source as i64 == 0 {
            printErr("error: cannot read bootstrap: " as *u8)
            printErr(path)
            printErr("\n" as *u8)
            return Value { slot: -1 }
        }
        let result = ctx.compileRun(source, fileLen[0] as i32, path)
        free(source)
        return result
    }
}

// write() on a pipe may write fewer bytes than requested (pipe buffer full);
// loop until all bytes flushed so large stdout/stderr writes aren't truncated.
fn writeAllFd(fd: i32, buf: *u8, len: i64): void {
    var off: i64 = 0
    unsafe {
        while off < len {
            let n = write(fd, (buf as i64 + off) as *u8, len - off)
            if n <= 0 { break }
            off = off + n
        }
    }
}

fn consoleWriteFd(iso: Isolate, arg: Value, fd: i32): void {
    unsafe {
        // null buf => returns utf8 byte length (no terminator); size buffer to fit.
        let blen = arg.writeUtf8(iso, 0 as *u8, 0)
        if blen <= 0 { return }
        if blen < 8192 {
            var buf: [u8; 8192] = [0; 8192]
            let len = arg.writeUtf8(iso, buf as *u8, 8192) - 1
            if len > 0 { writeAllFd(fd, buf as *u8, len as i64) }
        } else {
            let heap = malloc((blen + 1) as i64)
            if heap as i64 != 0 {
                let len = arg.writeUtf8(iso, heap, blen + 1) - 1
                if len > 0 { writeAllFd(fd, heap, len as i64) }
                free(heap)
            }
        }
    }
}

fn consoleWrite(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    if ci.length() < 1 { return }
    consoleWriteFd(ci.isolate(), ci.arg(0), 1)
}

fn consoleWriteError(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    if ci.length() < 1 { return }
    consoleWriteFd(ci.isolate(), ci.arg(0), 2)
}

// TTY raw mode — save/restore termios (128 bytes covers macOS arm64 struct termios)
var _savedTermios: [u8; 128] = [0; 128]
var _termiosSaved: i32 = 0

fn ttySetRawMode(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    let fd = ci.i32Arg(0, 0)
    let enable = ci.i32Arg(1, 0)

    if enable != 0 {
        unsafe { tcgetattr(fd, _savedTermios as *u8) }
        _termiosSaved = 1
        var raw: [u8; 128] = [0; 128]
        for i in 0..128 {
            raw[i] = _savedTermios[i]
        }
        unsafe {
            cfmakeraw(raw as *u8)
            tcsetattr(fd, 0, raw as *u8)
        }
    } else {
        if _termiosSaved != 0 {
            unsafe { tcsetattr(fd, 0, _savedTermios as *u8) }
        }
    }
    ci.retI32(0)
}

fn ttyGetWindowSize(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    let iso = ci.isolate()
    let ctx = ci.context()
    let fd = ci.i32Arg(0, 1)
    // struct winsize: ws_row(u16), ws_col(u16), ws_xpixel(u16), ws_ypixel(u16) = 8 bytes
    var ws: [u8; 8] = [0; 8]
    // TIOCGWINSZ = 0x40087468 on macOS
    unsafe {
        let ret = ioctl(fd, 1074295912, ws as *u8)
        if ret < 0 {
            ci.retUndefined()
            return
        }
    }
    let row = (ws[0] as i32) | ((ws[1] as i32) << 8)
    let col = (ws[2] as i32) | ((ws[3] as i32) << 8)
    let arr = iso.array(2)
    
        ctx.objectSetIndex(arr, 0, iso.int32(col))
        ctx.objectSetIndex(arr, 1, iso.int32(row))
    
    ci.ret(arr)
}

fn consoleIsatty(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    let fd = ci.i32Arg(0, 0)
     ci.retI32(isatty(fd)) 
}

fn nm_init_console(_iso: *u8, ctx_ptr: *u8, exports: i32): void {
    let c = Context { ptr: ctx_ptr }
    let exp = Value { slot: exports }
    unsafe {
        c.setMethod(exp, "write" as *u8, consoleWrite as *u8)
        c.setMethod(exp, "writeError" as *u8, consoleWriteError as *u8)
        c.setMethod(exp, "isatty" as *u8, consoleIsatty as *u8)
        c.setMethod(exp, "setRawMode" as *u8, ttySetRawMode as *u8)
        c.setMethod(exp, "getWindowSize" as *u8, ttyGetWindowSize as *u8)
    }
}

extern fn v8c_to_bool(iso: *u8, val: i32, out: *i32): i32

var workerThreadIdCounter: i32 = 1
// Once a worker isolate has existed, skip the main thread's final V8 teardown:
// V8::Dispose asserts the isolate group's refcount, which multi-isolate trips.
// Process exit reclaims everything anyway (Node likewise often skips full teardown).
var gWorkersSpawned: i32 = 0

// Enqueue a serialized message. toParent != 0 → worker→parent queue, else parent→worker.
fn msgPush(chan: *WChannel, toParent: i32, bytes: *u8, len: i64, sabs: *u8): void {
    unsafe {
        let node = calloc(1, 40) as *WMsg
        node.bytes = bytes
        node.len = len
        node.sabs = sabs
        node.next = 0 as *u8
        pthread_mutex_lock(chan as *u8)
        if toParent != 0 {
            if chan.toParentTail as i64 == 0 {
                chan.toParentHead = node as *u8
                chan.toParentTail = node as *u8
            } else {
                let tail = chan.toParentTail as *WMsg
                tail.next = node as *u8
                chan.toParentTail = node as *u8
            }
        } else {
            if chan.toWorkerTail as i64 == 0 {
                chan.toWorkerHead = node as *u8
                chan.toWorkerTail = node as *u8
            } else {
                let tail = chan.toWorkerTail as *WMsg
                tail.next = node as *u8
                chan.toWorkerTail = node as *u8
            }
        }
        pthread_mutex_unlock(chan as *u8)
    }
}

// Dequeue one node (caller frees). fromParent != 0 → worker reading parent→worker.
fn msgPop(chan: *WChannel, fromParent: i32): *WMsg {
    var node: *WMsg = 0 as *WMsg
    unsafe {
        pthread_mutex_lock(chan as *u8)
        if fromParent != 0 {
            node = chan.toWorkerHead as *WMsg
            if node as i64 != 0 {
                chan.toWorkerHead = node.next
                if chan.toWorkerHead as i64 == 0 { chan.toWorkerTail = 0 as *u8 }
            }
        } else {
            node = chan.toParentHead as *WMsg
            if node as i64 != 0 {
                chan.toParentHead = node.next
                if chan.toParentHead as i64 == 0 { chan.toParentTail = 0 as *u8 }
            }
        }
        pthread_mutex_unlock(chan as *u8)
    }
    return node
}

// Serialize a value (caller's isolate/ctx) and push it onto a queue.
fn workerPostImpl(ci: CallbackInfo, toParent: i32): void {
    let iso = ci.isolate()
    let ctx = ci.context()
    unsafe {
        let chan = ci.i64Arg(0, 0) as *WChannel
        if chan as i64 == 0 { return }
        let val = ci.arg(1)
        var lenSlot: [i64; 1] = [0]
        var sabsSlot: [i64; 1] = [0]
        let bytes = v8c_serialize(iso.ptr, ctx.ptr, val.slot, lenSlot as *i64, sabsSlot as *u8)
        if bytes as i64 == 0 { return }
        msgPush(chan, toParent, bytes, lenSlot[0], sabsSlot[0] as *u8)
    }
}

// Pop+deserialize one message into the caller's isolate; return undefined if empty.
fn workerPollImpl(ci: CallbackInfo, fromParent: i32): void {
    let iso = ci.isolate()
    let ctx = ci.context()
    unsafe {
        let chan = ci.i64Arg(0, 0) as *WChannel
        if chan as i64 == 0 {
            ci.retUndefined()
            return
        }
        let node = msgPop(chan, fromParent)
        if node as i64 == 0 {
            ci.retUndefined()
            return
        }
        let slot = v8c_deserialize(iso.ptr, ctx.ptr, node.bytes, node.len, node.sabs)
        free(node.bytes)
        if node.sabs as i64 != 0 { v8c_sab_free(node.sabs) }
        free(node as *u8)
        if slot < 0 {
            ci.retUndefined()
            return
        }
        ci.ret(Value { slot: slot })
    }
}

fn workerCreate(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    let iso = ci.isolate()
    unsafe {
        // arg0 = file path OR (when isEval) inline source — sized generously since
        // eval worker code can be large. arg1 = isEval flag.
        let buf = calloc(1, 262144)
        let plen = ci.arg(0).writeUtf8(iso, buf, 262143)
        let chan = calloc(1, 256) as *WChannel
        pthread_mutex_init(chan as *u8, 0 as *u8)
        let sp = calloc(1, plen as i64 + 1)
        memcpy(sp, buf, plen as i64)
        free(buf)
        chan.scriptPath = sp
        chan.isEval = ci.i32Arg(1, 0)
        workerThreadIdCounter = workerThreadIdCounter + 1
        chan.threadId = workerThreadIdCounter
        ci.retF64(chan as i64 as f64)
    }
}

fn workerSetData(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    let iso = ci.isolate()
    let ctx = ci.context()
    unsafe {
        let chan = ci.i64Arg(0, 0) as *WChannel
        if chan as i64 == 0 { return }
        let val = ci.arg(1)
        var lenSlot: [i64; 1] = [0]
        var sabsSlot: [i64; 1] = [0]
        let bytes = v8c_serialize(iso.ptr, ctx.ptr, val.slot, lenSlot as *i64, sabsSlot as *u8)
        chan.wdBytes = bytes
        chan.wdLen = lenSlot[0]
        chan.wdSabs = sabsSlot[0] as *u8
    }
}

fn workerGetData(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    let iso = ci.isolate()
    let ctx = ci.context()
    unsafe {
        let chan = ci.i64Arg(0, 0) as *WChannel
        if chan as i64 == 0 || chan.wdBytes as i64 == 0 {
            ci.retUndefined()
            return
        }
        let slot = v8c_deserialize(iso.ptr, ctx.ptr, chan.wdBytes, chan.wdLen, chan.wdSabs)
        if slot < 0 {
            ci.retUndefined()
            return
        }
        ci.ret(Value { slot: slot })
    }
}

fn workerPostToWorker(info: *u8, _ud: *u8): void { workerPostImpl(CallbackInfo { ptr: info }, 0) }
fn workerPollFromWorker(info: *u8, _ud: *u8): void { workerPollImpl(CallbackInfo { ptr: info }, 0) }
fn workerPostToParent(info: *u8, _ud: *u8): void { workerPostImpl(CallbackInfo { ptr: info }, 1) }
fn workerPollToWorker(info: *u8, _ud: *u8): void { workerPollImpl(CallbackInfo { ptr: info }, 1) }

fn workerThreadId(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    unsafe {
        let chan = ci.i64Arg(0, 0) as *WChannel
        if chan as i64 == 0 { ci.retI32(0) } else { ci.retI32(chan.threadId) }
    }
}

fn workerStart(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    unsafe {
        let chan = ci.i64Arg(0, 0) as *WChannel
        if chan as i64 == 0 { return }
        gWorkersSpawned = 1
        let threadPtr = (chan as i64 + 64) as *u8
        pthread_create(threadPtr, 0 as *u8, nm_worker_entry as *u8, chan as *u8)
    }
}

fn workerMarkDone(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    unsafe {
        let chan = ci.i64Arg(0, 0) as *WChannel
        if chan as i64 != 0 {
            chan.exitCode = ci.i32Arg(1, 0)
            chan.doneFlag = 1
        }
    }
}
fn workerIsDone(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    unsafe {
        let chan = ci.i64Arg(0, 0) as *WChannel
        if chan as i64 == 0 { ci.retI32(1) } else { ci.retI32(chan.doneFlag) }
    }
}
fn workerExitCode(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    unsafe {
        let chan = ci.i64Arg(0, 0) as *WChannel
        if chan as i64 == 0 { ci.retI32(0) } else { ci.retI32(chan.exitCode) }
    }
}
fn workerRequestTerminate(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    unsafe {
        let chan = ci.i64Arg(0, 0) as *WChannel
        if chan as i64 != 0 {
            chan.terminateFlag = 1
            // interrupt JS executing in the worker isolate (cross-thread) so a busy
            // or blocked worker actually stops instead of running to completion.
            if chan.workerIso as i64 != 0 { v8c_isolate_terminate(chan.workerIso) }
        }
    }
}
fn workerShouldTerminate(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    unsafe {
        let chan = ci.i64Arg(0, 0) as *WChannel
        if chan as i64 == 0 { ci.retI32(0) } else { ci.retI32(chan.terminateFlag) }
    }
}
fn workerJoin(info: *u8, _ud: *u8): void {
    let ci = CallbackInfo { ptr: info }
    unsafe {
        let chan = ci.i64Arg(0, 0) as *WChannel
        if chan as i64 == 0 { return }
        let threadPtr = (chan as i64 + 64) as *u8
        pthread_join(threadPtr, 0 as *u8)
    }
}

fn nm_init_worker(_iso: *u8, ctx_ptr: *u8, exports: i32): void {
    let c = Context { ptr: ctx_ptr }
    let exp = Value { slot: exports }
    unsafe {
        c.setMethod(exp, "create" as *u8, workerCreate as *u8)
        c.setMethod(exp, "start" as *u8, workerStart as *u8)
        c.setMethod(exp, "setData" as *u8, workerSetData as *u8)
        c.setMethod(exp, "getData" as *u8, workerGetData as *u8)
        c.setMethod(exp, "postToWorker" as *u8, workerPostToWorker as *u8)
        c.setMethod(exp, "pollFromWorker" as *u8, workerPollFromWorker as *u8)
        c.setMethod(exp, "postToParent" as *u8, workerPostToParent as *u8)
        c.setMethod(exp, "pollToWorker" as *u8, workerPollToWorker as *u8)
        c.setMethod(exp, "threadId" as *u8, workerThreadId as *u8)
        c.setMethod(exp, "markDone" as *u8, workerMarkDone as *u8)
        c.setMethod(exp, "isDone" as *u8, workerIsDone as *u8)
        c.setMethod(exp, "exitCode" as *u8, workerExitCode as *u8)
        c.setMethod(exp, "requestTerminate" as *u8, workerRequestTerminate as *u8)
        c.setMethod(exp, "shouldTerminate" as *u8, workerShouldTerminate as *u8)
        c.setMethod(exp, "join" as *u8, workerJoin as *u8)
    }
}

// Thread entry: stand up a fresh isolate, run the worker script, pump its loop.
fn nm_worker_entry(arg: *u8): *u8 {
    unsafe {
        let chan = arg as *WChannel
        let isoPtr = v8c_isolate_new()
        if isoPtr as i64 == 0 {
            chan.doneFlag = 1
            return 0 as *u8
        }
        chan.workerIso = isoPtr
        v8c_isolate_enter(isoPtr)
        let hs = v8c_handle_scope_new(isoPtr)
        let ctxPtr = v8c_context_new(isoPtr)
        v8c_context_enter(ctxPtr)
        let iso = Isolate { ptr: isoPtr }
        let ctx = Context { ptr: ctxPtr }
        let global = ctx.global()
        ctx.setMethod(global, "internalBinding" as *u8, nm_internal_binding as *u8)
        ctx.setMethod(global, "__loadBuiltin" as *u8, nativeLoadBuiltin as *u8)
        ctx.objectSet(global, "__libDir" as *u8, iso.string(nm_get_lib_dir()))

        let proc = setupProcessObject(iso, ctx, 0, 0 as *i64)
        ctx.objectSet(global, "process" as *u8, proc)
        // expose worker identity to JS before bootstrap
        ctx.objectSet(global, "__workerChannel" as *u8, iso.number(chan as i64 as f64))
        ctx.objectSet(global, "__workerThreadId" as *u8, iso.int32(chan.threadId))

        // bootstrap path = <root>/src/milo/runtime/bootstrap.js
        var bsPath: [u8; 1024] = [0; 1024]
        let ld = nm_get_lib_dir()
        let rootLen = strlen(ld) - 3
        var bp: i64 = 0
        while bp < rootLen {
            bsPath[bp] = ld[bp]
            bp = bp + 1
        }
        let bsSuffix = "src/milo/runtime/bootstrap.js"
        var bs: i64 = 0
        while bs < strlen(bsSuffix) {
            bsPath[bp] = bsSuffix[bs]
            bp = bp + 1
            bs = bs + 1
        }
        bsPath[bp] = 0
        runBootstrap(ctx, bsPath as *u8)

        // Pre-load worker_threads so EVERY worker gets its internal setup —
        // parentPort, __workerPump, and the uncaughtException->postToParent handler —
        // independent of whether the user script requires it. Node always bootstraps
        // worker internals; here they lived in the module's worker-side block, so a
        // bare `throw` worker (e.g. nested `new Worker("throw ...")`) had no handler and
        // its error never reached the parent. This makes uncaught errors propagate.
        ctx.compileRun("try{require('worker_threads')}catch(e){}" as *u8, 40, "[worker-preload]" as *u8)

        // run the worker script; uncaught errors surface to the parent via the
        // JS uncaughtException handler (which posts a {t:'error'} envelope).
        let tc = v8c_try_catch_new(isoPtr)
        if chan.isEval != 0 {
            // eval worker: run the inline source directly
            ctx.compileRun(chan.scriptPath, strlen(chan.scriptPath) as i32, "[worker eval]" as *u8)
        } else {
            // require the worker script file through the module system
            let codeBuf = calloc(1, 262144)
            let rPre = "(function(){const p=require('path');const f=p.resolve('"
            let rPost = "');require.main={id:'.',filename:f,loaded:false,paths:[]};require(f);})()"
            var wi: i64 = 0
            var wj: i64 = 0
            while wj < strlen(rPre) {
                codeBuf[wi] = rPre[wj]
                wi = wi + 1
                wj = wj + 1
            }
            wj = 0
            while wj < strlen(chan.scriptPath) {
                codeBuf[wi] = chan.scriptPath[wj]
                wi = wi + 1
                wj = wj + 1
            }
            wj = 0
            while wj < strlen(rPost) {
                codeBuf[wi] = rPost[wj]
                wi = wi + 1
                wj = wj + 1
            }
            codeBuf[wi] = 0
            ctx.compileRun(codeBuf, wi as i32, "[worker]" as *u8)
            free(codeBuf)
        }
        // The native TryCatch swallows the worker's top-level throw. Route it
        // through process._fatalException — exactly as the main thread does — so
        // the JS 'uncaughtException' handler (installed by the worker_threads
        // preload above) fires and posts a {t:'error'} envelope to the parent.
        // Without this the parent's Worker 'error' event never fires.
        if v8c_try_catch_has_caught(tc) != 0 {
            let exSlot = v8c_try_catch_exception(tc)
            let procObj = ctx.objectGet(global, "process" as *u8)
            let feFn = ctx.objectGet(procObj, "_fatalException" as *u8)
            if feFn.slot >= 0 {
                let undefFe = iso.undefined()
                var feArgs: [i32; 1] = [exSlot]
                v8c_function_call(ctxPtr, feFn.slot, undefFe.slot, 1, feArgs as *i32)
                v8c_isolate_run_microtasks(isoPtr)
            }
        }
        v8c_try_catch_delete(tc)
        v8c_isolate_run_microtasks(isoPtr)

        // event loop: pump messages + run one timer/tick pass each iteration via
        // __workerPump (it calls __workerTick); stop on terminate or when not alive.
        let undef = iso.undefined()
        let pump = ctx.objectGet(global, "__workerPump" as *u8)
        var running: i32 = 1
        while running == 1 {
            if chan.terminateFlag != 0 { running = 0 }
            else if pump.slot >= 0 {
                let r = v8c_function_call(ctxPtr, pump.slot, undef.slot, 0, 0 as *i32)
                v8c_isolate_run_microtasks(isoPtr)
                if chan.terminateFlag != 0 { running = 0 }
                else {
                    var aliveOut: [i32; 1] = [1]
                    v8c_to_bool(isoPtr, r, aliveOut as *i32)
                    if aliveOut[0] == 0 { running = 0 }
                    else { usleep(1000) }
                }
            } else { running = 0 }
        }
        chan.doneFlag = 1
        // clear any pending termination so teardown can run JS (dispose) cleanly
        v8c_isolate_cancel_terminate(isoPtr)
        v8c_context_exit(ctxPtr)
        v8c_handle_scope_delete(hs)
        v8c_context_dispose(ctxPtr)
        v8c_isolate_exit(isoPtr)
        v8c_isolate_dispose(isoPtr)
    }
    return 0 as *u8
}

fn milo_node_main(argc: i32, argv: *i64): i32 {
    // Convert C argc/argv to Vec<string>, splitting --key=value into two args
    var argVec: Vec<string> = Vec.new()
    for ai in 0..argc as i64 {
        unsafe {
            let arg = _cstrToString(argv[ai] as *u8)
            let argPtr = arg.cstr()
            let argLen = strlen(argPtr)
            var eqPos = argLen + 1
            if argLen > 2 && argPtr[0] == 45 && argPtr[1] == 45 {
                var si: i64 = 2
                while si < argLen {
                    if argPtr[si] == 61 {
                        eqPos = si
                        si = argLen
                    }
                    si = si + 1
                }
            }
            if eqPos < argLen {
                var keyBuf: [u8; 256] = [0; 256]
                var vi: i64 = 0
                while vi < eqPos {
                    keyBuf[vi] = argPtr[vi]
                    vi = vi + 1
                }
                argVec.push(_cstrToString(keyBuf as *u8))
                argVec.push(_cstrToString((argPtr as i64 + eqPos + 1) as *u8))
            } else {
                argVec.push(arg)
            }
        }
    }

    var parser = newParser("milo-node", "Node.js runtime on Milo (" + miloNodeVersion() + ", " + miloBuildDate() + ")")
    parser.addString("eval", "e", "Evaluate JavaScript string", "")
    parser.addString("print", "p", "Evaluate and print result", "")
    parser.addString("require", "r", "Preload module before running", "")
    parser.addBool("interactive", "i", "Start REPL (read-eval-print loop)")
    parser.addBool("version", "v", "Print version and exit")
    parser.addString("max-old-space-size", "", "V8 heap limit in MB (default: 512)", "")
    parser.addBool("expose-internals", "", "Expose internal modules")
    parser.addBool("no-warnings", "", "Suppress process warnings")
    parser.addBool("expose-gc", "", "Expose global gc() function")
    parser.addBool("allow-natives-syntax", "", "Enable V8 %-prefixed natives syntax")
    parser.addString("title", "", "Set the process title at startup", "")
    // Permission model flags — accepted (and currently treated as permissive
    // no-ops) so scripts launched with them parse instead of mistaking the value
    // for a script path.
    parser.addBool("permission", "", "Enable the permission model")
    parser.addString("allow-fs-read", "", "Permission model: allow fs reads", "")
    parser.addString("allow-fs-write", "", "Permission model: allow fs writes", "")
    parser.addBool("allow-child-process", "", "Permission model: allow child processes")
    parser.addBool("allow-worker", "", "Permission model: allow workers")
    parser.addBool("allow-addons", "", "Permission model: allow native addons")
    parser.addBool("allow-wasi", "", "Permission model: allow WASI")
    parser.addString("unhandled-rejections", "", "Unhandled rejection mode (throw/warn/none/strict)", "")
    parser.addString("stack-trace-limit", "", "Error.stackTraceLimit override", "")
    parser.addOptionalPositional("file", "JavaScript file to execute")
    parser.enableTrailingArgs()
    parser.enableIgnoreUnknown()

    let parsed = parser.parseFrom(argVec)

    if parsed.has("version") {
        print(miloNodeVersion())
        return 0
    }

    var script: *u8 = 0 as *u8
    var scriptFile: *u8 = 0 as *u8
    var printResult = false
    var preloadModule: *u8 = 0 as *u8
    // Default 512MB heap limit; override with --max-old-space-size=N
    var maxHeapMb: i64 = 512
    if parsed.has("max-old-space-size") {
        let heapStr = parsed.getString("max-old-space-size")
        maxHeapMb = atoi(heapStr.cstr()) as i64
        if maxHeapMb <= 0 { maxHeapMb = 512 }
    }

    var exposeGc = false
    if parsed.has("expose-gc") { exposeGc = true }

    var allowNatives = false
    if parsed.has("allow-natives-syntax") { allowNatives = true }

    if parsed.has("require") {
        preloadModule = parsed.getString("require").cstr()
    }

    if parsed.has("interactive") {
        script = "const repl = require('repl'); repl.start('> ')".cstr()
    } else if parsed.has("eval") {
        let evalStr = parsed.getString("eval")
        script = evalStr.cstr()
    } else if parsed.has("print") {
        let printStr = parsed.getString("print")
        script = printStr.cstr()
        printResult = true
    } else if parsed.positional.len > 0 {
        scriptFile = parsed.positional[0].cstr()
    }

    if script as i64 == 0 && scriptFile as i64 == 0 {
        print(parser.helpText())
        return 1
    }

    unsafe {
        var fileBuf: *u8 = 0 as *u8
        var fileLen: [i64; 1] = [0]
        if scriptFile as i64 != 0 {
            fileBuf = readFile(scriptFile, fileLen as *i64)
            if fileBuf as i64 == 0 {
                printErr("error: cannot read file: " as *u8)
                printErr(scriptFile)
                printErr("\n" as *u8)
                return 1
            }
            script = fileBuf
        }

        registerBuiltinBindings()

        // Derive lib dir from exec path: strip last 3 components (out/Release/milo-node)
        let exec = argv[0] as *u8
        var libPath: [u8; 1024] = [0; 1024]
        var k: i64 = 0
        if exec[0] != 47 {
            let cwd_r = getcwd(libPath as *u8, 900)
            if cwd_r as i64 != 0 {
                k = strlen(libPath as *u8)
                libPath[k] = 47
                k = k + 1
            }
        }
        let execLen = strlen(exec)
        var ek: i64 = 0
        while ek < execLen {
            libPath[k] = exec[ek]
            k = k + 1
            ek = ek + 1
        }
        var slashes: i32 = 0
        while k > 0 && slashes < 3 {
            k = k - 1
            if libPath[k] == 47 { slashes = slashes + 1 }
        }
        if slashes == 3 {
            libPath[k] = 47
            libPath[k + 1] = 108
            libPath[k + 2] = 105
            libPath[k + 3] = 98
            libPath[k + 4] = 0
            nm_set_lib_dir(libPath as *u8)
        }

        // Bootstrap path: <root>/src/milo/runtime/bootstrap.js
        var bsPath: [u8; 1024] = [0; 1024]
        let ld = nm_get_lib_dir()
        let rootLen = strlen(ld) - 3
        var bp: i64 = 0
        while bp < rootLen {
            bsPath[bp] = ld[bp]
            bp = bp + 1
        }
        let bsSuffix = "src/milo/runtime/bootstrap.js"
        let bsSuffixLen = strlen(bsSuffix)
        var bs: i64 = 0
        while bs < bsSuffixLen {
            bsPath[bp] = bsSuffix[bs]
            bp = bp + 1
            bs = bs + 1
        }
        bsPath[bp] = 0

        // Boot V8
        if exposeGc {
            v8c_set_flags_from_string("--expose-gc")
        }
        // Must precede V8::Initialize (inside v8c_platform_init).
        if allowNatives {
            v8c_set_flags_from_string("--allow-natives-syntax")
        }
        if v8c_platform_init(exec) != 0 {
            printErr("error: v8c_platform_init failed\n" as *u8)
            return 1
        }

        let isoPtr = v8c_isolate_new_with_heap_limit(maxHeapMb)
        if isoPtr as i64 == 0 {
            printErr("error: v8c_isolate_new failed\n" as *u8)
            return 1
        }

        v8c_isolate_enter(isoPtr)
        let hs = v8c_handle_scope_new(isoPtr)
        let ctxPtr = v8c_context_new(isoPtr)
        v8c_context_enter(ctxPtr)

        let iso = Isolate { ptr: isoPtr }
        let ctx = Context { ptr: ctxPtr }

        let global = ctx.global()
        ctx.setMethod(global, "internalBinding" as *u8, nm_internal_binding as *u8)
        ctx.setMethod(global, "__loadBuiltin" as *u8, nativeLoadBuiltin as *u8)
        ctx.objectSet(global, "__libDir" as *u8, iso.string(nm_get_lib_dir()))

        nm_binding_register("_console" as *u8, nm_init_console as *u8)

        let proc = setupProcessObject(iso, ctx, argc, argv)
        ctx.objectSet(global, "process" as *u8, proc)

        // Run bootstrap
        let tc = v8c_try_catch_new(isoPtr)
        let bootResult = runBootstrap(ctx, bsPath as *u8)
        if bootResult.slot < 0 {
            printErr("error: bootstrap failed\n" as *u8)
            if v8c_try_catch_has_caught(tc) != 0 {
                let msg = Value { slot: v8c_try_catch_message(tc) }
                if msg.slot >= 0 {
                    var mbuf: [u8; 4096] = [0; 4096]
                    let mlen = msg.writeUtf8(iso, mbuf as *u8, 4096) - 1
                    if mlen > 0 {
                        write(2, mbuf as *u8, mlen as i64)
                        write(2, "\n" as *u8, 1)
                    }
                }
            }
            v8c_try_catch_delete(tc)
            v8c_context_exit(ctxPtr)
            v8c_handle_scope_delete(hs)
            v8c_context_dispose(ctxPtr)
            v8c_isolate_exit(isoPtr)
            v8c_isolate_dispose(isoPtr)
            v8c_platform_shutdown()
            return 1
        }
        v8c_try_catch_delete(tc)

        if exposeGc {
            ctx.setMethod(global, "gc" as *u8, nativeGc as *u8)
        }

        if parsed.has("unhandled-rejections") {
            let mode = parsed.getString("unhandled-rejections")
            ctx.objectSet(proc, "_unhandledRejections" as *u8, iso.string(mode.cstr()))
        }

        if parsed.has("stack-trace-limit") {
            let limitStr = parsed.getString("stack-trace-limit")
            let limit = atoi(limitStr.cstr())
            if limit >= 0 {
                // Set Error.stackTraceLimit via JS
                var stlCode: [u8; 64] = [0; 64]
                let stlPrefix = "Error.stackTraceLimit="
                var si: i64 = 0
                var sj: i64 = 0
                while sj < strlen(stlPrefix) {
                    stlCode[si] = stlPrefix[sj]
                    si = si + 1
                    sj = sj + 1
                }
                sj = 0
                let limitCstr = limitStr.cstr()
                while sj < strlen(limitCstr) {
                    stlCode[si] = limitCstr[sj]
                    si = si + 1
                    sj = sj + 1
                }
                ctx.compileRun(stlCode as *u8, si as i32, "[stack-trace-limit]" as *u8)
            }
        }

        // --title=foo sets process.title at startup (applies in all run modes).
        if parsed.has("title") {
            let titleStr = parsed.getString("title")
            ctx.objectSet(proc, "title" as *u8, iso.string(titleStr.cstr()))
        }

        // Set process._eval and process.execArgv for fork bomb protection
        if scriptFile as i64 == 0 && script as i64 != 0 {
            let evalLen = strlen(script) as i32
            ctx.objectSet(proc, "_eval" as *u8, iso.stringLen(script, evalLen))
            let execArgvArr = iso.array(2)
            if printResult {
                ctx.objectSetIndex(execArgvArr, 0, iso.string("-p" as *u8))
            } else {
                ctx.objectSetIndex(execArgvArr, 0, iso.string("-e" as *u8))
            }
            ctx.objectSetIndex(execArgvArr, 1, iso.stringLen(script, evalLen))
            ctx.objectSet(proc, "execArgv" as *u8, execArgvArr)

            // In -e/-p mode Node exposes builtin modules as lazy globals (so a
            // one-liner can reference `vm`, `fs`, … without require). Install
            // configurable getters that don't shadow real globals (crypto, etc.).
            let lazyGlobals = "(function(){var R=globalThis.require;if(typeof R!=='function')return;var ns=['vm','fs','path','os','util','assert','events','stream','buffer','crypto','http','https','net','url','querystring','zlib','child_process','dns','tls','dgram','readline','module','timers','string_decoder','tty','v8','worker_threads','perf_hooks','async_hooks'];for(var i=0;i<ns.length;i++){(function(n){if(n in globalThis)return;Object.defineProperty(globalThis,n,{configurable:true,enumerable:false,get:function(){try{return R(n)}catch(e){return undefined}},set:function(v){Object.defineProperty(globalThis,n,{value:v,writable:true,configurable:true,enumerable:true})}})})(ns[i])}})()"
            ctx.compileRun(lazyGlobals as *u8, strlen(lazyGlobals) as i32, "[lazy-globals]" as *u8)
        }

        // Preload --require module if specified
        if preloadModule as i64 != 0 {
            var reqCode: [u8; 2048] = [0; 2048]
            let prefix = "require('"
            let suffix = "')"
            var ri: i64 = 0
            var rj: i64 = 0
            while rj < strlen(prefix) {
                reqCode[ri] = prefix[rj]
                ri = ri + 1
                rj = rj + 1
            }
            rj = 0
            while rj < strlen(preloadModule) {
                reqCode[ri] = preloadModule[rj]
                ri = ri + 1
                rj = rj + 1
            }
            rj = 0
            while rj < strlen(suffix) {
                reqCode[ri] = suffix[rj]
                ri = ri + 1
                rj = rj + 1
            }
            ctx.compileRun(reqCode as *u8, ri as i32, "[require]" as *u8)
        }

        // Run user script
        let scriptLen = strlen(script) as i32
        let tc2 = v8c_try_catch_new(isoPtr)
        var result = Value { slot: -1 }
        if scriptFile as i64 != 0 {
            // Load through module system for CommonJS semantics (top-level return, module/exports)
            var runCode: [u8; 4096] = [0; 4096]
            let rPrefix = "(function(){const p=require('path');const f=p.resolve('"
            // route top-level throws through process._fatalException so capture callbacks
            // / 'uncaughtException' listeners fire (native would otherwise just print + exit)
            // run via Module.runMain so a --require preload can monkey-patch it
            // If _fatalException was monkey-patched to a non-function, an uncaught
            // top-level throw exits with the dedicated code 6 (Node semantics).
            let rMiddle = "');require.main={id:'.',filename:f,loaded:false,paths:[]};try{require('module').runMain();}catch(e){var fe=process._fatalException;if(typeof fe==='function'){fe.call(process,e);}else{(process.reallyExit||process.exit).call(process,6);}}})()"
            var wi: i64 = 0
            var wj: i64 = 0
            while wj < strlen(rPrefix) {
                runCode[wi] = rPrefix[wj]
                wi = wi + 1
                wj = wj + 1
            }
            wj = 0
            while wj < strlen(scriptFile) {
                runCode[wi] = scriptFile[wj]
                wi = wi + 1
                wj = wj + 1
            }
            wj = 0
            while wj < strlen(rMiddle) {
                runCode[wi] = rMiddle[wj]
                wi = wi + 1
                wj = wj + 1
            }
            result = ctx.compileRun(runCode as *u8, wi as i32, "[main]" as *u8)
        } else {
            result = ctx.compileRun(script, scriptLen, "[eval]" as *u8)
        }

        if result.slot < 0 || v8c_try_catch_has_caught(tc2) != 0 {
            let msg = Value { slot: v8c_try_catch_message(tc2) }
            if msg.slot >= 0 {
                var mbuf: [u8; 4096] = [0; 4096]
                let mlen = msg.writeUtf8(iso, mbuf as *u8, 4096) - 1
                if mlen > 0 {
                    write(2, mbuf as *u8, mlen as i64)
                    write(2, "\n" as *u8, 1)
                }
            } else {
                printErr("error: script execution failed\n" as *u8)
            }
        } else {
            if printResult && result.slot >= 0 {
                printVal(iso, result)
            }
        }

        v8c_try_catch_delete(tc2)

        // Drain microtask queue then run event loop (timers)
        v8c_isolate_run_microtasks(isoPtr)
        let runLoop = ctx.objectGet(global, "__runEventLoop" as *u8)
        if runLoop.slot >= 0 {
            let undef = iso.undefined()
            v8c_function_call(ctxPtr, runLoop.slot, undef.slot, 0, 0 as *i32)
            v8c_isolate_run_microtasks(isoPtr)
        }

        if fileBuf as i64 != 0 {
            free(fileBuf)
        }

        // Emit process 'exit' event before V8 teardown
        let emitExit = ctx.objectGet(global, "__runExitHandlers" as *u8)
        if emitExit.slot >= 0 {
            let undef = iso.undefined()
            v8c_function_call(ctxPtr, emitExit.slot, undef.slot, 0, 0 as *i32)
            v8c_isolate_run_microtasks(isoPtr)
        }

        v8c_context_exit(ctxPtr)
        v8c_handle_scope_delete(hs)
        if gWorkersSpawned == 0 {
            v8c_context_dispose(ctxPtr)
            v8c_isolate_exit(isoPtr)
            v8c_isolate_dispose(isoPtr)
            v8c_platform_shutdown()
        }

        if result.slot >= 0 { return 0 }
        return 1
    }
}
